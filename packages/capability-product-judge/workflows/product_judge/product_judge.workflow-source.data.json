        "output_key": "close_milestone_status",
        "prompt": "# hatch:no-inline-script-ok\ngh api repos/${gh_repo}/milestones --state open --jq '.[] | select(.title==\"${milestone_title}\") | .number' | xargs -I{} gh api -X PATCH repos/${gh_repo}/milestones/{} -f state=closed >/dev/null",
