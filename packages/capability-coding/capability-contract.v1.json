      "path": "src/in-process-action-owners.mjs",
      "refs": [
        "hatch.review_verdict",
        "review_evidence/v1",
        "reviewer_context/v1"
      ]
    }
  ],
  "sourcePath": "packages/capability-coding/capability-contract.mjs",
  "title": "Coding Capability",
  "version": "0.1.0"
}
