  "edges": [
    {
      "from": "keep_all",
      "to": "fan_out"
    },
    {
      "from": "fan_out",
      "to": "fan_in"
    },
    {
      "from": "fan_in",
      "to": "done"
    },
    {
      "from": "start",
      "to": "normalize_labels"
    },
    {
      "from": "normalize_labels",
      "to": "sanitize_governance_overlap"
    },
    {
      "from": "sanitize_governance_overlap",
      "to": "auto_ready_artifacts"
    },
    {
      "from": "auto_ready_artifacts",
      "to": "sanitize_goal_duplicates"
    },
    {
      "from": "sanitize_goal_duplicates",
      "to": "list_goals"
    },
    {
      "from": "list_goals",
      "to": "count_goals"
    },
    {
      "from": "count_goals",
      "to": "resolve_skip_review_single_goal"
    },
    {
      "from": "resolve_skip_review_single_goal",
      "to": "gate"
    },
    {
      "from": "evaluate_goal_review_skip",
      "to": "skip_review_gate"
    },
    {
      "from": "gate",
      "to": "done",
      "condition": "goal_count=0",
      "dotAttributes": {
        "condition": "goal_count=0"
      }
    },
    {
      "from": "gate",
      "to": "evaluate_goal_review_skip",
      "condition": "goal_count!=0",
      "dotAttributes": {
        "condition": "goal_count!=0"
      }
    },
    {
      "from": "skip_review_gate",
      "to": "keep_all",
      "condition": "skip!=true",
      "label": "full",
      "dotAttributes": {
        "condition": "skip!=true",
        "label": "full"
      }
    },
    {
      "from": "skip_review_gate",
      "to": "keep_all",
      "condition": "skip=true",
      "label": "skip",
      "dotAttributes": {
        "condition": "skip=true",
        "label": "skip"
      }
    }
  ]
