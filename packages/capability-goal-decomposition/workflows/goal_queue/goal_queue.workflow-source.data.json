    "debugRules": [
      "Generated runtime DOT remains the execution IR for this migrated workflow family.",
      "Operators trace runtime node ids directly through sourceMap.nodeMappings.",
      "workflow_source graph attr points back to this module for source-of-truth lookup."
    ]
  },
  "invariants": {
    "mustPreserve": [
      "edge.condition",
      "edge.from",
      "edge.label",
      "edge.to",
      "graph.label",
      "graph.workflow_source",
      "node.id"
    ],
    "mayNormalize": [
      "attribute_order",
      "comment_blocks",
      "whitespace"
    ]
  },
  "sourceOwnership": {
    "canonicalAuthoringSurface": "typed_workflow_source",
    "runtimeIr": "generated_dot_runtime_ir"
  },
  "artifacts": [],
  "events": [],
  "nodes": [
    {
      "id": "auto_ready_artifacts",
      "kind": "tool_action",
      "title": "Auto-ready artifact goals",
      "dotAttributes": {
        "type": "tool",
        "governance": "irreversible",
        "action_runtime": "in_process",
        "action_id": "goal.auto_ready_artifacts",
        "label": "Auto-ready artifact goals",
        "output_key": "__auto_ready_artifacts_result",
        "action_repo": "${gh_repo}",
        "recovery_owner": "supervisor",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
      }
    },
    {
      "id": "count_goals",
      "kind": "tool_action",
      "title": "Count goals",
      "dotAttributes": {
        "type": "tool",
        "governance": "irreversible",
        "action_runtime": "in_process",
        "action_id": "common.count_json_items",
        "label": "Count goals",
        "output_key": "goal_count",
        "action_raw_b64": "${goal_issues_b64}",
        "recovery_owner": "supervisor",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
      }
    },
    {
      "id": "done",
      "kind": "terminal",
      "dotAttributes": {
        "shape": "Msquare"
      }
    },
    {
      "id": "evaluate_goal_review_skip",
      "kind": "tool_action",
      "title": "Evaluate single-goal review bypass",
      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "ceremony.goal_review_skip",
        "label": "Evaluate single-goal review bypass",
        "output_format": "json",
        "outputs": "skip,reason,hatch_ceremony_pipeline,hatch_ceremony_skipped,hatch_ceremony_skip_reason,hatch_ceremony_reason",
        "action_pipeline": "goal_queue",
        "action_goal_count": "${goal_count}",
        "action_skip_review_single_goal": "${skip_review_single_goal}",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
      }
    },
    {
      "id": "fan_in",
      "kind": "dynamic_fan_in",
      "title": "Collect goal runs",
      "dotAttributes": {
        "type": "fan_in.dynamic",
        "label": "Collect goal runs",
        "output_key": "goal_runs",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.fan_in.dynamic"
      }
    },
    {
      "id": "fan_out",
      "kind": "dynamic_fan_out",
      "title": "Run goal",
      "dotAttributes": {
        "type": "fan_out.dynamic",
        "label": "Run goal",
        "item_key": "issue_number",
        "max_concurrency": "2",
        "source_key": "kept_goals",
        "template": "@hatch/capability-goal-decomposition/workflows/goal_run/goal_run.workflow-source.mjs",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.fan_out.dynamic"
      }
    },
    {
      "id": "gate",
      "kind": "decision",
      "title": "Any goals?",
      "dotAttributes": {
        "shape": "diamond",
        "label": "Any goals?"
      }
    },
    {
      "id": "keep_all",
      "kind": "tool_action",
      "title": "Keep all goals",
      "dotAttributes": {
        "type": "tool",
        "governance": "irreversible",
        "action_runtime": "in_process",
        "action_id": "goal.filter_kept_goals",
        "label": "Keep all goals",
        "output_key": "kept_goals",
        "action_decisions_b64": "W10=",
        "action_issues_b64": "${goal_issues_b64}",
        "recovery_owner": "supervisor",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
      }
    },
    {
      "id": "list_goals",
      "kind": "tool_action",
      "title": "List open goals",
      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "goal.list_ready",
        "label": "List open goals",
        "output_key": "goal_issues",
        "action_repo": "${gh_repo}",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
      }
    },
    {
      "id": "normalize_labels",
      "kind": "tool_action",
      "title": "Normalize issue labels",
      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "labels.normalize_issue_state",
        "label": "Normalize issue labels",
        "output_key": "__normalize_labels_result",
        "action_repo": "${gh_repo}",
        "action_state": "open",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
      }
    },
    {
      "id": "resolve_skip_review_single_goal",
      "kind": "tool_action",
      "title": "Resolve single-goal review toggle",
      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "common.resolve_boolean",
        "label": "Resolve single-goal review toggle",
        "output_key": "skip_review_single_goal",
        "action_fallback": "false",
        "action_value": "${skip_review_single_goal}",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
      }
    },
    {
      "id": "sanitize_goal_duplicates",
      "kind": "tool_action",
      "title": "Normalize goal duplicates",
      "dotAttributes": {
        "type": "tool",
        "governance": "irreversible",
        "action_runtime": "in_process",
        "action_id": "goal.sanitize_duplicates",
        "label": "Normalize goal duplicates",
        "output_key": "__sanitize_goal_duplicates_result",
        "action_repo": "${gh_repo}",
        "action_run_id": "${__run_id}",
        "action_pipeline": "goal_queue",
        "recovery_owner": "supervisor",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
      }
    },
    {
      "id": "sanitize_governance_overlap",
      "kind": "tool_action",
      "title": "Normalize governance overlap",
      "dotAttributes": {
        "type": "tool",
        "governance": "irreversible",
        "action_runtime": "in_process",
        "action_id": "governance.sanitize_overlap",
        "label": "Normalize governance overlap",
        "output_key": "__sanitize_governance_overlap_result",
        "action_repo": "${gh_repo}",
        "action_run_id": "${__run_id}",
        "action_pipeline": "goal_queue",
        "recovery_owner": "supervisor",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
      }
    },
    {
      "id": "skip_review_gate",
      "kind": "decision",
      "title": "Skip review ceremony?",
      "dotAttributes": {
        "shape": "diamond",
        "label": "Skip review ceremony?"
      }
    },
    {
      "id": "start",
      "kind": "start",
      "dotAttributes": {
        "shape": "Mdiamond"
      }
    }
