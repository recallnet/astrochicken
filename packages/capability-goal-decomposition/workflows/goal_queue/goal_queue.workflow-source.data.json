  "runtimeGraphPath": "docs/contracts/workflow-ir/capability-goal-decomposition/goal_queue.dot",
  "jsonSchemaOutputPath": "docs/contracts/workflow-source-module.v1.schema.json",
  "graphAttributes": {
    "label": "goal_queue",
    "typed_action_transport_mode": "enforced"
  },
  "sourceMap": {
