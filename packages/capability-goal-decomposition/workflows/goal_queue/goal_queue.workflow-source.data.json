      {
        "sourceNodeId": "count_goals",
        "runtimeNodeId": "count_goals"
      },
      {
        "sourceNodeId": "done",
        "runtimeNodeId": "done"
      },
      {
        "sourceNodeId": "evaluate_goal_review_skip",
        "runtimeNodeId": "evaluate_goal_review_skip"
      },
      {
        "sourceNodeId": "fan_in",
        "runtimeNodeId": "fan_in"
      },
      {
        "sourceNodeId": "fan_out",
        "runtimeNodeId": "fan_out"
      },
      {
        "sourceNodeId": "gate",
        "runtimeNodeId": "gate"
      },
      {
        "sourceNodeId": "keep_all",
        "runtimeNodeId": "keep_all"
      },
      {
        "sourceNodeId": "list_goals",
        "runtimeNodeId": "list_goals"
      },
      {
        "sourceNodeId": "normalize_labels",
        "runtimeNodeId": "normalize_labels"
      },
      {
        "sourceNodeId": "resolve_skip_review_single_goal",
        "runtimeNodeId": "resolve_skip_review_single_goal"
      },
      {
        "sourceNodeId": "sanitize_goal_duplicates",
        "runtimeNodeId": "sanitize_goal_duplicates"
