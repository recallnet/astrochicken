        "label": "fail_closed"
      }
    },
    {
      "from": "judge_issue",
      "to": "normalize_decision"
    },
    {
      "from": "normalize_decision",
      "to": "decide"
    },
    {
      "from": "revise_issue_spec",
      "to": "fallback_revised_issue_spec"
    },
    {
      "from": "fallback_revised_issue_spec",
