    },
    {
      "from": "normalize_feature_issue_spec",
      "to": "validate_issue_spec"
    },
    {
      "from": "validate_issue_spec",
      "to": "issue_spec_gate"
    },
    {
      "from": "decide",
      "to": "done",
      "condition": "decision=approved",
      "dotAttributes": {
        "condition": "decision=approved"
      }
    },
    {
      "from": "decide",
      "to": "revise_issue_spec",
      "condition": "decision!=approved && decision!=revise",
      "label": "fallback",
      "dotAttributes": {
        "condition": "decision!=approved && decision!=revise",
        "label": "fallback"
      }
    },
    {
      "from": "decide",
      "to": "revise_issue_spec",
      "condition": "decision=revise",
      "label": "revise",
      "dotAttributes": {
        "condition": "decision=revise",
        "label": "revise"
      }
    },
    {
      "from": "issue_spec_gate",
      "to": "create_issue",
      "condition": "ok=true",
      "label": "valid",
      "dotAttributes": {
        "condition": "ok=true",
        "label": "valid"
      }
    },
    {
      "from": "issue_spec_gate",
      "to": "repair_issue_spec",
      "condition": "ok!=true",
      "label": "repair",
      "dotAttributes": {
        "condition": "ok!=true",
        "label": "repair"
      }
    },
    {
      "from": "repair_issue_spec",
      "to": "validate_repaired_issue_spec"
    },
    {
      "from": "repaired_issue_spec_gate",
      "to": "create_issue",
      "condition": "ok=true",
      "label": "valid",
      "dotAttributes": {
        "condition": "ok=true",
        "label": "valid"
      }
    },
    {
      "from": "repaired_issue_spec_gate",
      "to": "done",
      "condition": "ok!=true",
      "label": "fail_closed",
      "dotAttributes": {
        "condition": "ok!=true",
        "label": "fail_closed"
      }
    },
    {
      "from": "validate_repaired_issue_spec",
      "to": "repaired_issue_spec_gate"
    }
  ]
}
