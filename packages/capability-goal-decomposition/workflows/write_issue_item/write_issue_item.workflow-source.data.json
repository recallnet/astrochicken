      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "common.fallback_issue_spec_bundle",
        "label": "Fallback issue spec",
        "outputs": "issue_spec,issue_spec_b64",
        "action_feature": "${feature}",
        "action_issue_spec": "${issue_spec_raw}",
