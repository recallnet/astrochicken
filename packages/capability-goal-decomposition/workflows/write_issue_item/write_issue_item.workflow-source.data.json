    {
      "id": "repair_issue_spec",
      "kind": "llm_prompt",
      "title": "Repair issue spec",
      "dotAttributes": {
        "class": "issue_writer",
        "benchmark_job_id": "goal.write_issue.repair",
        "llm_path_id": "capability.write_issue_item.repair_issue_spec",
        "prompt_version": "2026-03-12.r1",
        "role_version": "1.0.0",
        "skill_id": "goal.write_issue",
        "llm_model": "openai/gpt-5.3-codex",
        "label": "Repair issue spec",
        "output_key": "issue_spec_raw",
        "output_format": "json",
        "reasoning_effort": "medium",
        "timeout": "${goal_decomposition_timeouts.issue_repair}",
        "prompt": "Your previous issue spec failed deterministic validation.\n\nOriginal issue spec JSON:\n${issue_spec_raw}\n\nRepair instructions:\n${retry_prompt}\n\nReturn JSON only with issue_title, issue_body, and issue_labels.",
        "recovery_owner": "supervisor",
        "session_id": "goal-decomposer-${issue_number}"
      }
    },
    {
      "id": "repaired_issue_spec_gate",
      "kind": "decision",
      "title": "Repaired issue spec valid?",
      "dotAttributes": {
        "shape": "diamond",
        "label": "Repaired issue spec valid?"
      }
    },
    {
      "id": "revise_issue_spec",
      "kind": "llm_prompt",
      "title": "Revise issue spec",
      "dotAttributes": {
        "class": "issue_writer",
        "benchmark_job_id": "goal.write_issue.revise",
        "llm_path_id": "capability.write_issue_item.revise_issue_spec",
        "prompt_version": "2026-03-09.r1",
        "role_version": "1.0.0",
        "skill_id": "goal.write_issue",
        "llm_model": "openai/gpt-5.3-codex",
        "label": "Revise issue spec",
        "output_key": "revised_issue_spec_raw",
        "output_format": "json",
        "reasoning_effort": "medium",
        "timeout": "${goal_decomposition_timeouts.issue_revise}",
        "prompt": "Use read to load ${capability_goal_decomposition_skills}/issue_writer/current.md and follow its guidance on issue structure.\n\nYou are revising an existing GitHub issue spec based on judge feedback.\n\nIntent stack JSON:\n${intent_stack}\n\nGoal issue JSON:\n${goal_issue}\n\nGoal context JSON:\n${goal_context}\n\nFeature JSON:\n${feature}\n\nCurrent issue URL:\n${issue_url}\n\nReview notes to address:\n${review_notes}\n\nRead the current issue content, then revise the issue spec to address the review notes.\nKeep the revised issue executable on a shared wave branch by one builder-reviewer loop.\nPreserve alignment to the parent goal, include specific file paths, functions, tests, and boundaries when supported by goal_context, and tighten any vague or over-broad acceptance criteria.\n\nDo not preserve weak framing just because it came from the input feature. If the current issue still reads like scaffolding, continuity work, or meta-work instead of a real shipped increment, rewrite it toward one meaningful slice of the parent goal while staying faithful to platform and factory intent.\n\nReturn JSON only with issue_title, issue_body, and issue_labels.\nDo not call gh directly.",
        "session_id": "goal-decomposer-${issue_number}"
      }
