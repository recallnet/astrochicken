      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "common.normalize_feature_issue_spec_bundle",
        "label": "Normalize revised issue spec",
        "outputs": "issue_spec,issue_spec_b64",
        "action_feature": "${feature}",
        "action_issue_spec_b64": "${issue_spec_b64}",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
