        "action_id": "common.validate_issue_spec_draft",
        "label": "Validate issue spec",
        "output_format": "json",
        "outputs": "ok,error,retry_prompt,issue_spec,issue_spec_b64",
        "action_feature": "${feature}",
        "action_issue_spec": "${issue_spec}",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
      }
    },
    {
      "id": "validate_repaired_issue_spec",
      "kind": "tool_action",
      "title": "Validate repaired issue spec",
      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "common.validate_issue_spec_draft",
        "label": "Validate repaired issue spec",
        "output_format": "json",
        "outputs": "ok,error,retry_prompt,issue_spec,issue_spec_b64",
        "action_feature": "${feature}",
        "action_issue_spec": "${issue_spec}",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}.tool"
