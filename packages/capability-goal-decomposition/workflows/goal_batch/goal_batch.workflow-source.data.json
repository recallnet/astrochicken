        "prompt_version": "2026-03-09.r1",
        "role_version": "1.0.0",
        "skill_id": "goal.batch",
        "label": "Review goals",
        "output_key": "review_result",
        "output_format": "json",
        "outputs": "decisions",
        "prompt": "You are reviewing open goal issues to detect duplicates or obsolete goals.\n\nGoal issues JSON:\n${goal_issues}\n\nReturn JSON with:\n{\n  \"decisions\": [\n    {\n      \"issue_number\": 3,\n      \"decision\": \"keep|duplicate|close\",\n      \"canonical_issue\": 0,\n      \"reason\": \"short rationale\"\n    }\n  ]\n}\n\nRules:\n- Include every goal issue exactly once.\n- Use duplicate when the goal is substantively the same as another; set canonical_issue to the issue number to keep.\n- Use close only if the goal is clearly complete/obsolete even if not a duplicate.\n- Otherwise use keep.\n- Use only issue numbers from the input.\n\nReturn JSON only."
      }
