        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}"
      }
    },
    {
      "id": "encode_release_report_context",
      "kind": "tool_action",
      "title": "Encode release context (base64)",
      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "common.encode_base64",
        "label": "Encode release context (base64)",
        "output_key": "release_report_context_b64",
        "action_value": "${release_report_context}",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}"
      }
    },
    {
      "id": "encode_release_slack_payload",
      "kind": "tool_action",
      "title": "Encode release Slack payload (base64)",
      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
