        "action_delivery_status": "${release_report_issue_delivery}",
        "action_input_contract": "release.report_context@v1+release.delivery_status@v1",
        "action_output_contract": "release.dedup_cursor_update@v1",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}"
      }
