    },
    {
      "from": "build_release_report_context",
      "to": "load_release_narrator_skill"
    },
    {
      "from": "load_release_narrator_skill",
      "to": "release_narrator"
    },
    {
      "from": "release_narrator",
      "to": "narrative_delivery_gate"
    },
    {
      "from": "update_release_dedup_cursor",
      "to": "done"
    },
    {
      "from": "build_release_slack_blocks",
      "to": "encode_release_slack_payload"
    },
    {
      "from": "create_shaping_followup_issue",
      "to": "build_release_slack_blocks",
      "condition": "delivery_decision=slack_and_issue",
      "dotAttributes": {
        "condition": "delivery_decision=slack_and_issue"
      }
    },
    {
      "from": "create_shaping_followup_issue",
      "to": "update_release_dedup_cursor",
      "condition": "delivery_decision=issue_only",
      "dotAttributes": {
        "condition": "delivery_decision=issue_only"
      }
    },
    {
      "from": "emit_release_narrative_document",
      "to": "create_shaping_followup_issue"
    },
    {
      "from": "encode_release_narrative",
      "to": "publish_release_report"
    },
    {
      "from": "encode_release_report_context",
      "to": "encode_release_narrative"
    },
    {
      "from": "encode_release_slack_payload",
      "to": "post_release_to_slack"
    },
    {
      "from": "narrative_delivery_gate",
      "to": "done",
      "condition": "delivery_decision=skip",
      "dotAttributes": {
        "condition": "delivery_decision=skip"
      }
    },
    {
      "from": "narrative_delivery_gate",
      "to": "encode_release_report_context",
      "condition": "delivery_decision!=skip",
      "dotAttributes": {
        "condition": "delivery_decision!=skip"
      }
    },
    {
      "from": "post_release_to_slack",
      "to": "update_release_dedup_cursor"
    },
    {
      "from": "publish_release_report",
      "to": "emit_release_narrative_document"
    }
  ]
