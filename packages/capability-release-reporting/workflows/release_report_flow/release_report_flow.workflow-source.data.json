        "action_context_b64": "${release_report_context_b64}",
        "action_input_contract": "release.report_context@v1+release.narrative@v1",
        "action_narrative_b64": "${release_narrative_b64}",
        "action_output_contract": "release.report_issue_delivery@v1",
        "recovery_owner": "supervisor",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}"
      }
    },
    {
      "id": "release_narrator",
      "kind": "llm_prompt",
      "title": "Narrate release capability shift",
      "dotAttributes": {
        "class": "release_narrator",
        "benchmark_job_id": "supervisor.tick.release_narrate",
        "llm_path_id": "capability.release_report_flow.release_narrator",
        "prompt_version": "2026-03-21.r1",
        "role_version": "2.0.0",
        "skill_id": "supervisor.release_narrator",
        "label": "Narrate release capability shift",
        "output_key": "release_narrative",
        "output_format": "json",
        "outputs": "delivery_decision,headline,summary,report_body",
        "reasoning_effort": "low",
        "timeout": "5m",
        "prompt": "You are the release narrator for ${gh_repo}.\n\n${release_narrator_skill_content}\n\nRelease context JSON:\n${release_report_context}\n\nReturn a JSON object with the keys described in the skill contract above. No markdown fences.",
        "session_id": "supervisor-${factory_id}"
      }
    },
    {
      "id": "start",
      "kind": "start",
      "dotAttributes": {
        "shape": "Mdiamond"
      }
    },
    {
      "id": "update_release_dedup_cursor",
      "kind": "tool_action",
      "title": "Update release dedup cursor",
      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "release.update_dedup_cursor",
        "label": "Update release dedup cursor",
        "output_key": "__release_dedup_cursor_result",
