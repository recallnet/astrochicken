      "kind": "tool_action",
      "title": "Emit release narrative document",
      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "release.emit_narrative_document",
        "label": "Emit release narrative document",
        "output_key": "release_narrative_document_delivery",
        "output_format": "json",
        "outputs": "release_narrative_document_json_path:json_path,release_narrative_document_markdown_path:markdown_path",
        "action_factory_id": "${factory_id}",
        "action_category": "delivery",
        "action_contains_internal_only": "false",
        "action_context_b64": "${release_report_context_b64}",
        "action_input_contract": "release.report_context@v1+release.narrative@v1+release.report_issue_delivery@v1",
        "action_internal_only_sections": "[]",
        "action_issue_url": "${release_report_issue_url}",
        "action_narrative_b64": "${release_narrative_b64}",
        "action_output_contract": "release.narrative_document_delivery@v1",
        "action_output_dir": "reports/release/narratives",
        "action_publishable": "true",
        "action_repo_path": "${repo_path}",
        "action_tags": "[\"release-report\",\"factory-ops\"]",
        "action_taxonomy": "[\"delivery\",\"operations\"]",
        "action_topics": "[\"${gh_repo}\",\"${factory_id}\"]",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}"
      }
