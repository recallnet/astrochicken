      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "release.build_report_context",
        "label": "Build release report context",
        "output_key": "release_report_context",
        "action_repo": "${gh_repo}",
        "action_factory_id": "${factory_id}",
        "action_output_contract": "release.report_context@v1",
        "action_repo_path": "${repo_path}",
        "trust_domain": "${trust_domain}",
        "trust_role": "${trust_role}"
      }
    },
    {
      "id": "build_release_slack_blocks",
      "kind": "tool_action",
      "title": "Build release Slack Block Kit payload",
      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "action_runtime": "in_process",
        "action_id": "release.build_slack_blocks",
        "label": "Build release Slack Block Kit payload",
