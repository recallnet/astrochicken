      "kind": "llm_prompt",
      "title": "Load release narrator skill",
      "dotAttributes": {
        "type": "tool",
        "governance": "reversible",
        "label": "Load release narrator skill",
        "output_key": "release_narrator_skill_content",
        "prompt": "cat packages/factory-skills/skills/runtime/release_narrator/SKILL.md",
