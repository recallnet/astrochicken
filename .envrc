# Developer-local direnv overrides
[[ -f .envrc.local ]] && source .envrc.local

# Deterministic per-worktree ports via direnv.
# The main checkout uses the default port (55432); other worktrees get a
# deterministic offset from hashing the worktree directory name.
WORKTREE_ID=$(basename "$(git rev-parse --show-toplevel)")

if [[ "$WORKTREE_ID" == "main" || "$WORKTREE_ID" == "astrochicken" ]]; then
  PORT_OFFSET=0
else
  PORT_OFFSET=$(( ($(printf '%s' "$WORKTREE_ID" | cksum | cut -d' ' -f1) % 500) * 100 + 10000 ))
fi

# Canonical event store postgres port and connection string (local docker defaults;
# see packages/factory-ops/config/postgres/canonical-event-store.compose.yml)
export CANONICAL_EVENT_STORE_PORT=$(( 55432 + PORT_OFFSET ))
export HATCH_CANONICAL_EVENT_STORE_URL="postgres://astrochicken:astrochicken@127.0.0.1:${CANONICAL_EVENT_STORE_PORT}/astrochicken_factory"

# Optional local overrides (secrets/API keys, not ports)
dotenv_if_exists .env
