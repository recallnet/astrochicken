{
  "kind_id": "brainstorm",
  "schema_version": 1,
  "managed": true,
  "execution_mode": "issues_only",
  "default_target_repo": "example-org/example-notes",
  "default_workspace_mode": "api_only",
  "shared_supervisor_shell": "packages/factory-runtime/workflows/managed-supervisor-shell/managed-supervisor-shell.workflow-source.mjs",
  "domain_graph": "factories/brainstorm/workflows/dispatch-control/domain_brainstorm.workflow-source.mjs",
  "shell_hooks": {
    "managed_load_context": "hatch-ops supervisor managed-load-context",
    "managed_domain_contract": "hatch-ops supervisor managed-domain-contract"
  },
  "capabilities": [
    {
      "id": "@hatch/capability-brainstorming",
      "channel": "stable"
    }
  ],
  "supported_destinations": [
    "goal_issues",
    "platform_incidents"
  ],
  "required_labels": [
    "hatch:intake"
  ]
}
