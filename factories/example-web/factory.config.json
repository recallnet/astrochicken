{
  "schema": "hatch.factory.config.v1",
  "factory_id": "example-web",
  "factory_root": "factories/example-web",
  "kind_id": "example-web",
  "instance_id": "example-web",
  "target_repo": "example-org/example-web",
  "control_plane_repo": "recallnet/astrochicken",
  "workspace_mode": "checkout",
  "service_registry_path": "factory-registry.json",
  "installation_manifest_path": ".hatch/hosts/example-web/installation.json",
  "destinations": {
    "platform_incidents": {
      "repo": "recallnet/astrochicken",
      "labels": [
        "managed-factory-bug",
        "factory:example-web"
      ]
    }
  },
  "tracking_issue": 2235,
  "provider": "openrouter",
  "model": "openai/gpt-5.3-codex",
  "dispatch": {
    "graph": "packages/factory-runtime/workflows/managed_supervisor/managed_supervisor.workflow-source.mjs"
  },
  "skills": {
    "supervisor": "packages/factory-skills/skills/runtime/supervisor_review/SKILL.md"
  },
  "scenarios": {
    "root": "packages/factory-runtime/scenarios/managed_software_delivery"
  },
  "pipeline": {
    "supervisor_tick": "packages/factory-runtime/workflows/managed_supervisor/managed_supervisor.workflow-source.mjs"
  },
  "runs_dir": ".hatch/example-web/runs",
  "canonical_checkout_path": "${HATCH_CANONICAL_CHECKOUT_PATH}",
  "work_dir": "/path/to/example-web",
  "managed": true,
  "upstream_repo": "recallnet/astrochicken",
  "upstream_bug_labels": [
    "managed-factory-bug",
    "factory:example-web"
  ],
  "capabilities": {
    "goal_decomposition": {
      "timeouts": {
        "issue_draft": "30m",
        "issue_repair": "30m",
        "issue_judge": "30m",
        "issue_revise": "30m"
      }
    }
  },
  "trust": {
    "domain": "example-web.local",
    "roles": [
      "example-web.local.codergen",
      "example-web.local.tool",
      "example-web.local.agent.worktree",
      "example-web.local.stack.manager_loop",
      "example-web.local.pipeline",
      "example-web.local.fan_out.dynamic",
      "example-web.local.fan_in.dynamic"
    ]
  },
  "trust_domain": "example-web.local",
  "trust_roles": [
    "example-web.local.codergen",
    "example-web.local.tool",
    "example-web.local.agent.worktree",
    "example-web.local.stack.manager_loop",
    "example-web.local.pipeline",
    "example-web.local.fan_out.dynamic",
    "example-web.local.fan_in.dynamic"
  ],
  "max_concurrent_waves": 3,
  "max_goal_runs_per_tick": 2,
  "schedules": {
    "jobs": [
      {
        "id": "daily-release-report",
        "type": "graph",
        "graph": "packages/capability-release-reporting/workflows/release_report_flow/release_report_flow.workflow-source.mjs",
        "cron": "30 14 * * *",
        "time_zone": "America/Denver",
        "catch_up": false,
        "repo": "recallnet/astrochicken",
        "notify_slack": true,
        "issue_labels": ["daily-release-report"]
      }
    ]
  }
}
