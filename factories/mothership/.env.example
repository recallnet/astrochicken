# mothership factory environment example
# Generated from config/testing/factory-env/shared-env.contract.json and factories/<factory>/env.contract.json.
# Update the contracts, then run: node scripts/check-factory-env-contracts.ts --write

# Shared runtime env
# Optional · secret
# Optional GitHub auth token override for factories that opt into isolated GitHub auth.
HATCH_FACTORY_GITHUB_TOKEN=

# Optional · non-secret
# Optional override for the active provider name used by factory model policy.
HATCH_MODEL_PROVIDER=

# Optional · non-secret
# Optional override for the active model slug used by factory model policy.
HATCH_MODEL=

# Optional · non-secret
# Optional Langfuse API base URL override for telemetry and Daily Lens collectors.
LANGFUSE_BASE_URL=

# Optional · non-secret
# Langfuse public key for telemetry and metrics collection.
LANGFUSE_PUBLIC_KEY=

# Optional · secret
# Langfuse secret key for telemetry and metrics collection.
LANGFUSE_SECRET_KEY=

# Optional · secret
# OpenRouter credential for LLM-backed factory analysis and runtime work.
OPENROUTER_API_KEY=

# Optional · secret
# Anthropic credential for LLM-backed factory analysis and runtime work.
ANTHROPIC_API_KEY=

# Optional · secret
# OpenAI credential for LLM-backed factory analysis and runtime work.
OPENAI_API_KEY=

# Optional · secret
# Generic Slack webhook override honored by factory notification commands.
FACTORY_SLACK_WEBHOOK_URL=

# Factory-specific env
# Required · non-secret
# Absolute path to the canonical AstroChicken checkout used by mothership for merge and
# worktree operations.
HATCH_CANONICAL_CHECKOUT_PATH=

# Optional · secret
# Slack webhook used by mothership release and Daily Lens notifications.
MOTHERSHIP_SLACK_WEBHOOK_URL=
