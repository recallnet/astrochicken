{
  "_policy": "release",
  "_shared_note": "shared.* keys define release-channel invariants for managed factories.",
  "_factory_note": "factory.* keys are local rollout preferences and notification hooks.",
  "shared": {
    "default_channel": "stable",
    "channels": {
      "stable": {
        "required_checks": ["build", "typecheck", "test:guard-gates", "test:wave-claim-gates"],
        "runtime_version_target": ">=0.0.0",
        "kind_version_target": ">=0.0.0"
      },
      "canary": {
        "required_checks": ["build", "typecheck"],
        "runtime_version_target": ">=0.0.0",
        "kind_version_target": ">=0.0.0"
      },
      "pinned": {
        "required_checks": ["build", "typecheck", "test:guard-gates", "test:wave-claim-gates"],
        "runtime_version_target": "1.0.0",
        "kind_version_target": "1.0.0"
      }
    }
  },
  "factory": {
    "preferred_channel": "stable",
    "freeze_windows": [],
    "post_merge_notifications": []
  }
}
