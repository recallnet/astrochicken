    {
      "id": "build",
      "kind": "llm_prompt",
      "title": "Implement issue",
      "roleClass": "coder",
      "prompt": "You are working inside wave ${milestone_title} on a shared wave branch and shared coding session.\n\nIntent stack JSON:\n${intent_stack}\n\nParent goal: #${goal_issue_number}\nThe parent goal context below is for alignment only. Do not implement the whole goal in this pass. Implement only the current issue first.\n\nParent goal issue JSON:\n${goal_issue}\n\nCurrent implementation issue #${issue_number}: ${issue_title}\n\n${issue_body}\n\nComplexity estimate:\n${complexity_estimate}\n\nReviewer notes (if any):\n${review_notes}\n\nFollow repo conventions. Run scoped checks relevant to your changes. Commit your work with a clear message. The commit message MUST include 'Closes #${issue_number}' so GitHub auto-closes the issue on merge. Use the platform and factory intent to favor real shipped completion over ceremony. If reviewer notes are present, address them directly in code/tests before handing back to review.\n\nScope discipline:\n- Only modify files that are directly required by THIS issue's acceptance criteria.\n- If a pre-commit test or contract test fails on code you did NOT write or change, do NOT modify the failing test or the code it guards to make it pass. Instead, report the failure in BUILDER_NOTES so the reviewer and supervisor can route it correctly.\n- This branch is shared with sibling issues. Changing files outside your scope can silently revert or break their work.\n\nOptional handoff:\n- If most of the issue was already satisfied before this pass, or the final diff is intentionally tiny because you verified/reused existing work, you may end your final response with:\n  BUILDER_NOTES: <brief reviewer-facing explanation>\n- Keep BUILDER_NOTES short and specific. Omit it when unnecessary.",
      "dotAttributes": {
        "base": "main",
        "benchmark_job_id": "wave.execute.issue.build",
        "branch": "${branch}",
        "prompt_version": "2026-03-09.r1",
        "repo": "${repo}",
        "role_version": "1.0.0",
        "session_id": "${agent_session_id}",
        "skill_id": "wave.execute.issue",
        "skip_prompt_if_commits_exist": "false"
      },
      "binding": {
        "outputKey": "builder_output"
      },
      "policy": {
        "timeout": "300m",
        "maxRetries": 1
      }
    },
    {
      "id": "build_review_context",
      "kind": "tool_action",
      "title": "Build reviewer context contract",
      "handlerType": "tool",
      "actionId": "coding.build_review_context",
      "dotAttributes": {
        "action_branch": "${branch}",
        "action_issue_number": "${issue_number}",
        "action_review_evidence_path": "${review_evidence_path}",
        "action_runtime": "in_process",
        "action_worktree_dir": "${worktree_dir}",
        "trust_domain": "mothership.local",
        "trust_role": "mothership.local.tool"
      },
      "binding": {
        "outputFormat": "json",
        "outputs": [
          "review_context_path",
          "review_context_sha256",
          "review_context_valid",
          "review_context_error"
