{
  "$id": "https://recallnet.dev/contracts/hatch-run-lifecycle-event.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical lifecycle event payload emitted into Hatch run lifecycle event streams.",
  "properties": {
    "artifactUrl": {
      "type": "string"
    },
    "event": {
      "enum": [
        "run-start",
        "complete",
        "fail",
        "node-change",
        "merge",
        "artifact"
      ],
      "type": "string"
    },
    "graph": {
      "type": "string"
    },
    "issue": {
      "type": "string"
    },
    "mergeStatus": {
      "type": "string"
    },
    "milestone": {
      "type": "string"
    },
    "node": {
      "type": "string"
    },
    "prevNode": {
      "type": "string"
    },
    "runId": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "ts": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "ts",
    "event",
    "runId",
    "graph",
    "node"
  ],
  "title": "Hatch Run Lifecycle Event Payload",
  "type": "object"
}
