{
  "$id": "https://recallnet.dev/contracts/telemetry-summary-artifact-metadata.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Durable telemetry-derived summary bundle packaged for OCI publication.",
  "properties": {
    "artifact_identity": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "factory_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "traceparent": {
          "type": "string"
        },
        "tracestate": {
          "type": "string"
        },
        "workflow_id": {
          "type": "string"
        },
        "workflow_source_revision": {
          "type": "string"
        }
      },
      "required": [
        "factory_id",
        "run_id",
        "capability_id",
        "workflow_id",
        "workflow_source_revision",
        "correlation_id"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "telemetry_summary_artifact_metadata/v1",
      "type": "string"
    },
    "summary_kind": {
      "type": "string"
    },
    "window_end": {
      "type": "string"
    },
    "window_start": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_identity",
    "summary_kind",
    "window_start",
    "window_end"
  ],
  "title": "Telemetry Summary Bundle Metadata",
  "type": "object"
}
