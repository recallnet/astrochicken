    "command.hatch_ops.factory.host_install": "managed",
    "command.hatch_ops.factory.host_start": "managed",
    "command.hatch_ops.factory.host_stop": "managed",
    "command.hatch_ops.factory.host_restart": "managed",
    "command.hatch_ops.factory.host_health": "managed",
    "command.hatch_ops.factory.host_version": "managed",
    "command.hatch_ops.factory.host_logs": "managed"
