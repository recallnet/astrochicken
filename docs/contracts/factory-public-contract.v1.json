    "config.conformance.benchmark_telemetry_warn_only": "both",
    "config.conformance.benchmark_telemetry_exemptions": "both",
    "config.policyPack.version": "both",
    "config.policyPack.overrides": "both",
    "config.isolation.auth.github.tokenEnvVar": "both",
    "config.isolation.auth.github.repo": "both",
    "config.isolation.auth.github.factoryId": "both",
    "config.isolation.authStoragePath": "both",
    "config.isolation.model.envVar": "both",
    "config.isolation.model.value": "both",
    "config.isolation.provider.envVar": "both",
    "config.isolation.provider.value": "both",
    "config.isolation.paths.runs": "both",
    "config.isolation.paths.logs": "both",
    "config.isolation.paths.tmp": "both",
    "config.isolation.paths.cache": "both",
    "config.capabilities.goal_decomposition.timeouts.issue_draft": "both",
    "config.capabilities.goal_decomposition.timeouts.issue_repair": "both",
    "config.capabilities.goal_decomposition.timeouts.issue_judge": "both",
    "config.capabilities.goal_decomposition.timeouts.issue_revise": "both",
    "config.capabilities.goal_decomposition.timeouts.triage_plan": "both",
    "config.capabilities.goal_decomposition.timeouts.triage_repair": "both",
    "config.managed": "managed",
    "config.kind_id": "managed",
    "config.instance_id": "managed",
