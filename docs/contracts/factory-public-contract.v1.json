  "sections": [
    {
      "name": "config",
      "required": [
        "schema",
        "factory_id",
        "control_plane_repo",
        "dispatch.graph",
        "pipeline.supervisor_tick",
        "skills.supervisor",
        "scenarios.root",
        "runs_dir",
        "trust.domain",
        "trust.roles",
        "target_repo"
      ],
      "optional": [
        "dispatch.latency_slo_seconds",
        "pipeline.maintenance_interval_seconds",
        "backend.type",
        "backend.store_root",
        "conformance.entrypoint",
        "conformance.fixtures",
        "conformance.runs_dir",
        "conformance.benchmark_telemetry_warn_only",
        "conformance.benchmark_telemetry_exemptions",
        "policyPack.version",
        "policyPack.overrides",
        "isolation.auth.github.tokenEnvVar",
        "isolation.auth.github.repo",
        "isolation.auth.github.factoryId",
        "isolation.authStoragePath",
        "isolation.model.envVar",
        "isolation.model.value",
        "isolation.provider.envVar",
        "isolation.provider.value",
        "isolation.paths.runs",
        "isolation.paths.logs",
        "isolation.paths.tmp",
        "isolation.paths.cache",
        "capabilities.goal_decomposition.timeouts.issue_draft",
        "capabilities.goal_decomposition.timeouts.issue_repair",
        "capabilities.goal_decomposition.timeouts.issue_judge",
        "capabilities.goal_decomposition.timeouts.issue_revise",
        "capabilities.goal_decomposition.timeouts.triage_plan",
        "capabilities.goal_decomposition.timeouts.triage_repair"
      ],
      "managed_only": [
        "managed",
        "kind_id",
        "instance_id",
        "destinations",
        "upstream_repo",
        "work_dir",
        "upstream_bug_labels",
        "slack_webhook_url",
        "canonical_checkout_path",
        "schedules"
      ],
      "invariants": [
        "must_declare_target_repo",
        "dispatch_graph_and_pipeline_supervisor_tick_are_independent_slots",
        "managed_true_requires_upstream_repo"
      ],
      "forbidden_legacy_keys": [
        "repo",
        "control_plane",
        "goal_decomposition"
      ]
    },
    {
      "name": "graphs",
      "required": [
        "pipeline.supervisor_tick",
        "graph_parse",
        "graph_validate",
        "dot_lint",
        "recovery_ownership"
      ],
      "optional": [
        "capability_subgraphs"
      ],
      "managed_only": [
        "managed_release_orchestration_graphs",
        "managed_daemon_routing"
      ]
    },
    {
      "name": "scenarios",
      "required": [
        "scenarios.root"
      ],
      "optional": [
        "factory_defined_scenario_tree"
      ],
      "managed_only": [
        "none"
      ],
      "invariants": [
        "non_mothership_factories_must_not_use_astrochicken_leaf"
      ]
    },
    {
      "name": "policy_packs",
      "required": [
        "policy_pack_metadata_json_when_configured",
        "policy_pack_required_keys",
        "policy_pack_version_alignment"
      ],
      "optional": [
        "policyPack.overrides_for_customizable_keys"
      ],
      "managed_only": [
        "managed_release_escalation_stricter_thresholds"
      ]
    },
    {
      "name": "conformance",
      "required": [
        "config_schema",
        "intent_stack",
        "policy_pack_conformance",
        "graph_validate",
        "dot_lint",
        "recovery_ownership",
        "benchmark_telemetry",
        "run_dir_isolation",
        "skill_loading",
        "scenario_root",
        "supervisor_tick_smoke",
        "ops_contract"
      ],
      "optional": [
        "phase_subset_for_local_iteration"
      ],
      "managed_only": [
        "release_gates_on_conformance_failures"
      ]
    },
    {
      "name": "runs",
      "required": [
        "factory_scoped_runs_dir",
        "run_dir_isolation",
        "supervisor_tick_smoke_artifacts"
      ],
      "optional": [
        "conformance.runs_dir",
        "isolation.paths.*"
      ],
      "managed_only": [
        "daemon_health_markers",
        "managed_tick_logs",
        "managed_release_health_interpretation"
      ]
    },
    {
      "name": "managed_extensions",
      "required": [
        "standalone_contract_plus_managed_identity_and_routing"
      ],
      "optional": [
        "managed_notifications_and_schedules"
      ],
      "managed_only": [
        "kind_id",
        "instance_id",
        "destinations",
        "upstream_repo",
        "release_gating",
        "daemon_contracts"
      ]
    }
  ]
}
