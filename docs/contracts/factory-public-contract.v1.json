{
  "schema": "factory-public-contract.v1",
  "version": "v1",
  "drift_gate": {
    "onboarding_docs": [
      "docs/runbooks/external-factory-operator-onboarding.md"
    ],
    "required_onboarding_links": [
      "../reference/factory-public-contract.md",
      "../reference/factory-mode-applicability.md",
      "../contracts/factory-public-contract.v1.json"
    ],
    "allowed_template_managed_only": [
      "instance_id",
      "canonical_checkout_path"
    ]
  },
  "mode_applicability_schema": {
    "allowed_modes": [
      "standalone",
      "managed",
      "both"
    ],
    "key_families": {
      "config": "config.<factory-config-key>",
      "env": "env.<environment-key>",
      "command": "command.<family>"
    },
    "validation": [
      "all mode_applicability values must match allowed_modes",
      "all config keys from sections[name=config].required|optional|managed_only must be represented as config.*",
      "all documented lifecycle command families must be represented as command.*"
    ]
  },
  "mode_applicability": {
    "config.schema": "both",
    "config.factory_id": "both",
    "config.control_plane_repo": "both",
