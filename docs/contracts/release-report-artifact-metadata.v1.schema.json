{
  "$id": "https://recallnet.dev/contracts/release-report-artifact-metadata.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Release narrative report bundle packaged for durable OCI publication.",
  "properties": {
    "artifact_identity": {
      "additionalProperties": false,
      "properties": {
        "capability_id": {
          "type": "string"
        },
        "correlation_id": {
          "type": "string"
        },
        "factory_id": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "traceparent": {
          "type": "string"
        },
        "tracestate": {
          "type": "string"
        },
        "workflow_id": {
          "type": "string"
        },
        "workflow_source_revision": {
          "type": "string"
        }
      },
      "required": [
        "factory_id",
        "run_id",
        "capability_id",
        "workflow_id",
        "workflow_source_revision",
        "correlation_id"
      ],
      "type": "object"
    },
    "generated_at": {
      "type": "string"
    },
    "report_issue_url": {
      "format": "uri",
      "type": "string"
    },
    "report_kind": {
      "const": "release_narrative",
      "type": "string"
    },
    "schema_version": {
      "const": "release_report_artifact_metadata/v1",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_identity",
    "report_kind",
    "report_issue_url",
    "generated_at"
  ],
  "title": "Release Report Bundle Metadata",
  "type": "object"
}
