// Generated from packages/factory-runtime/workflows/managed_software_delivery_domain/managed_software_delivery_domain.workflow-source.mjs. Do not edit by hand.
@import "../../../../factories/_shared/roles.stylesheet"

digraph managed_software_delivery_domain {
    label = "managed_software_delivery_domain"
    workflow_source = "packages/factory-runtime/workflows/managed_software_delivery_domain/managed_software_delivery_domain.workflow-source.mjs"
    typed_action_transport_mode = "enforced"
    action_item_gate [shape="diamond" label="Action items to process?" recovery_owner="supervisor"]
    artifact_ingest [type="pipeline" label="Ingest artifacts" recovery_owner="supervisor" pipeline="@hatch/capability-artifact-ingestion/workflows/artifact_ingest/artifact_ingest.workflow-source.mjs" export_keys="artifact_ingest_result" inherit_context="true" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    auto_ready_artifact_goals [type="tool" governance="irreversible" action_runtime="in_process" action_id="goal.auto_ready_artifacts" label="Auto-ready artifact goals" output_key="__auto_ready_artifact_goals_result" action_repo="${gh_repo}" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    bug_fast_gate [shape="diamond" label="Open bugs? (fast route)" recovery_owner="supervisor"]
    bug_fast_resolution_gate [shape="diamond" label="Bugs resolved by fast route?" recovery_owner="supervisor"]
    count_ready_goals [type="tool" governance="reversible" action_runtime="in_process" action_id="common.count_json_items" label="Count ready goals" output_key="goal_count" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    done [shape="Msquare" recovery_sink_type="terminal"]
    ensure_goal_execution_path [type="tool" governance="reversible" action_runtime="in_process" action_id="goal.ensure_execution_paths" label="Ensure goal execution-path packets" output_format="json" outputs="goal_execution_path_count,goal_execution_path_records,goal_execution_paths" action_repo_root="${repo}" action_factory_id="${factory_id}" recovery_owner="supervisor" action_goal_issues="${kept_goals_limited}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    evaluate_action_item_gate [type="tool" governance="reversible" action_runtime="in_process" action_id="supervisor.action_item_gate" label="Check if supervisor review has work" output_format="json" outputs="has_action_items,action_item_count" action_repo="${target_repo}" action_factory_id="${factory_id}" recovery_owner="supervisor" action_control_plane_repo="${control_plane_repo}" action_target_repo="${target_repo}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    evaluate_open_bug_gate_after_fast [type="tool" governance="reversible" action_runtime="in_process" action_id="supervisor.open_bug_gate" label="Evaluate open bug gate after fast route" output_format="json" outputs="has_open_bugs,open_bug_count,parse_error" action_repo="${target_repo}" action_factory_id="${factory_id}" action_label_filters="[\"managed-factory-bug\",\"factory:${factory_id}\"]" recovery_owner="supervisor" action_control_plane_repo="${control_plane_repo}" action_target_repo="${target_repo}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    evaluate_open_bug_gate_fast [type="tool" governance="reversible" action_runtime="in_process" action_id="supervisor.open_bug_gate" label="Evaluate open bug gate" output_format="json" outputs="has_open_bugs,open_bug_count,parse_error" action_repo="${target_repo}" action_factory_id="${factory_id}" action_label_filters="[\"managed-factory-bug\",\"factory:${factory_id}\"]" recovery_owner="supervisor" action_control_plane_repo="${control_plane_repo}" action_target_repo="${target_repo}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    fan_in_goal_run [type="fan_in.dynamic" label="Collect goal runs" output_key="goal_runs" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    fan_out_goal_run [type="fan_out.dynamic" label="Run goals in parallel" recovery_owner="supervisor" source_key="kept_goals_limited" item_key="issue_number" template="@hatch/capability-goal-decomposition/workflows/goal_run/goal_run.workflow-source.mjs" max_concurrency="0" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    fast_route_telemetry_clear [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Record fast-route clear branch" output_key="fast_route_branch_marker" recovery_owner="supervisor" action_fallback="fast-route-clear" action_value="fast-route-clear" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    fast_route_telemetry_open [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Record fast-route open-bug branch" output_key="fast_route_branch_marker" recovery_owner="supervisor" action_fallback="fast-route-open" action_value="fast-route-open" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    goal_decompose_backpressure [type="tool" governance="reversible" action_runtime="in_process" action_id="goal.decompose_backpressure" label="Check goal decomposition backpressure" output_format="json" outputs="decompose_allowed,decompose_skip_reason,open_wave_marker_count,max_concurrent_waves" action_repo="${gh_repo}" recovery_owner="supervisor" action_max_concurrent_waves="${max_concurrent_waves_pre}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    goal_decompose_gate [shape="diamond" label="Decompose goals this tick?" recovery_owner="supervisor"]
    goal_execute_gate [shape="diamond" label="Executable goals this tick?" recovery_owner="supervisor"]
    goal_gate [shape="diamond" label="Any ready goals?" recovery_owner="supervisor"]
    keep_all_goals [type="tool" governance="reversible" action_runtime="in_process" action_id="goal.filter_kept_goals" label="Keep all ready goals" output_key="kept_goals" recovery_owner="supervisor" action_decisions="[]" action_issues="${goal_issues}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    limit_kept_goals [type="tool" governance="reversible" action_runtime="in_process" action_id="goal.limit_kept" label="Limit goal runs per tick to avoid execution starvation" output_key="kept_goals_limited" recovery_owner="supervisor" action_kept_goals="${kept_goals}" action_max_goals_per_tick="${max_goal_runs_per_tick}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    list_executable_goals [type="tool" governance="reversible" action_runtime="in_process" action_id="software.list_executable_goals" label="List executable goals" output_format="json" outputs="executable_goals,count,capped" action_repo="${gh_repo}" action_repo_root="${repo}" action_factory_id="${factory_id}" recovery_owner="supervisor" action_max_concurrent="${max_concurrent_waves_pre}" action_runs_dir="${absolute_runs_dir}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    list_ready_goals [type="tool" governance="reversible" action_runtime="in_process" action_id="goal.list_ready" label="List ready goals" output_key="goal_issues" action_repo="${gh_repo}" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    load_intent_stack [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_intent_stack" label="Load intent stack" output_key="intent_stack" recovery_owner="supervisor" action_config_path="${factory_root}/factory.config.json" action_factory_root="${factory_root}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    load_supervisor_bug_fast_task_prompt [type="tool" governance="reversible" label="Load supervisor bug fast task prompt" output_key="supervisor_bug_fast_task_prompt" prompt="cat packages/factory-prompts/prompts/supervisor/bug_fast.md" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    load_supervisor_review_task_prompt [type="tool" governance="reversible" label="Load supervisor review task prompt" output_key="supervisor_review_task_prompt" prompt="cat packages/factory-prompts/prompts/supervisor/review.md" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    load_supervisor_skill [type="tool" governance="reversible" label="Load shared supervisor skill" output_key="supervisor_skill_content" prompt="cat packages/factory-skills/skills/runtime/supervisor_review/SKILL.md" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    load_supervisor_system_prompt [type="tool" governance="reversible" label="Load supervisor system prompt" output_key="supervisor_system_prompt" prompt="cat packages/factory-prompts/prompts/supervisor/system.md" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    release_manifest [type="tool" governance="irreversible" action_runtime="in_process" action_id="artifact.release_manifest" label="Emit release manifest" output_key="__release_manifest_result" action_run_id="${__run_id}" recovery_owner="supervisor" action_control_plane_repo="${control_plane_repo}" action_release_sha="${release_sha}" action_source_repos="${source_repos}" action_states="closed" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    resolve_absolute_runs_dir [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Resolve absolute runs dir" output_key="absolute_runs_dir" recovery_owner="supervisor" action_fallback="${repo}/.hatch/${factory_id}/runs" action_value="${runs_dir}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    sanitize_goal_duplicates [type="tool" governance="irreversible" action_runtime="in_process" action_id="goal.sanitize_duplicates" label="Normalize goal duplicates" output_key="__sanitize_goal_duplicates_result" action_repo="${gh_repo}" action_run_id="${__run_id}" action_pipeline="factory_supervisor_tick" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_capability_goal_decomposition_skills [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_capability_goal_decomposition_skills_path" label="set capability_goal_decomposition_skills" output_key="capability_goal_decomposition_skills" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_control_plane_repo [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Resolve control-plane repo" output_key="control_plane_repo" recovery_owner="supervisor" action_fallback="${target_repo}" action_value="${control_plane_repo}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_date [type="tool" governance="reversible" label="Set current date" output_key="date" prompt="date -u '+%Y-%m-%dT%H:%M:%SZ'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_domain_result [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Build domain_result payload" output_key="domain_result" recovery_owner="supervisor" action_fallback="{}" action_value="{\"has_issue\":\"${has_issue}\",\"selected_issue_number\":\"${selected_issue_number}\",\"fast_route_branch_marker\":\"${fast_route_branch_marker}\",\"goal_count\":\"${goal_count}\",\"executable_goal_count\":\"${count}\",\"action_item_count\":\"${action_item_count}\",\"parse_error\":\"${parse_error}\"}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_factory_root [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Resolve factory root" output_key="factory_root" recovery_owner="supervisor" action_fallback="factories/${factory_id}" action_value="${factory_root}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_gh_repo [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Resolve target repo context" output_key="gh_repo" recovery_owner="supervisor" action_fallback="${target_repo}" action_value="${target_repo}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_judge_scenario_selector [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="set judge_scenario_selector" output_key="judge_scenario_selector" recovery_owner="supervisor" action_fallback="post-merge" action_value="post-merge" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_max_artifacts [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_factory_config" label="Resolve max artifacts" output_key="__set_max_artifacts_result" recovery_owner="supervisor" action_factory_root="${factory_root}" action_fallback="20" action_key="max_artifacts" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_max_concurrent_waves_pre [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_factory_config" label="Resolve max concurrent waves (pre-goal gate)" output_key="max_concurrent_waves_pre" recovery_owner="supervisor" action_factory_root="${factory_root}" action_fallback="3" action_key="max_concurrent_waves" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_max_goal_runs_per_tick [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_factory_config" label="Resolve max goal runs per tick" output_key="max_goal_runs_per_tick" recovery_owner="supervisor" action_factory_root="${factory_root}" action_fallback="2" action_key="max_goal_runs_per_tick" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_release_sha [type="tool" governance="reversible" label="Resolve release SHA from main branch" output_key="release_sha" prompt="git rev-parse main" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_repo [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Resolve target work dir" output_key="repo" recovery_owner="supervisor" action_fallback="." action_value="${repo}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_run_id [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Resolve run id" output_key="__run_id" recovery_owner="supervisor" action_value="${__run_id}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_source_repos [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_factory_config" label="Resolve source repos" output_key="source_repos" recovery_owner="supervisor" action_factory_root="${factory_root}" action_fallback="${target_repo}" action_key="source_repos" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    spawn_goal_execute [type="fan_out.detached" label="Run executable goals" recovery_owner="supervisor" source_key="executable_goals" item_key="goal_issue_number" template="@hatch/capability-software-development/workflows/goal_execute/goal_execute.workflow-source.mjs" max_concurrency="0" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    start [shape="Mdiamond"]
    supervisor_review [class="supervisor" benchmark_job_id="supervisor.tick.review" prompt_version="2026-03-09.r1" role_version="1.0.0" skill_id="supervisor.review" label="Supervisor LLM review" timeout="60m" prompt="${supervisor_system_prompt}\n\nFactory target: ${target_repo}\nDate: ${date}\n\nFactory context:\n- factory_id=${factory_id}\n- target_repo=${target_repo}\n- control_plane_repo=${control_plane_repo}\n- gh_repo=${gh_repo}\n\nSupervisor template (shared):\n${supervisor_skill_content}\n\nState snapshot:\n${state_snapshot}\n\n${supervisor_review_task_prompt}" recovery_owner="supervisor" prompt_input_keys="target_repo,date,factory_id,control_plane_repo,gh_repo,supervisor_skill_content,state_snapshot" prompt_source="supervisor_review_task_prompt" session_id="supervisor-${factory_id}" system_prompt_source="supervisor_system_prompt" task_prompt_source="supervisor_review_task_prompt" workdir="."]
    supervisor_review_bug_fast [class="supervisor" benchmark_job_id="supervisor.tick.bug_review_fast" prompt_version="2026-03-09.r1" role_version="1.0.0" skill_id="supervisor.review_bug_fast" label="Supervisor bug fast-route" timeout="60m" prompt="${supervisor_system_prompt}\n\nFactory target: ${target_repo}\nDate: ${date}\n\nFactory context:\n- factory_id=${factory_id}\n- target_repo=${target_repo}\n- control_plane_repo=${control_plane_repo}\n- gh_repo=${gh_repo}\n\nIntent stack JSON:\n${intent_stack}\n\nSupervisor template (shared):\n${supervisor_skill_content}\n\nState snapshot:\n${state_snapshot}\n\n${supervisor_bug_fast_task_prompt}" recovery_owner="supervisor" prompt_input_keys="target_repo,date,factory_id,control_plane_repo,gh_repo,intent_stack,supervisor_skill_content,state_snapshot" prompt_source="supervisor_bug_fast_task_prompt" session_id="supervisor-${factory_id}" system_prompt_source="supervisor_system_prompt" task_prompt_source="supervisor_bug_fast_task_prompt" workdir="."]
    sweep_completed_goals [type="tool" governance="irreversible" action_runtime="in_process" action_id="goal.sweep_completed" label="Close goals with all waves done" output_key="__sweep_completed_goals_result" action_repo="${gh_repo}" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    sweep_empty_milestones [type="tool" governance="irreversible" action_runtime="in_process" action_id="milestone.sweep_empty" label="Close empty wave milestones" output_key="__sweep_empty_milestones_result" action_repo="${gh_repo}" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    sync_release_manifest [type="tool" governance="irreversible" action_runtime="in_process" action_id="factory.publish_control_plane_manifest" label="Sync manifest to canonical location" output_key="__sync_release_manifest_result" recovery_owner="supervisor" action_manifest_path=".hatch/runs/${__run_id}/artifacts/release-manifest.json" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    artifact_ingest -> auto_ready_artifact_goals -> sanitize_goal_duplicates -> sweep_completed_goals -> sweep_empty_milestones -> list_ready_goals -> count_ready_goals -> goal_gate
    evaluate_action_item_gate -> action_item_gate
    set_domain_result -> done
    set_release_sha -> release_manifest -> sync_release_manifest -> list_executable_goals -> goal_execute_gate
    start -> set_factory_root -> set_gh_repo -> set_repo -> set_control_plane_repo -> set_date -> set_run_id -> load_intent_stack -> load_supervisor_skill -> load_supervisor_system_prompt -> load_supervisor_bug_fast_task_prompt -> load_supervisor_review_task_prompt -> set_source_repos -> set_max_artifacts -> set_max_concurrent_waves_pre -> set_max_goal_runs_per_tick -> resolve_absolute_runs_dir -> set_capability_goal_decomposition_skills -> set_judge_scenario_selector -> evaluate_open_bug_gate_fast -> bug_fast_gate
    action_item_gate -> set_domain_result [condition="has_action_items!=true"]
    action_item_gate -> supervisor_review [condition="has_action_items=true"]
    bug_fast_gate -> fast_route_telemetry_clear [condition="has_open_bugs!=true"]
    bug_fast_gate -> fast_route_telemetry_open [condition="has_open_bugs=true"]
    bug_fast_resolution_gate -> artifact_ingest [condition="has_open_bugs!=true"]
    bug_fast_resolution_gate -> set_domain_result [condition="has_open_bugs=true"]
    ensure_goal_execution_path -> fan_out_goal_run
    evaluate_open_bug_gate_after_fast -> bug_fast_resolution_gate
    fan_in_goal_run -> set_release_sha
    fan_out_goal_run -> fan_in_goal_run
    fast_route_telemetry_clear -> artifact_ingest
    fast_route_telemetry_open -> supervisor_review_bug_fast
    goal_decompose_backpressure -> goal_decompose_gate [input_key="goal_issues"]
    goal_decompose_gate -> keep_all_goals [condition="decompose_allowed=true"]
    goal_decompose_gate -> set_release_sha [condition="decompose_allowed!=true"]
    goal_execute_gate -> evaluate_action_item_gate [condition="count=0"]
    goal_execute_gate -> spawn_goal_execute [condition="count!=0"]
    goal_gate -> goal_decompose_backpressure [condition="goal_count!=0"]
    goal_gate -> set_release_sha [condition="goal_count=0"]
    keep_all_goals -> limit_kept_goals
    limit_kept_goals -> ensure_goal_execution_path
    spawn_goal_execute -> evaluate_action_item_gate
    supervisor_review_bug_fast -> evaluate_open_bug_gate_after_fast
    supervisor_review -> set_domain_result
}
