// Generated from packages/factory-runtime/workflows/managed-supervisor-shell/managed-supervisor-shell.workflow-source.mjs. Do not edit by hand.
digraph "managed-supervisor-shell" {
    label = "managed_supervisor"
    workflow_source = "packages/factory-runtime/workflows/managed-supervisor-shell/managed-supervisor-shell.workflow-source.mjs"
    action_item_gate [shape="diamond" label="Action items unresolved?" recovery_owner="supervisor"]
    check_control_state [type="tool" governance="reversible" label="Check control state" output_format="json" outputs="control_gate,control_state_action,control_state_reason,should_run,parse_error,state_path" prompt="hatch-ops supervisor managed-control-gate --factory-id '${factory_id}' --root-dir '${repo}'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    classify_active [type="tool" governance="reversible" label="Lifecycle -> active" output_format="json" outputs="lifecycle_state,health_state" prompt="hatch-ops supervisor managed-health-classifier --control-gate '${control_gate}' --has-open-upstream-bugs 'false' --has-action-items 'false' --has-selected-work 'true' --has-domain-failure 'false'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    classify_blocked_platform [type="tool" governance="reversible" label="Lifecycle -> blocked_platform" output_format="json" outputs="lifecycle_state,health_state" prompt="hatch-ops supervisor managed-health-classifier --control-gate '${control_gate}' --has-open-upstream-bugs 'true' --has-action-items '${has_action_items}' --has-selected-work 'false' --has-domain-failure 'false'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    classify_degraded [type="tool" governance="reversible" label="Lifecycle -> degraded" output_format="json" outputs="lifecycle_state,health_state" prompt="hatch-ops supervisor managed-health-classifier --control-gate '${control_gate}' --has-open-upstream-bugs 'false' --has-action-items 'false' --has-selected-work 'true' --has-domain-failure 'true'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    classify_domain_failure [type="tool" governance="reversible" label="Classify domain failure" output_format="json" outputs="failure_classification,failure_reason" prompt="hatch-ops supervisor managed-failure-classifier --domain-error '${__composite_reason}' --parse-error '${parse_error}' --gate '${control_gate}'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    classify_idle [type="tool" governance="reversible" label="Lifecycle -> idle" output_format="json" outputs="lifecycle_state,health_state" prompt="hatch-ops supervisor managed-health-classifier --control-gate '${control_gate}' --has-open-upstream-bugs 'false' --has-action-items 'false' --has-selected-work 'false' --has-domain-failure 'false'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    classify_manifest_failure [type="tool" governance="reversible" label="Classify manifest failure" output_format="json" outputs="failure_classification,failure_reason" prompt="hatch-ops supervisor managed-failure-classifier --domain-error '${manifest_error}' --parse-error '' --gate 'manifest'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    classify_paused [type="tool" governance="reversible" label="Lifecycle -> paused/draining" output_format="json" outputs="lifecycle_state,health_state" prompt="hatch-ops supervisor managed-health-classifier --control-gate '${control_gate}' --has-open-upstream-bugs 'false' --has-action-items 'false' --has-selected-work 'false' --has-domain-failure 'false'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    classify_paused_failure [type="tool" governance="reversible" label="Classify paused/draining as local control-state owner" output_format="json" outputs="failure_classification,failure_reason" prompt="hatch-ops supervisor managed-failure-classifier --domain-error '${control_state_action}:${control_state_reason}' --parse-error '' --gate 'control_state'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    control_state_gate [shape="diamond" label="Control state allows tick?" recovery_owner="supervisor"]
    domain_failure_gate [shape="diamond" label="Domain failure observed?" recovery_owner="supervisor"]
    done [shape="Msquare" recovery_sink_type="terminal" recovery_owner="supervisor"]
    emit_run_summary [type="tool" governance="reversible" label="Emit telemetry run summary" output_key="managed_run_summary" prompt="hatch-ops supervisor managed-emit-run-summary --factory-id '${factory_id}' --instance-id '${instance_id}' --kind-id '${kind_id}' --home-repo '${target_repo}' --target-repo '${target_repo}' --control-plane-repo '${control_plane_repo}' --trust-domain '${trust_domain}' --trust-role '${trust_role}' --lifecycle-state '${lifecycle_state}' --health-state '${health_state}' --failure-classification '${failure_classification}' --failure-reason '${failure_reason}' --control-gate '${control_gate}' --control-state-action '${control_state_action}' --control-state-reason '${control_state_reason}' --has-open-upstream-bugs '${has_open_upstream_bugs}' --open-upstream-bug-count '${open_upstream_bug_count}' --open-upstream-bug-numbers '${open_upstream_bug_numbers}' --has-action-items '${has_action_items}' --action-item-count '${action_item_count}' --unresolved-actions '${action_item_count}' --queue-depth '${action_item_count}' --oldest-work-age-seconds '0' --latest-incidents '[]' --has-issue '${has_issue}' --selected-issue-number '${selected_issue_number}' --domain-result '${domain_result}' --manifest-ok '${manifest_ok}' --manifest-error '${manifest_error}' --parse-error '${parse_error}'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    evaluate_action_items [type="tool" governance="reversible" label="Evaluate unresolved action items" output_format="json" outputs="has_action_items,action_item_count" prompt="hatch-ops supervisor managed-action-item-gate --snapshot \"${state_snapshot}\"" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    evaluate_open_bug_gate [type="tool" governance="reversible" label="Evaluate open bug gate" output_format="json" outputs="has_open_bugs,open_bug_count,parse_error" prompt="hatch-ops supervisor open-bug-gate --repo '${target_repo}' --factory-id '${factory_id}' --target-repo '${target_repo}' --control-plane-repo '${control_plane_repo}'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    evaluate_upstream_blockers [type="tool" governance="reversible" label="Evaluate upstream managed blockers" output_format="json" outputs="has_open_upstream_bugs,open_upstream_bug_count,open_upstream_bug_numbers,parse_error" prompt="hatch-ops supervisor upstream-bug-gate --repo '${control_plane_repo}' --label 'managed-factory-bug' --label 'kind:${kind_id}'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    intake_gate [shape="diamond" label="Intake work selected?" recovery_owner="supervisor"]
    load_context [type="tool" governance="reversible" label="Load managed kind + instance context" output_format="json" outputs="manifest_ok,manifest_error,factory_id,factory_root,kind_path,instance_path,kind_id,instance_id,target_repo,control_plane_repo,domain_graph,shared_supervisor_shell,destinations_json,intake_json,kind_context_json,trust_domain,trust_role" prompt="hatch-ops supervisor managed-load-context --factory-id '${factory_id}' --factory-root '${factory_root}' --kind-path '${kind_path}' --instance-path '${instance_path}' --kind-id '${kind_id}' --instance-id '${instance_id}' --home-repo '${target_repo}' --target-repo '${target_repo}' --control-plane-repo '${control_plane_repo}' --destinations-json '${destinations_json}' --trust-domain '${trust_domain}' --trust-role '${trust_role}' --root-dir '${repo}'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    manifest_gate [shape="diamond" label="Manifests valid?" recovery_owner="supervisor"]
    open_bug_gate [shape="diamond" label="Open bugs? (self-heal route)" recovery_owner="supervisor"]
    persist_lifecycle_state [type="tool" governance="reversible" label="Persist lifecycle state snapshot" output_format="json" outputs="ok,state_path,state_version,mirror_path,mirror_version,mirror_updated_at,mirror_error,lifecycle_state,lifecycle_reason,lifecycle_failure_classification,lifecycle_failure_reason,lifecycle_updated_at,blockers,unresolved_actions,queue_depth,oldest_work_age_seconds,latest_incidents,error,message" prompt="hatch-ops supervisor managed-persist-state --factory-id '${factory_id}' --instance-id '${instance_id}' --root-dir '${repo}' --lifecycle-state '${lifecycle_state}' --lifecycle-reason '${failure_reason}' --failure-classification '${failure_classification}' --failure-reason '${failure_reason}' --has-open-upstream-bugs '${has_open_upstream_bugs}' --open-upstream-bug-count '${open_upstream_bug_count}' --open-upstream-bug-numbers '${open_upstream_bug_numbers}' --has-action-items '${has_action_items}' --action-item-count '${action_item_count}' --unresolved-actions '${action_item_count}' --queue-depth '${action_item_count}' --oldest-work-age-seconds '0' --latest-incidents '[]' --actor 'managed_supervisor'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    run_domain_graph [type="pipeline" label="Run kind domain graph" export_keys="domain_result" fail_open="true" inherit_context="true" pipeline="${domain_graph}" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    select_intake [type="tool" governance="reversible" label="Select next intake unit" output_format="json" outputs="has_issue,selected_issue_number,selected_issue_title,selected_issue_body,intake_json,parse_error" prompt="hatch-ops supervisor managed-intake-selector --repo '${target_repo}' --intake-json '${intake_json}'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_empty_domain_result [type="tool" governance="reversible" label="Set empty domain result" output_key="domain_result" prompt="printf '{}'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_failure_classification_infrastructure [type="tool" governance="reversible" label="Set failure classification: infrastructure" output_key="failure_classification" prompt="printf 'infrastructure'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_failure_classification_none_manifest [type="tool" governance="reversible" label="Set failure classification: none (manifest path)" output_key="failure_classification" prompt="printf 'none'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_failure_reason_empty_manifest [type="tool" governance="reversible" label="Set empty failure reason (manifest path)" output_key="failure_reason" prompt="printf ''" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_failure_reason_upstream [type="tool" governance="reversible" label="Set failure reason: upstream blocker gate" output_key="failure_reason" prompt="printf 'open_upstream_bugs=%s issue_numbers=%s parse_error=%s' '${open_upstream_bug_count}' '${open_upstream_bug_numbers}' '${parse_error}'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    snapshot_state [type="tool" governance="reversible" label="Load durable snapshot" output_key="state_snapshot" prompt="hatch-ops supervisor state-snapshot --repo '${target_repo}' --factory-id '${factory_id}' --target-repo '${target_repo}' --control-plane-repo '${control_plane_repo}' --runs-dir '${runs_dir}'" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    start [shape="Mdiamond" recovery_owner="supervisor"]
    upstream_gate [shape="diamond" label="Open upstream blockers?" recovery_owner="supervisor"]
    classify_degraded -> persist_lifecycle_state
    classify_idle -> set_empty_domain_result
    persist_lifecycle_state -> emit_run_summary -> done
    run_domain_graph -> classify_domain_failure -> domain_failure_gate
    set_empty_domain_result -> persist_lifecycle_state
    start -> load_context -> manifest_gate
    action_item_gate -> run_domain_graph [condition="has_action_items=true"]
    action_item_gate -> select_intake [condition="has_action_items!=true"]
    check_control_state -> control_state_gate
    classify_active -> persist_lifecycle_state
    classify_blocked_platform -> set_empty_domain_result
    classify_manifest_failure -> classify_degraded [condition="failure_classification!=none"]
    classify_manifest_failure -> set_failure_classification_none_manifest [condition="failure_classification=none"]
    classify_paused_failure -> set_empty_domain_result
    classify_paused -> classify_paused_failure
    control_state_gate -> classify_paused [condition="should_run!=true"]
    control_state_gate -> evaluate_upstream_blockers [condition="should_run=true"]
    domain_failure_gate -> classify_active [condition="failure_classification=none"]
    domain_failure_gate -> classify_degraded [condition="failure_classification!=none"]
    evaluate_action_items -> action_item_gate
    evaluate_open_bug_gate -> open_bug_gate
    evaluate_upstream_blockers -> upstream_gate
    intake_gate -> evaluate_open_bug_gate [condition="has_issue!=true"]
    intake_gate -> run_domain_graph [condition="has_issue=true"]
    manifest_gate -> classify_manifest_failure [condition="manifest_ok!=true"]
    manifest_gate -> snapshot_state [condition="manifest_ok=true"]
    open_bug_gate -> classify_idle [condition="has_open_bugs!=true"]
    open_bug_gate -> run_domain_graph [condition="has_open_bugs=true"]
    select_intake -> intake_gate
    set_failure_classification_infrastructure -> set_failure_reason_upstream
    set_failure_classification_none_manifest -> set_failure_reason_empty_manifest [condition="failure_classification=none"]
    set_failure_reason_empty_manifest -> classify_idle [condition="failure_classification=none"]
    set_failure_reason_upstream -> classify_blocked_platform
    snapshot_state -> check_control_state
    upstream_gate -> evaluate_action_items [condition="has_open_upstream_bugs!=true"]
    upstream_gate -> set_failure_classification_infrastructure [condition="has_open_upstream_bugs=true"]
}
