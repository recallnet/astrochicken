// Generated from factories/mothership/workflows/goal-execution/goal_issue_execute.workflow-source.mjs. Do not edit by hand.
@import "../../../../factories/mothership/roles.stylesheet"

digraph goal_issue_execute {
    label = "goal_issue_execute"
    workflow_source = "factories/mothership/workflows/goal-execution/goal_issue_execute.workflow-source.mjs"
    typed_action_transport_mode = "enforced"
    workdir = "."
    approve_attempt [type="tool" governance="reversible" label="Record approve attempt" prompt=":" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    assert_main_after_build [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.assert_main_branch" label="Assert canonical checkout on main after build" output_format="json" outputs="corrected,ok" action_repo="${repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build [class="coder" benchmark_job_id="goal.execute.issue.build" llm_path_id="mothership.goal_issue_execute.build" prompt_version="2026-03-09.r1" role_version="1.0.0" skill_id="goal.execute.issue" label="Implement issue" output_key="builder_output" timeout="300m" prompt="You are working on goal #${goal_issue_number} on a shared goal branch.\n\nIntent stack JSON:\n${intent_stack}\n\nAGENTS.md excerpt (repo governance contract):\n${agents_excerpt}\n\nAGENT-LEARNINGS.md excerpt (recent proven lessons):\n${agent_learnings_excerpt}\n\nParent goal: #${goal_issue_number}\nThe parent goal context below is for alignment only. Do not implement the whole goal in this pass. Implement only the current issue first.\n\nParent goal issue JSON:\n${goal_issue}\n\nCurrent implementation issue #${issue_number}: ${issue_title}\n\n${issue_body}\n\nComplexity estimate:\n${complexity_estimate}\n\nReviewer notes (if any):\n${review_notes}\n\nFollow repo conventions. Run scoped checks relevant to your changes. Commit your work with a clear message. The commit message MUST include 'Closes #${issue_number}' so GitHub auto-closes the issue on merge. Use the platform and factory intent to favor real shipped completion over ceremony. If reviewer notes are present, address them directly in code/tests before handing back to review.\n\nScope discipline:\n- Only modify files that are directly required by THIS issue's acceptance criteria.\n- If a pre-commit test or contract test fails on code you did NOT write or change, do NOT modify the failing test or the code it guards to make it pass. Instead, report the failure in BUILDER_NOTES so the reviewer and supervisor can route it correctly.\n- This branch is shared with sibling issues. Changing files outside your scope can silently revert or break their work.\n\nOptional handoff:\n- If most of the issue was already satisfied before this pass, or the final diff is intentionally tiny because you verified/reused existing work, you may end your final response with:\n  BUILDER_NOTES: <brief reviewer-facing explanation>\n- Keep BUILDER_NOTES short and specific. Omit it when unnecessary." max_retries="1" base="main" branch="${branch}" repo="${repo}" session_id="${agent_session_id}" skip_prompt_if_commits_exist="false"]
    build_review_context [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.build_review_context" label="Build reviewer context contract" output_format="json" outputs="review_context_path,review_context_sha256,review_context_valid,review_context_error" action_issue_number="${issue_number}" action_branch="${branch}" action_review_evidence_path="${review_evidence_path}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    bump_approve [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.next_review_attempt" label="Increment review attempt (approve)" output_key="review_attempt" action_attempt="${review_attempt}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    bump_revise [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.next_review_attempt" label="Increment review attempt (revise)" output_key="review_attempt" action_attempt="${review_attempt}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    cleanup_legacy [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.cleanup_legacy_worktree" label="Cleanup legacy worktree path" output_format="json" outputs="removed,reason" action_repo="${repo}" action_legacy_worktree_dir="${legacy_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    commit_push [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.commit_local" label="Commit changes (local only)" output_format="json" outputs="ok,reason" action_repo="${repo}" action_issue_number="${issue_number}" action_run_id="${__run_id}" action_issue_title="${issue_title}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    commit_push_gate [shape="diamond" label="Commit succeeded?"]
    complexity_gate [shape="diamond" label="Complexity class route"]
    decide [shape="diamond" label="Review approved?"]
    decide_existing_reuse [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.decide_existing_reuse_with_notes" label="Decide existing-commit reuse" output_format="json" outputs="reuse_existing_commits,review_notes" action_issue_number="${issue_number}" action_branch="${branch}" action_existing_commits="${existing_commits}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    done [shape="Msquare" label="Done" recovery_sink_type="terminal"]
    emit_review_verdict_telemetry [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.emit_review_verdict_telemetry" label="Emit review verdict telemetry" output_key="review_verdict_telemetry_emitted" action_issue_number="${issue_number}" action_factory_id="${factory_id}" action_run_id="${__run_id}" action_max_review_attempts="${max_review_attempts}" action_milestone="${goal_issue_number}" action_retry_attempt="${review_attempt}" action_verdict="${verdict}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    encode_builder_output [type="tool" governance="reversible" action_runtime="in_process" action_id="common.encode_base64" label="Encode optional builder handoff" output_key="builder_output_b64" action_value="${builder_output}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    enforce_visual_refinement_evidence [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.verify_visual_refinement_evidence" label="Enforce visual-refinement review evidence" output_format="json" outputs="visual_refinement_gate_pass,visual_refinement_gate_code,visual_refinement_required,visual_refinement_missing,visual_refinement_notes,visual_refinement_scenario_root" action_repo="${gh_repo}" action_issue_number="${issue_number}" action_factory_root="factories/mothership" action_review_context_gate_code="${review_context_gate_code}" action_review_context_gate_pass="${review_context_gate_pass}" action_review_context_path="${review_context_path}" action_review_evidence_path="${review_evidence_path}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    ensure_toolchain [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.ensure_worktree_toolchain" label="Ensure worktree toolchain access" output_format="json" outputs="linked,reason" action_repo="${repo}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    estimate_complexity [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.estimate_issue_complexity" label="Estimate issue complexity class" output_key="complexity_estimate" output_format="json" outputs="complexity_class,complexity_signals,complexity_reason,complexity_otel_key" action_issue_body="${issue_body}" action_issue_title="${issue_title}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    existing_gate [shape="diamond" label="Reuse existing commits?"]
    fetch_goal_issue [type="tool" governance="reversible" action_runtime="in_process" action_id="goal.fetch_goal_issue" label="Fetch goal issue context" output_key="goal_issue" action_repo="${gh_repo}" action_goal_number="${goal_issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    fetch_issue [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.fetch_issue_body" label="Fetch issue body" output_key="issue_body" action_repo="${gh_repo}" action_issue_number="${issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    init [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.init_wave_issue_worktree" label="Init worktree" output_key="worktree_info" output_format="json" outputs="branch,worktree_dir,legacy_worktree_dir,agent_session_id" action_repo="${repo}" action_issue_number="${issue_number}" action_agent_session_id="${agent_session_id}" action_branch="${branch}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    inspect_changes [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.inspect_branch_changes" label="Inspect branch changes" output_format="json" outputs="commits_ahead,changed_files,latest_issue_change_summary" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    inspect_existing [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.inspect_existing_commits" label="Inspect existing branch state" output_format="json" outputs="existing_commits" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_agent_guidance_context [type="tool" governance="reversible" action_runtime="in_process" action_id="common.load_agent_guidance_context" label="Load AGENTS/AGENT-LEARNINGS context" output_format="json" outputs="agents_path,agents_found,agents_excerpt,agent_learnings_path,agent_learnings_found,agent_learnings_excerpt,agent_learnings_entry_count" action_repo_root="${repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_intent_stack [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_intent_stack" label="Load intent stack" output_key="intent_stack" action_factory_root="factories/mothership" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    mode_gate [shape="diamond" label="Smoke mode?"]
    report_approved [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.build_approved_result" label="Report approved result (merge deferred to goal end)" output_key="impl_result" action_issue_number="${issue_number}" recovery_owner="supervisor" action_branch="${branch}" action_max_review_attempts="${max_review_attempts}" action_review_attempt="${review_attempt}" action_review_evidence_path="${review_evidence_path}" action_review_notes="${review_notes}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    report_build_failed [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.build_failed_result" label="Report build system failure" output_key="impl_result" action_issue_number="${issue_number}" recovery_owner="supervisor" action_branch="${branch}" action_max_review_attempts="${max_review_attempts}" action_review_attempt="${review_attempt}" action_review_evidence_path="${review_evidence_path}" action_review_notes="Implementation infrastructure failure before coding session startup." action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    report_retry_failed [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.build_failed_result" label="Report review retry exhaustion" output_key="impl_result" action_issue_number="${issue_number}" recovery_owner="supervisor" action_branch="${branch}" action_max_review_attempts="${max_review_attempts}" action_review_attempt="${review_attempt}" action_review_evidence_path="${review_evidence_path}" action_review_notes="Review rejected the issue through the full retry budget." action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    report_setup_failed [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.build_infra_failure_result" label="Report worktree setup failure" output_key="impl_result" action_issue_number="${issue_number}" recovery_owner="supervisor" action_branch="${branch}" action_reason="${reason}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    reset_stale_branch [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.reset_stale_branch" label="Reset stale branch (wrong-scope commits)" output_format="json" outputs="reset,prior_commits" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    resolve_mode [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.resolve_execution_mode" label="Resolve execution mode (full|smoke; non-smoke follows full path)" output_key="execution_mode" action_mode="${execution_mode}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    resolve_review_route [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.resolve_review_route" label="Resolve deterministic review route" output_format="json" outputs="disposition,confidence,recommended_transition,reason_codes,notes,route_reason,verdict" recovery_owner="supervisor" action_review_context_error="${review_context_error}" action_review_context_gate_code="${review_context_gate_code}" action_review_context_gate_pass="${review_context_gate_pass}" action_review_context_path="${review_context_path}" action_verdict="${verdict}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    retry_gate [shape="diamond" label="Retry issue implementation?"]
    review [class="reviewer" benchmark_job_id="goal.execute.issue.review" llm_path_id="mothership.goal_issue_execute.review" prompt_version="2026-03-09.r1" role_version="1.0.0" skill_id="goal.execute.issue" label="Code review" prompt="You are the semantic code reviewer for issue completion in this goal. Your job is to decide whether issue #${issue_number} is actually complete and correct against the issue contract, the parent goal intent, the platform/factory intent, and the current codebase.\n\nLoad the local code review skill by reading BOTH:\n- ${capability_coding_skills}/code_review/SKILL.md\n- ${capability_coding_skills}/code_review/REPO.md\n\nFollow both, with REPO.md taking precedence for repo-specific policy.\n\n## Context packet (must use all of it)\n- Intent stack JSON:\n${intent_stack}\n- Parent goal issue number: ${goal_issue_number}\n- Parent goal issue JSON:\n${goal_issue}\n- Current issue number: ${issue_number}\n- Current issue title: ${issue_title}\n- Current issue body:\n${issue_body}\n- Current goal: #${goal_issue_number}\n- Worktree path: ${worktree_dir}\n- Branch: ${branch}\n- Evidence artifact path: ${review_evidence_path}\n- Reviewer context artifact path: ${review_context_path}\n- Reviewer context hash (sha256): ${review_context_sha256}\n- Builder notes (optional): ${builder_notes}\n- Commits ahead: ${commits_ahead}\n- Full branch changed files (includes all issues on this shared goal branch — do NOT use as the judge scope): ${changed_files}\n- Issue-scoped changed files (only files changed by THIS issue #${issue_number}, excludes sibling goal work — use this as your judge scope): ${issue_changed_files}\n- Latest issue change summary: ${latest_issue_change_summary}\n\nIMPORTANT: Judge the implementation against issue_changed_files only. Do not penalize or request revision for work in changed_files that does not appear in issue_changed_files — that work belongs to other issues on this shared branch.\n\nTreat the reviewer context artifact as the canonical, versioned contract. Require schema_version=reviewer_context/v1 and deterministic policy resolution metadata (`policy_sources`, `effective_policy`) with global policy loaded first and repo policy loaded second (repo overrides key conflicts). If the reviewer context artifact is missing/malformed, policy metadata is missing, or required keys are missing, return a code-review verdict envelope with disposition=reject, recommended_transition=revise, and REVIEW_CONTEXT_INVALID in reason_codes.\n\nRequired review flow:\n1. Restate the promised change in precise terms from the goal and issue. Derive what counts as done, what is out of scope, and what acceptance evidence is required.\n2. Inspect the actual issue-scoped change, not just the builder narrative. Treat latest_issue_change_summary as an untrusted hint, not ground truth.\n3. Inspect the touched files and the surrounding callsites, contracts, interfaces, and wiring needed to prove the behavior is reachable and correctly integrated.\n4. Use review evidence, tests, and local repo state to judge whether the issue contract is actually satisfied. Do not approve partial wiring, dead code, or unproven claims.\n5. Apply platform and factory intent as a semantic quality bar: prefer real shipped completion over ceremony, partial enablement, or unresolved coordination work.\n6. Approve only if the issue is truly complete. Otherwise return concrete, issue-scoped revision findings.\n\nIf anything is ambiguous, underspecified, or inconsistent, actively inspect first-party context before deciding:\n- Run gh issue view ${issue_number} --repo ${gh_repo} --json number,title,body,labels\n- Run gh issue view ${goal_issue_number} --repo ${gh_repo} --json number,title,body,labels\n- Inspect the local repo at ${worktree_dir}, focusing on issue-scoped files, evidence-scoped diffs, and surrounding callsites/interfaces.\n\nPolicy override: if `effective_policy.values.review.route_override` resolves to `revise`, return disposition=reject with recommended_transition=revise even when findings are otherwise clean.\n\nCode review is not QA. Do not turn this into a generic QA executor and do not rerun the entire pre-commit/build suite by default. But you must still judge whether the claimed acceptance criteria are actually evidenced by the code, tests, and integration points present. Require additional QA/test execution only when the issue contract explicitly calls for it or when the existing evidence is insufficient to prove correctness.\n\nIf revising, provide issue-scoped actionable guidance: point to concrete files/functions/tests or missing wiring, explain what is incomplete or incorrect relative to the issue/goal contract, and state what must change to earn approval.\n\nReturn JSON with:\n{\n  \"schema\": \"verdict/v1\",\n  \"verdict_kind\": \"code_review\",\n  \"disposition\": \"approve|reject\",\n  \"confidence\": \"high|medium|low\",\n  \"recommended_transition\": \"approved|revise\",\n  \"observation\": {\n    \"scope_status\": \"aligned|mismatch\",\n    \"evidence_status\": \"sufficient|insufficient\",\n    \"integration_status\": \"proven|unproven\"\n  },\n  \"recommendation\": {\n    \"action\": \"report_approved|revise_issue\",\n    \"fixes\": [\"Actionable revision guidance when rejecting\"]\n  },\n  \"reason_codes\": [\"APPROVED|EVIDENCE_MISSING|REVIEW_CONTEXT_INVALID|SCOPE_MISMATCH|TESTS_MISSING|LOGIC_INCORRECT|SECURITY_CONCERN|REVIEW_OUTPUT_SCHEMA_INVALID\"],\n  \"notes\": \"Actionable feedback for revisions\"\n}\n\nRules:\n- reason_codes must be a non-empty array of canonical codes from the list above.\n- If disposition=approve, recommended_transition must be approved and reason_codes must be exactly [\"APPROVED\"].\n- If disposition=reject, recommended_transition must be revise and APPROVED must not appear in reason_codes.\n\nReturn JSON only." max_retries="1" session_id="${reviewer_session_id}"]
    review_context_gate [shape="diamond" label="Reviewer context completeness passed?"]
    revise_attempt [type="tool" governance="reversible" label="Record revise attempt" prompt=":" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    route_default_complexity [type="tool" governance="reversible" label="Route default complexity path (low|unknown|unexpected)" prompt=":" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    route_high_complexity [type="tool" governance="reversible" label="Route high-complexity issue" prompt=":" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    route_medium_complexity [type="tool" governance="reversible" label="Route medium-complexity issue" prompt=":" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    route_non_high_complexity [type="tool" governance="reversible" label="Route non-high complexity issue" prompt=":" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    send_review_message [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.send_review_message" label="Send review feedback directly to coding agent" output_key="review_message_result" action_issue_number="${issue_number}" action_agent_session_id="${agent_session_id}" action_issue_title="${issue_title}" action_verdict="${verdict}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_issue_context [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.set_issue_context" label="Set issue context from parent" output_format="json" outputs="issue_number,issue_title" action_issue_number="${next_issue_number}" action_issue_title="${next_issue_title}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_max_review_attempts [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.resolve_max_review_attempts" label="Resolve max review attempts and init counter" output_format="json" outputs="max_review_attempts,review_attempt" action_max_review_attempts="${max_review_attempts}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    setup [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.setup_wave_issue_worktree" label="Setup worktree" output_format="json" outputs="setup,reason" action_repo="${repo}" action_branch="${branch}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    setup_gate [shape="diamond" label="Worktree ready?"]
    should_retry_review [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.should_retry_review" label="Should retry review?" output_key="retry_review" action_attempt="${review_attempt}" action_max_attempts="${max_review_attempts}" action_review_verdict="${disposition}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    smoke_skip [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.build_impl_result" label="Smoke-mode skip" output_key="impl_result" action_issue_number="${issue_number}" action_branch="${branch}" action_review_evidence_path="${review_evidence_path}" action_review_failed="true" action_review_notes="Smoke mode: skipped implementation agent for deterministic validation only." action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    snapshot_head [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.snapshot_branch_head" label="Snapshot branch HEAD before build" output_format="json" outputs="snapshot_sha" recovery_owner="supervisor" action_existing_snapshot="${snapshot_sha}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    start [shape="Mdiamond" label="Start"]
    validate_review_context [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.validate_review_context" label="Validate reviewer context completeness" output_format="json" outputs="review_context_gate_pass,review_context_gate_code,review_context_error,disposition,confidence,recommended_transition,reason_codes,notes,verdict" action_review_context_error="${review_context_error}" action_review_context_path="${review_context_path}" action_review_context_sha256="${review_context_sha256}" action_review_context_valid="${review_context_valid}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    visual_refinement_gate [shape="diamond" label="Visual-refinement evidence passed?"]
    write_review_evidence [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.write_review_evidence" label="Write review evidence artifact" output_format="json" outputs="review_evidence_path,builder_notes,issue_changed_files" action_repo="${repo}" action_issue_number="${issue_number}" action_branch="${branch}" action_builder_notes_b64="${builder_output_b64}" action_integration_command="${integration_command}" action_review_qa_command="${review_qa_command}" action_snapshot_sha="${snapshot_sha}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    init -> cleanup_legacy -> setup -> setup_gate
    report_build_failed -> done
    report_retry_failed -> done
    resolve_mode -> mode_gate
    resolve_review_route -> emit_review_verdict_telemetry -> decide
    set_max_review_attempts -> snapshot_head
    snapshot_head -> build
    start -> set_issue_context -> fetch_issue -> fetch_goal_issue -> load_intent_stack -> load_agent_guidance_context -> estimate_complexity -> complexity_gate
    approve_attempt -> bump_approve
    assert_main_after_build -> commit_push [condition="ok=true"]
    assert_main_after_build -> report_build_failed [condition="ok!=true"]
    build_review_context -> validate_review_context
    build -> assert_main_after_build [condition="outcome=success"]
    build -> report_build_failed [condition="outcome!=success"]
    bump_approve -> report_approved
    bump_revise -> should_retry_review
    commit_push_gate -> inspect_changes [condition="ok=true"]
    commit_push_gate -> report_build_failed [condition="ok!=true"]
    commit_push -> commit_push_gate
    complexity_gate -> route_high_complexity [condition="complexity_class=high"]
    complexity_gate -> route_non_high_complexity [condition="complexity_class!=high"]
    decide_existing_reuse -> existing_gate
    decide -> approve_attempt [condition="disposition=approve"]
    decide -> revise_attempt [condition="disposition!=approve"]
    encode_builder_output -> write_review_evidence
    enforce_visual_refinement_evidence -> visual_refinement_gate
    ensure_toolchain -> inspect_existing
    existing_gate -> reset_stale_branch [condition="reuse_existing_commits=reset"]
    existing_gate -> resolve_mode [condition="reuse_existing_commits=false"]
    existing_gate -> set_max_review_attempts [condition="reuse_existing_commits=true"]
    inspect_changes -> encode_builder_output
    inspect_existing -> decide_existing_reuse
    mode_gate -> set_max_review_attempts [condition="execution_mode!=smoke"]
    mode_gate -> smoke_skip [condition="execution_mode=smoke"]
    report_approved -> done
    report_setup_failed -> done
    reset_stale_branch -> resolve_mode
    retry_gate -> report_retry_failed [condition="retry_review!=true"]
    retry_gate -> snapshot_head [condition="retry_review=true"]
    review_context_gate -> enforce_visual_refinement_evidence [condition="review_context_gate_pass=true"]
    review_context_gate -> resolve_review_route [condition="review_context_gate_pass!=true"]
    review -> resolve_review_route
    revise_attempt -> send_review_message
    route_default_complexity -> init
    route_high_complexity -> init
    route_medium_complexity -> init
    route_non_high_complexity -> route_default_complexity [condition="complexity_class!=medium"]
    route_non_high_complexity -> route_medium_complexity [condition="complexity_class=medium"]
    send_review_message -> bump_revise
    setup_gate -> ensure_toolchain [condition="setup=true"]
    setup_gate -> report_setup_failed [condition="setup!=true"]
    should_retry_review -> retry_gate
    smoke_skip -> done
    validate_review_context -> review_context_gate
    visual_refinement_gate -> report_retry_failed [condition="visual_refinement_gate_pass!=true"]
    visual_refinement_gate -> review [condition="visual_refinement_gate_pass=true"]
    write_review_evidence -> build_review_context
}
