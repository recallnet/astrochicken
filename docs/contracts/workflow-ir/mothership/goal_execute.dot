@import "../../../../factories/mothership/roles.stylesheet"

digraph goal_execute {
    label = "goal_execute"
    workflow_source = "factories/mothership/workflows/goal-execution/goal_execute.workflow-source.mjs"
    typed_action_transport_mode = "enforced"
