    assert_main_branch [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.assert_main_branch" label="Assert main branch at pipeline start" output_format="json" outputs="corrected" action_repo="${repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_approved_features [type="tool" governance="reversible" label="Build approved features from merged results" output_key="approved_features" prompt="# hatch:no-inline-script-ok\nprintf '%s' \"${merged_results}\"" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_conflict_packet [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.build_conflict_packet" label="Build conflict packet" output_format="json" outputs="conflict_packet_path,conflict_packet_id,conflict_packet_schema_version,conflict_packet_storage_class" action_repo="${repo}" action_issue_number="${goal_issue_number}" action_factory_id="${factory_id}" action_run_id="${__run_id}" action_pipeline="goal_execute" action_node_id="build_conflict_packet" action_branch="${branch}" action_control_plane_repo="${control_plane_repo}" action_merge_candidates="${merge_candidates}" action_merge_stderr="${rebase_stderr}" action_target_repo="${gh_repo}" action_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_execution_plan [type="tool" governance="reversible" action_runtime="in_process" action_id="software.build_goal_execution_plan" label="Build toposort execution plan from blocked_by graph" output_format="json" outputs="execution_plan,total,planned,cycle_blocked,quarantined,direct_execution,plan_type" action_repo="${gh_repo}" action_goal_routing_state="${goal_routing_state}" action_completed_issues="${completed_issues}" action_direct_execution="${goal_execution_mode}" action_direct_execution_path="${goal_execution_path}" action_goal_execution_path_packet_id="${goal_execution_path_packet_id}" action_goal_execution_path_version="${goal_execution_path_version}" action_goal_number="${goal_issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_judge_context [type="tool" governance="irreversible" action_runtime="in_process" action_id="judge.build_context_contract" label="Build pre-merge judge context contract" output_format="json" outputs="judge_context_path,judge_context_sha256,judge_context_valid,judge_context_error,judge_scenario_selection_path,judge_scenario_selection_sha256,judge_scenario_selection_signature_sha256" action_gh_repo="recallnet/astrochicken" action_goal_number="${goal_issue_number}" action_judge_context_b64="${merge_candidates_b64}" action_judge_context_raw="${merge_candidates}" action_judge_context_scope_identity="goal_execute" action_judge_evidence_path="${judge_evidence_path}" action_judge_evidence_sha256="${judge_evidence_sha256}" action_judge_kind="goal_execution_post_merge" action_judge_rubric="alignment.default" action_objective_id="post_merge_alignment" action_scenario_context="post-merge" action_scenario_registry_root="${scenarios_root}" action_scenario_selector="astrochicken" action_scope="judge" action_subject_id="goal-${goal_issue_number}" action_worktree_dir="${repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_judge_context_recovery_packet [type="tool" governance="irreversible" action_runtime="in_process" action_id="judge.build_recovery_packet" label="Build judge context recovery packet" output_format="json" outputs="judge_context_recovery_packet_path,judge_context_recovery_packet_id,judge_context_recovery_packet_schema_version,judge_context_recovery_packet_storage_class,judge_context_recovery_packet_type" action_repo="${repo}" action_factory_id="${factory_id}" action_run_id="${__run_id}" action_pipeline="goal_execute" action_node_id="build_judge_context_recovery_packet" recovery_owner="supervisor" action_branch="${branch}" action_control_plane_repo="${control_plane_repo}" action_error_text="${judge_context_error}" action_gate_code="${judge_context_gate_code}" action_judge_context_path="${judge_context_path}" action_judge_context_scope_identity="goal_execute" action_judge_evidence_path="${judge_evidence_path}" action_judge_kind="goal_execution_post_merge" action_milestone_title="${goal_issue_number}" action_packet_type="judge_context_contract_recovery" action_ready_issue_number="${goal_issue_number}" action_route_code="${judge_route_code}" action_scenario_registry_root="${scenarios_root}" action_target_repo="${gh_repo}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_judge_evidence [type="tool" governance="irreversible" action_runtime="in_process" action_id="judge.build_evidence_contract" label="Build pre-merge judge evidence contract" output_format="json" outputs="judge_evidence_path,judge_evidence_sha256,judge_evidence_valid,judge_evidence_error" action_judge_context_b64="${merge_candidates_b64}" action_judge_context_raw="${merge_candidates}" action_judge_kind="goal_execution_post_merge" action_require_qa_markers="true" action_subject_id="goal-${goal_issue_number}" action_worktree_dir="${repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_judge_evidence_recovery_packet [type="tool" governance="irreversible" action_runtime="in_process" action_id="judge.build_recovery_packet" label="Build judge evidence recovery packet" output_format="json" outputs="judge_evidence_recovery_packet_path,judge_evidence_recovery_packet_id,judge_evidence_recovery_packet_schema_version,judge_evidence_recovery_packet_storage_class,judge_evidence_recovery_packet_type" action_repo="${repo}" action_factory_id="${factory_id}" action_run_id="${__run_id}" action_pipeline="goal_execute" action_node_id="build_judge_evidence_recovery_packet" recovery_owner="supervisor" action_branch="${branch}" action_control_plane_repo="${control_plane_repo}" action_error_text="${judge_evidence_error}" action_gate_code="${judge_evidence_gate_code}" action_judge_context_path="${judge_context_path}" action_judge_context_scope_identity="goal_execute" action_judge_evidence_path="${judge_evidence_path}" action_judge_kind="goal_execution_post_merge" action_milestone_title="${goal_issue_number}" action_packet_type="judge_evidence_contract_recovery" action_ready_issue_number="${goal_issue_number}" action_route_code="${judge_route_code}" action_scenario_registry_root="${scenarios_root}" action_target_repo="${gh_repo}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_merge_commit_message [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.build_commit_message" label="Build goal-scoped merge commit message" output_format="json" outputs="merge_commit_message" action_goal_issue_number="${goal_issue_number}" action_merge_candidates_raw="${merge_candidates}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_merged_results [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.build_goal_merge_results" label="Build goal merge results" output_format="json" outputs="merged_results,merge_failures,merged_count,failed_count" action_merge_candidates="${merge_candidates}" action_merge_notes="${merge_stderr} ${resolution_notes}" action_merge_resolver="${resolution_source}" action_merge_status="${goal_merge_status}" action_path_taken="merge" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_post_merge_packet [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.build_conflict_packet" label="Build post-merge conflict packet" output_format="json" outputs="conflict_packet_path,conflict_packet_id,conflict_packet_schema_version,conflict_packet_storage_class" action_repo="${repo}" action_issue_number="${goal_issue_number}" action_factory_id="${factory_id}" action_run_id="${__run_id}" action_pipeline="goal_execute" action_node_id="build_post_merge_packet" action_branch="${branch}" action_control_plane_repo="${control_plane_repo}" action_merge_stderr="${merge_stderr}" action_target_repo="${gh_repo}" action_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_push_failure_packet [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.build_conflict_packet" label="Build push failure packet" output_format="json" outputs="push_failure_packet_path,push_failure_packet_id,push_failure_packet_schema_version,push_failure_packet_storage_class" action_repo="${repo}" action_issue_number="${goal_issue_number}" action_factory_id="${factory_id}" action_run_id="${__run_id}" action_pipeline="goal_execute" action_node_id="build_push_failure_packet" action_branch="main" action_control_plane_repo="${control_plane_repo}" action_merge_stderr="${push_stderr}" action_target_repo="${gh_repo}" action_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    check_main_clean [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.assert_main_clean" label="Assert canonical checkout is clean" output_format="json" outputs="clean,branch,untracked_count,modified_count,partial_state" action_repo="${repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    check_merge_candidates [type="tool" governance="reversible" action_runtime="in_process" action_id="software.check_merge_candidates" label="Check merge candidates" output_format="json" outputs="has_merge_candidates,merge_candidate_count" action_merge_candidates="${merge_candidates}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    clean_main [class="merge_resolver" benchmark_job_id="goal.execute.merge.clean_main" llm_path_id="mothership.goal_execute.clean_main" prompt_version="2026-03-19.r1" role_version="1.0.0" skill_id="goal.execute.merge.clean_main" label="LLM: repair post-merge main" reasoning_effort="medium" timeout="60m" prompt="You own both git-state cleanup after merge/rebase interruptions and post-merge code/config repairs when the merged result is genuinely broken.\n\nCurrent state:\n- Current branch: ${branch}\n- Untracked files: ${untracked_count}\n- Modified files: ${modified_count}\n- Partial git state: ${partial_state}\n\nGet main back to main if needed, get the worktree work merged/rebased into canonical main, then run pnpm test:strict. If the merged code is broken, fix it directly on main — missing deps, broken imports, config mismatches, test drift, integration defects.\n\nLeave main clean, green, and committed. Commit any repair with: fix(merge): repair post-merge main after goal-${goal_issue_number}\n\nDo NOT delete legitimate source code, rewrite history, discard merged work, or introduce unrelated refactors." recovery_owner="supervisor" session_id="goal-${goal_issue_number}" system_prompt_source="merge_resolver_system_prompt" workdir="${repo}"]
    cleanup_failed_merge [type="tool" governance="irreversible" label="Cleanup failed merge state" output_key="__cleanup_failed_merge_result" prompt="# hatch:no-inline-script-ok\ngit -C \"${merge_worktree_dir}\" merge --abort >/dev/null 2>&1 || true\ngit -C \"${merge_worktree_dir}\" rebase --abort >/dev/null 2>&1 || true" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    cleanup_goal_worktree [type="tool" governance="irreversible" action_runtime="in_process" action_id="coding.cleanup_wave_issue_worktree" label="Cleanup goal worktree" output_key="__cleanup_goal_worktree_result" action_repo="${repo}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    cleanup_merge_worktree [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.cleanup_worktree" label="Cleanup merge worktree" output_key="__cleanup_merge_worktree_result" action_repo="${repo}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    close_merged_issues [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.close_merged_issues" label="Close all merged goal sub-issues" output_format="json" outputs="closed_count,failed_count" action_repo="${gh_repo}" action_run_id="${__run_id}" action_merge_candidates="${merge_candidates}" action_milestone_title="${goal_issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    consecutive_fail_gate [shape="diamond" label="Too many consecutive failures?" recovery_owner="supervisor"]
    done [shape="Msquare" label="Done" recovery_sink_type="terminal"]
    emit_dirty_main_artifact [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.emit_resolution_failure" label="Emit dirty-main supervisor artifact" output_key="__dirty_main_artifact" action_issue_number="${goal_issue_number}" action_factory_id="${factory_id}" action_run_id="${__run_id}" action_branch="main" action_recurrence_key="goal_execute::dirty_main_after_merge" action_resolution_check="failed" action_resolution_notes="Main checkout dirty after 3 LLM clean attempts. untracked=${untracked_count} modified=${modified_count} partial_state=${partial_state}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    emit_resolution_failure [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.emit_resolution_failure" label="Emit resolution failure telemetry" output_key="resolution_failure_event" action_issue_number="${goal_issue_number}" action_factory_id="${factory_id}" action_run_id="${__run_id}" action_branch="${branch}" action_recurrence_key="goal_execute::merge_conflict_llm_resolution" action_resolution_check="${resolution_check}" action_resolution_notes="${resolution_notes}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    encode_merge_candidates_b64 [type="tool" governance="reversible" action_runtime="in_process" action_id="common.encode_base64" label="Encode merge candidates payload (base64)" output_key="merge_candidates_b64" action_raw="${merge_candidates}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    ensure_judge_decision [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.fallback_judge" label="Normalize judge decision with deterministic fallback" output_key="judge_result" output_format="json" outputs="disposition,confidence,recommended_transition,reason_codes,notes,verdict" action_error="llm_judge_unavailable" action_verdict="${verdict}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    execute_issue [type="pipeline" label="Execute issue in goal branch" pipeline="factories/mothership/workflows/goal-execution/goal_issue_execute.workflow-source.mjs" export_keys="impl_result" fail_open="true" inherit_context="true" trust_domain="mothership.local" trust_role="mothership.local.pipeline"]
    final_state_review [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.reconcile_goal_final_state" label="Reconcile final goal state" output_key="__final_state_review_result" action_repo="${gh_repo}" action_run_id="${__run_id}" action_direct_goal_outcome_notes="${goal_merge_status}" action_direct_goal_result="${goal_merge_status}" action_goal_number="${goal_issue_number}" action_mode="${goal_execution_mode}" trust_domain="mothership.local" trust_role="mothership.local.tool" action_runs_dir="${runs_dir}"]
    final_state_review_no_merge [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.reconcile_goal_final_state" label="Reconcile direct no-merge final goal state" output_key="__final_state_review_no_merge_result" action_repo="${gh_repo}" action_run_id="${__run_id}" action_direct_goal_outcome_notes="no_merge" action_direct_goal_result="no_merge" action_goal_number="${goal_issue_number}" action_mode="${goal_execution_mode}" trust_domain="mothership.local" trust_role="mothership.local.tool" action_runs_dir="${runs_dir}"]
    finalize_gate [shape="diamond" label="Finalize status"]
    finalize_merge_commit [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.finalize_commit" label="Finalize merge commit if pending" output_format="json" outputs="finalize_status,finalize_reason,finalize_detail" action_repo="${repo}" action_commit_message="${merge_commit_message}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    finalize_post_merge_commit [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.finalize_commit" label="Finalize post-merge commit if pending" output_format="json" outputs="finalize_status,finalize_reason,finalize_detail" action_repo="${repo}" action_commit_message="${merge_commit_message}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    finalize_post_merge_gate [shape="diamond" label="Post-merge finalize status"]
    handle_merge_failures [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.handle_goal_merge_failures" label="Comment merge failures" output_key="__handle_merge_failures_result" action_repo="${gh_repo}" action_run_id="${__run_id}" action_pipeline="goal_execute" action_merge_failures="${merge_failures}" action_milestone_title="${goal_issue_number}" action_ready_issue_number="${goal_issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    handle_review_failures [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.handle_goal_review_failures" label="Comment review failures" output_key="__handle_review_failures_result" action_repo="${gh_repo}" action_run_id="${__run_id}" action_pipeline="goal_execute" action_cooldown_hours="${review_cooldown_hours}" action_quarantine_threshold="${review_quarantine_threshold}" action_review_failures="${review_failures}" fail_open="true" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    init_branch [type="tool" governance="reversible" action_runtime="in_process" action_id="software.empty_goal_branch_context" label="Init goal-scoped branch context" output_format="json" outputs="branch,worktree_dir,agent_session_id,reviewer_session_id,goal_sessions_dir" action_goal_number="${goal_issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    issue_loop_gate [shape="diamond" label="Next issue?"]
    judge [class="post_merge_judge" benchmark_job_id="goal.execute.merge.judge" llm_path_id="mothership.goal_execute.post_merge_judge" prompt_version="2026-03-09.r1" role_version="1.0.0" skill_id="goal.execute.post_merge_judge" label="Post-merge judge" outputs="disposition,confidence,recommended_transition,reason_codes,notes,verdict" prompt="You are the post-merge judge for ${gh_repo}.\n\nSurvey the existing scenario registry and use zero, one, or at most two scenarios only when they materially sharpen judgment for this merged goal. Scenarios are optional and sparse; do not force them.\nTreat scenarios as high-value judgment aids, not exhaustive checklists.\nDo NOT reveal or quote any scenario. Provide a redacted verdict envelope.\n\nMerge metadata:\n${merged_results}\n\nImplementation results (per-issue review status and evidence):\n${impl_results}\n\nMerge diff summary:\n${merge_stdout}\n\nReturn JSON:\n{\n  \"schema\": \"verdict/v1\",\n  \"verdict_kind\": \"post_merge_judge\",\n  \"disposition\": \"approve|reject|defer|escalate\",\n  \"confidence\": \"high|medium|low\",\n  \"recommended_transition\": \"close_goal|open_followup|request_more_evidence|escalate_contract\",\n  \"observation\": {\n    \"alignment_score\": 0.0,\n    \"constraint_violations\": [],\n    \"missing_evidence\": []\n  },\n  \"recommendation\": {\n    \"action\": \"close_goal|open_followup|request_more_evidence|escalate_contract\",\n    \"next_steps\": [\"Redacted feedback or confirmation\"]\n  },\n  \"reason_codes\": [\"POST_MERGE_ALIGNED|POST_MERGE_MISALIGNED|POST_MERGE_EVIDENCE_GAP|POST_MERGE_CONTRACT_INVALID\"],\n  \"notes\": \"Concise human-readable rationale\"\n}\n\nRules:\n- If disposition=approve, recommended_transition must be close_goal.\n- If disposition=reject, recommended_transition must be open_followup.\n- If disposition=defer, recommended_transition must be request_more_evidence.\n- If disposition=escalate, recommended_transition must be escalate_contract.\n- reason_codes must be non-empty.\nReturn JSON only." scenarios="astrochicken"]
    judge_context_gate [shape="diamond" label="Judge context complete?"]
    judge_evidence_gate [shape="diamond" label="Judge evidence complete?"]
    judge_pass_gate [shape="diamond" label="Judge pass?"]
    load_merge_finalize_retry_task_prompt [type="tool" governance="reversible" label="Load merge finalize retry task prompt" output_key="merge_finalize_retry_task_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/retry_finalize_conflict.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_merge_post_merge_retry_task_prompt [type="tool" governance="reversible" label="Load post-merge retry task prompt" output_key="merge_post_merge_retry_task_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/retry_post_merge.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_merge_resolve_conflict_task_prompt [type="tool" governance="reversible" label="Load resolve-conflict task prompt" output_key="merge_resolve_conflict_task_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/resolve_conflict.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_merge_resolve_post_merge_task_prompt [type="tool" governance="reversible" label="Load post-merge task prompt" output_key="merge_resolve_post_merge_task_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/resolve_post_merge.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_merge_resolve_push_failure_task_prompt [type="tool" governance="reversible" label="Load push-failure task prompt" output_key="merge_resolve_push_failure_task_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/resolve_push_failure.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_merge_resolver_system_prompt [type="tool" governance="reversible" label="Load merge resolver system prompt" output_key="merge_resolver_system_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/system.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    main_clean_attempt_gate [shape="diamond" label="Clean attempts exhausted?"]
    main_clean_gate [shape="diamond" label="Is main clean?"]
    merge_branch [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.attempt_deterministic" label="Merge goal branch" output_format="json" outputs="merge_status,merge_stdout,merge_stderr,merge_worktree_dir,merge_branch_head_sha,merged_head_sha" action_repo="${repo}" action_branch="${branch}" action_branch_head_sha="${merge_branch_head_sha}" action_commit_message="${merge_commit_message}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    merge_candidates_gate [shape="diamond" label="Any merge candidates?"]
    merge_gate [shape="diamond" label="Merge status"]
    merged_results_gate [shape="diamond" label="Any merges?"]
    no_merge_exit [type="tool" governance="reversible" label="No merge candidates — exit" output_key="goal_terminal_path" prompt="printf 'no_merge'" recovery_sink_type="terminal" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    no_merge_finalizer_gate [shape="diamond" label="Direct no-merge finalization?"]
    pick_plan_issue [type="tool" governance="reversible" action_runtime="in_process" action_id="software.pick_goal_plan_issue" label="Pick next issue from execution plan" output_format="json" outputs="has_next,next_issue_number,next_issue_title,plan_index,remaining_count" action_execution_plan="${execution_plan}" action_plan_index="${plan_index}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    post_merge_resolution_gate [shape="diamond" label="Post-merge resolved?"]
    postmortem [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.goal_postmortem" label="Post-mortem: persist give-up incident packet and classify" output_key="__postmortem_result" action_repo="${gh_repo}" action_issue_number="${last_issue_number}" recovery_owner="supervisor" action_branch="${last_branch}" action_review_evidence_path="${last_review_evidence_path}" action_review_notes="${last_review_notes}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    postmortem_gate [shape="diamond" label="Issue failed?"]
    push_gate [shape="diamond" label="Push status"]
    push_main_branch [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.push_main_branch" label="Push local main to origin" output_format="json" outputs="push_status,push_stdout,push_stderr" action_repo="${repo}" action_branch="main" action_merge_worktree_dir="${merge_worktree_dir}" action_merged_head_sha="${merged_head_sha}" action_remote="origin" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    push_recovery_gate [shape="diamond" label="Push recovery verified?"]
    rebase_branch [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.rebase_on_main" label="Rebase goal branch on main" output_format="json" outputs="rebase_status,rebase_stdout,rebase_stderr,merge_worktree_dir,merge_branch_head_sha" action_repo="${repo}" action_branch="${branch}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    rebase_gate [shape="diamond" label="Rebase status"]
    recheck_main_clean [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.assert_main_clean" label="Re-check canonical checkout is clean" output_format="json" outputs="clean,branch,untracked_count,modified_count,partial_state" action_repo="${repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    recheck_main_clean_gate [shape="diamond" label="Is main clean now?"]
    release_merge_lock [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.release_lock" label="Release local merge lock" output_key="__release_merge_lock_result" action_repo="${repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    resolution_gate [shape="diamond" label="Conflict resolved?"]
    resolve_config [type="tool" governance="reversible" action_runtime="in_process" action_id="software.resolve_execution_config" label="Resolve execution config defaults" output_format="json" outputs="integration_command,review_qa_command,stale_run_minutes" action_integration_command="${integration_command}" action_review_qa_command="${review_qa_command}" action_stalled_wave_minutes="${stalled_wave_minutes}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    resolve_conflict [class="merge_resolver" benchmark_job_id="goal.execute.merge.resolve_conflict" llm_path_id="mothership.goal_execute.resolve_conflict" prompt_version="2026-03-12.r1" role_version="1.0.0" skill_id="goal.execute.merge" label="Resolve merge conflict" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nLoad and follow ${capability_merge_skills}/merge_conflict_resolver/SKILL.md.\n\n${merge_resolve_conflict_task_prompt}\n\nConflict packet: ${conflict_packet_path}" recovery_owner="supervisor" prompt_input_keys="capability_merge_skills,conflict_packet_path" prompt_source="merge_resolve_conflict_task_prompt" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_resolve_conflict_task_prompt" workdir="${merge_worktree_dir}"]
    resolve_execution_path [type="tool" governance="reversible" action_runtime="in_process" action_id="software.resolve_goal_execution_path" label="Resolve canonical goal execution-path metadata" output_format="json" outputs="goal_execution_path,goal_routing_state,goal_execution_path_version,classification_version,goal_execution_path_packet_id,goal_execution_path_packet_path" action_repo="${repo}" action_goal_issue_number="${goal_issue_number}" action_goal_execution_paths="${goal_execution_paths}" action_factory_id="${factory_id}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    resolve_merge_context [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.resolve_context" label="Resolve merge branch/worktree context" output_format="json" outputs="branch,worktree_dir" action_fallback_branch="${branch}" action_fallback_worktree_dir="${worktree_dir}" action_merge_candidates="${merge_candidates}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    resolve_post_merge [class="merge_resolver" benchmark_job_id="goal.execute.merge.resolve_post_merge" llm_path_id="mothership.goal_execute.resolve_post_merge" prompt_version="2026-03-09.r1" role_version="1.0.0" skill_id="goal.execute.merge" label="LLM: resolve post-merge failure" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nLoad and follow ${capability_merge_skills}/merge_conflict_resolver/SKILL.md.\n\nMerge stderr:\n${merge_stderr}\n\n${merge_resolve_post_merge_task_prompt}\n\nConflict packet: ${conflict_packet_path}" recovery_owner="supervisor" prompt_input_keys="capability_merge_skills,merge_stderr,conflict_packet_path" prompt_source="merge_resolve_post_merge_task_prompt" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_resolve_post_merge_task_prompt" workdir="${merge_worktree_dir}"]
    resolve_push_failure [class="merge_resolver" benchmark_job_id="goal.execute.merge.resolve_push_failure" llm_path_id="mothership.goal_execute.resolve_push_failure" prompt_version="2026-03-12.r1" role_version="1.0.0" skill_id="goal.execute.merge" label="LLM: resolve push failure" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nLoad and follow ${capability_merge_skills}/merge_conflict_resolver/SKILL.md.\n\nPush stderr:\n${push_stderr}\n\nPush failure packet: ${push_failure_packet_path}\n\n${merge_resolve_push_failure_task_prompt}" recovery_owner="supervisor" prompt_input_keys="capability_merge_skills,push_stderr,push_failure_packet_path" prompt_source="merge_resolve_push_failure_task_prompt" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_resolve_push_failure_task_prompt" workdir="${merge_worktree_dir}"]
    retry_push_gate [shape="diamond" label="Retry push status"]
    retry_push_main [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.push_main_branch" label="Retry push after LLM resolution" output_format="json" outputs="push_status,push_stdout,push_stderr" action_repo="${repo}" action_branch="main" action_merge_worktree_dir="${merge_worktree_dir}" action_merged_head_sha="${merged_head_sha}" action_remote="origin" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    retry_push_recovery_gate [shape="diamond" label="Retry push recovery verified?"]
    retry_resolve_conflict [class="merge_resolver" benchmark_job_id="goal.execute.merge.retry_resolve_conflict" llm_path_id="mothership.goal_execute.retry_resolve_conflict" prompt_version="2026-03-11.r1" role_version="1.0.0" skill_id="goal.execute.merge" label="LLM: fix merge finalization issue" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nProblem: ${finalize_reason}\nDetail: ${finalize_detail}\n\n${merge_finalize_retry_task_prompt}\n\nConflict packet (for reference): ${conflict_packet_path}" recovery_owner="supervisor" prompt_input_keys="finalize_reason,finalize_detail,conflict_packet_path" prompt_source="merge_finalize_retry_task_prompt" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_finalize_retry_task_prompt" workdir="${merge_worktree_dir}"]
    retry_resolve_post_merge [class="merge_resolver" benchmark_job_id="goal.execute.merge.retry_resolve_post_merge" llm_path_id="mothership.goal_execute.retry_resolve_post_merge" prompt_version="2026-03-11.r1" role_version="1.0.0" skill_id="goal.execute.merge" label="LLM: fix post-merge finalization issue" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nProblem: ${finalize_reason}\nDetail: ${finalize_detail}\n\n${merge_post_merge_retry_task_prompt}" recovery_owner="supervisor" prompt_input_keys="finalize_reason,finalize_detail" prompt_source="merge_post_merge_retry_task_prompt" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_post_merge_retry_task_prompt" workdir="${merge_worktree_dir}"]
    seed_state [type="tool" governance="reversible" action_runtime="in_process" action_id="software.seed_goal_state" label="Seed completed/processed from goal sub-issues" output_format="json" outputs="completed_issues,processed_issues,impl_results,plan_index" action_repo="${gh_repo}" action_goal_number="${goal_issue_number}" action_runs_dir="${runs_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_capability_coding_skills [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_capability_coding_skills_path" label="Resolve capability-coding skills path" output_key="capability_coding_skills" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_capability_merge_skills [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_capability_merge_skills_path" label="Resolve capability-merge skills path" output_key="capability_merge_skills" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_gh_repo [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_gh_repo" label="Resolve GitHub repo" output_key="gh_repo" action_gh_repo="${gh_repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_goal_already_merged [type="tool" governance="reversible" label="Set merge status: already merged" output_key="goal_merge_status" prompt="printf 'merged'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_goal_merge_failed [type="tool" governance="reversible" label="Set merge status: failed" output_key="goal_merge_status" prompt="printf 'failed'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_goal_merged [type="tool" governance="reversible" label="Set merge status: merged" output_key="goal_merge_status" prompt="printf 'merged'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_main_clean_attempt [type="tool" governance="reversible" label="Initialize clean attempt counter" output_key="main_clean_attempt" prompt="printf '1'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_repo [type="tool" governance="reversible" label="Set repo" output_key="repo" prompt="# hatch:no-inline-script-ok\ngit rev-parse --show-toplevel | tr -d '\n'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_resolution_source_deterministic [type="tool" governance="reversible" label="Set merge resolver: deterministic" output_key="resolution_source" prompt="printf 'deterministic'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_resolution_source_llm [type="tool" governance="reversible" label="Set merge resolver: llm" output_key="resolution_source" prompt="printf 'llm'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_scenarios_root [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Resolve scenarios root" output_key="scenarios_root" action_fallback="factories/mothership/scenarios" action_value="${scenarios_root}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    setup_merge_worktree [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.setup_worktree" label="Setup merge worktree" output_format="json" outputs="setup,reason,merge_worktree_dir,merge_base_ref,merge_branch_head_sha" action_repo="${repo}" action_issue_number="${goal_issue_number}" action_run_id="${__run_id}" action_pipeline="goal-execute" action_branch="${branch}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    split_results [type="tool" governance="reversible" action_runtime="in_process" action_id="software.split_goal_results" label="Filter review failures" output_format="json" outputs="merge_candidates,review_failures" recovery_owner="supervisor" action_fallback="${impl_results}" action_runs_dir="${runs_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    start [shape="Mdiamond" label="Start"]
    supervisor_push_recovery [class="supervisor" benchmark_job_id="goal.execute.merge.supervisor_push_recovery" llm_path_id="mothership.goal_execute.supervisor_push_recovery" prompt_version="2026-03-30.r1" role_version="1.0.0" skill_id="supervisor.review" label="Supervisor LLM: recover failed push" timeout="120m" prompt="You are the supervisor escalation for a goal merge push failure.\n\nGoal: #${goal_issue_number}\nRepo: ${gh_repo}\nProblem: ${resolution_notes}\nPush stderr:\n${push_stderr}\nPush failure packet: ${push_failure_packet_path}\n\nRequired outcome:\n- preserve the completed merge work\n- make canonical main and the merge worktree converge to a state where the deterministic push-recovery verifier passes\n- do not stop at 'ready to push'\n- do not discard completed work or close the goal if the merge has not landed\n\nLoad and follow ${capability_merge_skills}/merge_conflict_resolver/SKILL.md, then repair the state so the next deterministic retry push can succeed." recovery_owner="supervisor" prompt_input_keys="capability_merge_skills,resolution_notes,push_stderr,push_failure_packet_path" session_id="supervisor-${factory_id}" workdir="${repo}"]
    validate_judge_context [type="tool" governance="irreversible" action_runtime="in_process" action_id="judge.validate_context_contract" label="Validate pre-merge judge context contract" output_format="json" outputs="judge_context_gate_pass,judge_context_gate_code,judge_context_error,judge_context_path,judge_context_sha256,judge_scenario_selection_path,judge_scenario_selection_sha256,judge_scenario_selection_signature_sha256,judge_route_code,disposition,confidence,recommended_transition,reason_codes,notes,verdict" action_judge_context_b64="${merge_candidates_b64}" action_judge_context_error="${judge_context_error}" action_judge_context_path="${judge_context_path}" action_judge_context_raw="${merge_candidates}" action_judge_context_scope_identity="goal_execute" action_judge_context_sha256="${judge_context_sha256}" action_judge_context_valid="${judge_context_valid}" action_judge_evidence_path="${judge_evidence_path}" action_judge_evidence_sha256="${judge_evidence_sha256}" action_judge_kind="goal_execution_post_merge" action_judge_rubric="alignment.default" action_objective_id="post_merge_alignment" action_scenario_context="post-merge" action_scenario_registry_root="${scenarios_root}" action_scenario_selector="astrochicken" action_scope="judge" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    validate_judge_evidence [type="tool" governance="irreversible" action_runtime="in_process" action_id="judge.validate_evidence_contract" label="Validate pre-merge judge evidence contract" output_format="json" outputs="judge_evidence_gate_pass,judge_evidence_gate_code,judge_evidence_error,judge_route_code,disposition,confidence,recommended_transition,reason_codes,notes,verdict" action_judge_context_b64="${merge_candidates_b64}" action_judge_context_raw="${merge_candidates}" action_judge_evidence_error="${judge_evidence_error}" action_judge_evidence_path="${judge_evidence_path}" action_judge_evidence_sha256="${judge_evidence_sha256}" action_judge_evidence_valid="${judge_evidence_valid}" action_judge_kind="goal_execution_post_merge" action_require_qa_markers="true" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    verify_post_merge_resolution [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.verify_resolution" label="Verify post-merge resolution" output_format="json" outputs="resolution_status,resolution_notes" action_repo="${repo}" action_branch="${branch}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    verify_push_recovery [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.verify_push_recovery" label="Verify push recovery state" output_format="json" outputs="resolution_status,resolution_notes" action_repo="${repo}" action_branch="main" action_merge_worktree_dir="${merge_worktree_dir}" action_remote="origin" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    verify_resolution [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.verify_resolution" label="Verify conflict resolved" output_format="json" outputs="resolution_status,resolution_notes" action_repo="${repo}" action_branch="${branch}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    verify_retry_push_recovery [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.verify_push_recovery" label="Verify retried push recovery state" output_format="json" outputs="resolution_status,resolution_notes" action_repo="${repo}" action_branch="main" action_merge_worktree_dir="${merge_worktree_dir}" action_remote="origin" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    write_scenarios [type="pipeline" label="Write scenarios from merged features" output_format="json" outputs="scenario_paths" timeout="60m" prompt="factories/mothership/graphs/write_scenarios.dot" recovery_owner="supervisor" pipeline="factories/mothership/graphs/write_scenarios.dot" context_keys="scenarios_root,approved_features" trust_domain="mothership.local" trust_role="mothership.local.pipeline"]
    advance_plan_index -> pick_plan_issue
    build_merged_results -> handle_merge_failures -> merged_results_gate
    check_main_clean -> main_clean_gate
    clean_main -> recheck_main_clean -> recheck_main_clean_gate
    close_merged_issues -> check_main_clean
    merge_branch -> merge_gate
    no_merge_exit -> no_merge_finalizer_gate
    pick_plan_issue -> issue_loop_gate
    push_main_branch -> push_gate
    release_merge_lock -> assert_main_after_merge -> cleanup_merge_worktree -> cleanup_goal_worktree -> done
    retry_push_main -> retry_push_gate
    set_goal_merge_failed -> cleanup_failed_merge -> check_main_clean
    set_goal_merged -> push_main_branch
    split_results -> handle_review_failures -> check_merge_candidates -> merge_candidates_gate
    start -> set_repo -> assert_main_branch -> set_gh_repo -> resolve_config -> set_capability_coding_skills -> set_capability_merge_skills -> load_merge_resolver_system_prompt -> load_merge_resolve_conflict_task_prompt -> load_merge_finalize_retry_task_prompt -> load_merge_resolve_post_merge_task_prompt -> load_merge_post_merge_retry_task_prompt -> load_merge_resolve_push_failure_task_prompt -> seed_state -> resolve_execution_path -> build_execution_plan -> init_branch -> pick_plan_issue
    verify_post_merge_resolution -> post_merge_resolution_gate
    verify_resolution -> resolution_gate
    accumulate -> postmortem_gate
    acquire_merge_lock -> resolve_merge_context
    advance_clean_attempt -> main_clean_attempt_gate
    build_approved_features -> set_scenarios_root
    build_conflict_packet -> resolve_conflict
    build_judge_context_recovery_packet -> no_merge_exit
    build_judge_context -> validate_judge_context
    build_judge_evidence_recovery_packet -> no_merge_exit
    build_judge_evidence -> build_judge_context
    build_merge_commit_message -> acquire_merge_lock
    build_post_merge_packet -> resolve_post_merge
    build_push_failure_packet -> resolve_push_failure
    consecutive_fail_gate -> advance_plan_index [condition="consecutive_fail_count<2"]
    consecutive_fail_gate -> split_results [condition="consecutive_fail_count>=2"]
    emit_dirty_main_artifact -> build_merged_results
    emit_resolution_failure -> set_goal_merge_failed
    encode_merge_candidates_b64 -> build_judge_evidence
    ensure_judge_decision -> judge_pass_gate
    execute_issue -> accumulate
    final_state_review_no_merge -> release_merge_lock
    final_state_review -> build_approved_features
    finalize_gate -> retry_resolve_conflict [condition="finalize_status!=ok"]
    finalize_gate -> verify_resolution [condition="finalize_status=ok"]
    finalize_merge_commit -> finalize_gate
    finalize_post_merge_commit -> finalize_post_merge_gate
    finalize_post_merge_gate -> retry_resolve_post_merge [condition="finalize_status!=ok"]
    finalize_post_merge_gate -> verify_post_merge_resolution [condition="finalize_status=ok"]
    issue_loop_gate -> execute_issue [condition="has_next=true"]
    issue_loop_gate -> split_results [condition="has_next!=true"]
    judge_context_gate -> build_judge_context_recovery_packet [condition="judge_context_gate_pass!=true"]
    judge_context_gate -> validate_judge_evidence [condition="judge_context_gate_pass=true"]
    judge_evidence_gate -> build_judge_evidence_recovery_packet [condition="judge_evidence_gate_pass!=true"]
    judge_evidence_gate -> build_merge_commit_message [condition="judge_evidence_gate_pass=true"]
    judge_pass_gate -> final_state_review [condition="disposition=approve"]
    judge_pass_gate -> no_merge_exit [condition="disposition!=approve"]
    judge -> ensure_judge_decision
    main_clean_attempt_gate -> clean_main [condition="main_clean_attempt!=3"]
    main_clean_attempt_gate -> emit_dirty_main_artifact [condition="main_clean_attempt=3"]
    main_clean_gate -> build_merged_results [condition="clean=true"]
    main_clean_gate -> set_main_clean_attempt [condition="clean!=true"]
    merge_candidates_gate -> encode_merge_candidates_b64 [condition="has_merge_candidates=true"]
    merge_candidates_gate -> no_merge_exit [condition="has_merge_candidates=false"]
    merge_gate -> build_post_merge_packet [condition="merge_status!=merged && merge_status!=already_merged"]
    merge_gate -> set_goal_already_merged [condition="merge_status=already_merged"]
    merge_gate -> set_goal_merged [condition="merge_status=merged"]
    merged_results_gate -> judge [condition="merged_count!=0"]
    merged_results_gate -> no_merge_exit [condition="merged_count=0"]
    no_merge_finalizer_gate -> final_state_review_no_merge [condition="goal_execution_mode=direct"]
    no_merge_finalizer_gate -> release_merge_lock [condition="goal_execution_mode!=direct"]
    post_merge_resolution_gate -> set_goal_merge_failed [condition="resolution_status!=resolved"]
    post_merge_resolution_gate -> set_goal_merged [condition="resolution_status=resolved"]
    postmortem_gate -> advance_plan_index [condition="last_review_failed!=true"]
    postmortem_gate -> postmortem [condition="last_review_failed=true"]
    postmortem -> consecutive_fail_gate
    push_gate -> build_push_failure_packet [condition="push_status!=pushed"]
    push_gate -> close_merged_issues [condition="push_status=pushed"]
    push_recovery_gate -> retry_push_main [condition="resolution_status=resolved"]
    push_recovery_gate -> supervisor_push_recovery [condition="resolution_status!=resolved"]
    rebase_branch -> rebase_gate
    rebase_gate -> set_resolution_source_deterministic [condition="rebase_status=ready"]
    rebase_gate -> set_resolution_source_llm [condition="rebase_status!=ready"]
    recheck_main_clean_gate -> advance_clean_attempt
    recheck_main_clean_gate -> build_merged_results [condition="clean=true"]
    resolution_gate -> emit_resolution_failure [condition="resolution_status!=resolved"]
    resolution_gate -> merge_branch [condition="resolution_status=resolved"]
    resolve_conflict -> finalize_merge_commit
    resolve_merge_context -> setup_merge_worktree
    resolve_post_merge -> finalize_post_merge_commit
    resolve_push_failure -> verify_push_recovery
    retry_push_gate -> close_merged_issues [condition="push_status=pushed"]
    retry_push_gate -> set_goal_merge_failed [condition="push_status!=pushed"]
    retry_push_recovery_gate -> retry_push_main [condition="resolution_status=resolved"]
    retry_push_recovery_gate -> set_goal_merge_failed [condition="resolution_status!=resolved"]
    retry_resolve_conflict -> verify_resolution
    retry_resolve_post_merge -> verify_post_merge_resolution
    set_goal_already_merged -> push_main_branch
    set_main_clean_attempt -> clean_main
    set_resolution_source_deterministic -> merge_branch
    set_resolution_source_llm -> build_conflict_packet
    set_scenarios_root -> write_scenarios
    setup_merge_worktree -> rebase_branch
    supervisor_push_recovery -> verify_retry_push_recovery
    validate_judge_context -> judge_context_gate
    validate_judge_evidence -> judge_evidence_gate
    verify_push_recovery -> push_recovery_gate
    verify_retry_push_recovery -> retry_push_recovery_gate
    write_scenarios -> release_merge_lock
}
