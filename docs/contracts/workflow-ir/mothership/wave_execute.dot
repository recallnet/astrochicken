    close_milestone [type="tool" governance="irreversible" label="Close milestone" output_key="__close_milestone_result" prompt="# hatch:no-inline-script-ok\ngh api repos/${gh_repo}/milestones --state open --jq '.[] | select(.title==\"${milestone_title}\") | .number' | xargs -I{} gh api -X PATCH repos/${gh_repo}/milestones/{} -f state=closed >/dev/null" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    close_ready_issue [type="tool" governance="irreversible" action_runtime="in_process" action_id="wave.complete_ready" label="Close ready issue" output_key="__close_ready_issue_result" action_repo="${gh_repo}" action_claim_owner_id="${claim_owner_id}" action_claim_run_id="${claim_run_id}" action_claim_token="${claim_token}" action_milestone_title="${milestone_title}" action_ready_issue_number="${ready_issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    cp_blocked_exit [type="exit" label="cp_blocked"]
    decide [shape="diamond" label="Judge pass?"]
    done [shape="Msquare" label="Done" recovery_sink_type="terminal"]
    emit_resolution_failure [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.emit_resolution_failure" label="Emit resolution failure telemetry" output_key="resolution_failure_event" action_factory_id="${factory_id}" action_run_id="${__run_id}" action_branch="${branch}" action_issue="${ready_issue_number}" action_recurrence_key="wave_execute::set_resolution_source_llm::merge_conflict_llm_resolution" action_resolution_check="${resolution_check}" action_resolution_notes="${resolution_notes}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    encode_merge_candidates_b64 [type="tool" governance="reversible" action_runtime="in_process" action_id="common.encode_base64" label="Encode merge candidates payload (base64)" output_key="merge_candidates_b64" action_value="${merge_candidates}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    ensure_judge_decision [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.fallback_wave_judge" label="Normalize judge decision with deterministic fallback" output_key="judge_result" output_format="json" outputs="disposition,confidence,recommended_transition,reason_codes,notes,verdict" action_error="llm_judge_unavailable" action_verdict="${verdict}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    ensure_labels [type="tool" governance="irreversible" action_runtime="in_process" action_id="labels.ensure_factory" label="Ensure wave labels" output_key="__ensure_labels_result" action_repo="${gh_repo}" action_factory_id="mothership" action_keys="ready,wave_in_progress" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    execute_issue_in_wave [type="pipeline" label="Execute issue in wave branch" pipeline="factories/mothership/workflows/wave-execution/wave_issue_execute.workflow-source.mjs" export_keys="impl_result" inherit_context="true" trust_domain="mothership.local" trust_role="mothership.local.pipeline"]
    final_review_gate [shape="diamond" label="Work completed?"]
    final_state_review [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.resolve_goal_final_state" label="Reconcile final issue/milestone state" output_key="__final_state_review_result" action_repo="${gh_repo}" action_goal_number="${goal_issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool" action_runs_dir="${runs_dir}"]
    finalize_from_close [type="tool" governance="irreversible" action_runtime="in_process" action_id="wave.finalize_terminal_claim" label="Finalize from close" output_key="wave_terminal_path" action_repo="${gh_repo}" action_claim_owner_id="${claim_owner_id}" action_claim_run_id="${claim_run_id}" action_claim_token="${claim_token}" action_ready_issue_number="${ready_issue_number}" action_reason="terminal_close" action_terminal_path="close" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    finalize_from_fail [type="tool" governance="irreversible" action_runtime="in_process" action_id="wave.finalize_terminal_claim" label="Finalize from fail" output_key="wave_terminal_path" action_repo="${gh_repo}" action_claim_owner_id="${claim_owner_id}" action_claim_run_id="${claim_run_id}" action_claim_token="${claim_token}" action_ready_issue_number="${ready_issue_number}" action_reason="terminal_judge_fail" action_terminal_path="fail" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    finalize_from_no_merge [type="tool" governance="irreversible" action_runtime="in_process" action_id="wave.finalize_terminal_claim" label="Finalize from no-merge" output_key="wave_terminal_path" action_repo="${gh_repo}" action_claim_owner_id="${claim_owner_id}" action_claim_run_id="${claim_run_id}" action_claim_token="${claim_token}" action_ready_issue_number="${ready_issue_number}" action_reason="terminal_no_merge" action_terminal_path="no_merge" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    finalize_gate [shape="diamond" label="Finalize status"]
    finalize_merge_commit [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.finalize_commit" label="Finalize merge commit if pending" output_format="json" outputs="finalize_status,finalize_reason,finalize_detail" action_repo="${repo}" action_commit_message="${merge_commit_message}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    finalize_post_merge_commit [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.finalize_commit" label="Finalize post-merge commit if pending" output_format="json" outputs="finalize_status,finalize_reason,finalize_detail" action_repo="${repo}" action_commit_message="${merge_commit_message}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    finalize_post_merge_gate [shape="diamond" label="Post-merge finalize status"]
    find_ready_wave [type="tool" governance="reversible" action_runtime="in_process" action_id="wave.find_ready" label="Find ready wave" output_format="json" outputs="milestone_title,ready_issue_number,claim_token,claim_owner_id,claim_run_id,claim_lease_expires_at,claim_reason,claim_acquired" action_repo="${gh_repo}" action_run_id="${__run_id}" action_runs_dir="${runs_dir}" action_stale_run_minutes="${stale_run_minutes}" action_worker_id="${__run_id}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    gate [shape="diamond" label="Ready wave?"]
    handle_merge_failures [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.handle_wave_merge_failures" label="Comment merge failures" output_key="__handle_merge_failures_result" action_repo="${gh_repo}" action_run_id="${__run_id}" action_pipeline="wave_execute" action_merge_failures="${merge_failures}" action_milestone_title="${milestone_title}" action_ready_issue_number="${ready_issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    handle_review_failures [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.handle_wave_review_failures" label="Comment review failures" output_key="__handle_review_failures_result" action_repo="${gh_repo}" action_run_id="${__run_id}" action_pipeline="wave_execute" action_cooldown_hours="${review_cooldown_hours}" action_quarantine_threshold="${review_quarantine_threshold}" action_review_failures="${review_failures}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    init_branch [type="tool" governance="reversible" action_runtime="in_process" action_id="software.empty_milestone_branch_context" label="Init shared agent sessions for wave" output_format="json" outputs="branch,worktree_dir,agent_session_id,reviewer_session_id,wave_sessions_dir" action_milestone_title="${milestone_title}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    issue_loop_gate [shape="diamond" label="Next issue?"]
    judge [class="post_merge_judge" benchmark_job_id="wave.execute.merge.judge" prompt_version="2026-03-09.r1" role_version="1.0.0" skill_id="wave.execute.merge" label="Post-merge judge" outputs="disposition,confidence,recommended_transition,reason_codes,notes,verdict" prompt="You are the post-merge judge for ${gh_repo}.\n\nSurvey the existing scenario registry and use zero, one, or at most two scenarios only when they materially sharpen judgment for this merged wave. Scenarios are optional and sparse; do not force them.\nTreat scenarios as high-value judgment aids, not exhaustive checklists.\nDo NOT reveal or quote any scenario. Provide a redacted verdict envelope.\n\nMerge metadata:\n${merged_results}\n\nImplementation results (per-issue review status and evidence):\n${impl_results}\n\nMerge diff summary:\n${merge_stdout}\n\nReturn JSON:\n{\n  \"schema\": \"verdict/v1\",\n  \"verdict_kind\": \"post_merge_judge\",\n  \"disposition\": \"approve|reject|defer|escalate\",\n  \"confidence\": \"high|medium|low\",\n  \"recommended_transition\": \"close_milestone|open_followup|request_more_evidence|escalate_contract\",\n  \"observation\": {\n    \"alignment_score\": 0.0,\n    \"constraint_violations\": [],\n    \"missing_evidence\": []\n  },\n  \"recommendation\": {\n    \"action\": \"close_milestone|open_followup|request_more_evidence|escalate_contract\",\n    \"next_steps\": [\"Redacted feedback or confirmation\"]\n  },\n  \"reason_codes\": [\"POST_MERGE_ALIGNED|POST_MERGE_MISALIGNED|POST_MERGE_EVIDENCE_GAP|POST_MERGE_CONTRACT_INVALID\"],\n  \"notes\": \"Concise human-readable rationale\"\n}\n\nRules:\n- If disposition=approve, recommended_transition must be close_milestone.\n- If disposition=reject, recommended_transition must be open_followup.\n- If disposition=defer, recommended_transition must be request_more_evidence.\n- If disposition=escalate, recommended_transition must be escalate_contract.\n- reason_codes must be non-empty.\nReturn JSON only." scenarios="astrochicken"]
    judge_context_gate [shape="diamond" label="Judge context complete?"]
    judge_evidence_gate [shape="diamond" label="Judge evidence complete?"]
    list_issues [type="tool" governance="reversible" label="List milestone issues" output_key="__list_issues_result" prompt="gh issue list --repo ${gh_repo} --state open --milestone \"${milestone_title}\" --json number,title,labels" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_merge_finalize_retry_task_prompt [type="tool" governance="reversible" label="Load merge finalize retry task prompt" output_key="merge_finalize_retry_task_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/retry_finalize_conflict.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_merge_post_merge_retry_task_prompt [type="tool" governance="reversible" label="Load post-merge retry task prompt" output_key="merge_post_merge_retry_task_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/retry_post_merge.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_merge_resolve_conflict_task_prompt [type="tool" governance="reversible" label="Load resolve-conflict task prompt" output_key="merge_resolve_conflict_task_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/resolve_conflict.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_merge_resolve_post_merge_task_prompt [type="tool" governance="reversible" label="Load post-merge task prompt" output_key="merge_resolve_post_merge_task_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/resolve_post_merge.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_merge_resolve_push_failure_task_prompt [type="tool" governance="reversible" label="Load push-failure task prompt" output_key="merge_resolve_push_failure_task_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/resolve_push_failure.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    load_merge_resolver_system_prompt [type="tool" governance="reversible" label="Load merge resolver system prompt" output_key="merge_resolver_system_prompt" prompt="cat packages/factory-prompts/prompts/merge_resolver/system.md" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    lock_gate [shape="diamond" label="Lock granted?"]
    lock_wave [type="tool" governance="irreversible" action_runtime="in_process" action_id="wave.lock_ready" label="Lock wave" output_format="json" outputs="lock_granted,milestone_title,ready_issue_number,claim_token,claim_owner_id,claim_run_id,claim_lease_expires_at,reason" action_repo="${gh_repo}" action_claim_owner_id="${claim_owner_id}" action_claim_run_id="${claim_run_id}" action_claim_token="${claim_token}" action_milestone_title="${milestone_title}" action_ready_issue_number="${ready_issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    merge_candidates_gate [shape="diamond" label="Any merge candidates?"]
    merge_gate [shape="diamond" label="Any merges?"]
    merge_shared_branch [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.attempt_deterministic" label="Merge shared wave branch" output_format="json" outputs="merge_status,merge_stdout,merge_stderr,merge_worktree_dir,merge_branch_head_sha,merged_head_sha" action_repo="${repo}" action_branch="${branch}" action_branch_head_sha="${merge_branch_head_sha}" action_commit_message="${merge_commit_message}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    next_issue [type="tool" governance="reversible" action_runtime="in_process" action_id="software.pick_next_milestone_issue" label="Pick next unblocked issue" output_format="json" outputs="has_next,next_issue_number,next_issue_title,remaining_count,blocked_count,no_next_reason" action_repo="${gh_repo}" recovery_owner="supervisor" action_completed="${completed_issues}" action_milestone_title="${milestone_title}" action_processed="${processed_issues}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    open_followup [type="tool" governance="irreversible" action_runtime="in_process" action_id="wave.open_judge_followup" label="Open judge-failure artifact" output_key="__open_followup_result" action_repo="${gh_repo}" action_run_id="${__run_id}" action_pipeline="wave_execute" action_judge_notes="${notes}" action_milestone_title="${milestone_title}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    post_merge_resolution_gate [shape="diamond" label="Post-merge resolved?"]
    postmortem [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.milestone_postmortem" label="Post-mortem: persist give-up incident packet and classify" output_key="__postmortem_result" action_repo="${gh_repo}" action_issue_number="${last_issue_number}" recovery_owner="supervisor" action_branch="${last_branch}" action_review_evidence_path="${last_review_evidence_path}" action_review_notes="${last_review_notes}" action_worktree_dir="${worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    postmortem_gate [shape="diamond" label="Issue failed?"]
    push_gate [shape="diamond" label="Push status"]
    push_main_branch [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.push_main_branch" label="Push local main to origin" output_format="json" outputs="push_status,push_stdout,push_stderr" action_repo="${repo}" action_branch="main" action_merge_worktree_dir="${merge_worktree_dir}" action_remote="origin" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    rebase_shared_branch [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.rebase_on_main" label="Rebase shared wave branch on main" output_format="json" outputs="rebase_status,rebase_stdout,rebase_stderr,merge_worktree_dir,merge_branch_head_sha" action_repo="${repo}" action_branch="${branch}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    rebase_shared_gate [shape="diamond" label="Rebase status"]
    release_claim_on_lock_fail [type="tool" governance="irreversible" action_runtime="in_process" action_id="wave.release_claim" label="Release claim on lock failure" output_key="__release_claim_on_lock_fail_result" action_repo="${gh_repo}" recovery_owner="supervisor" action_claim_owner_id="${claim_owner_id}" action_claim_run_id="${claim_run_id}" action_claim_token="${claim_token}" action_ready_issue_number="${ready_issue_number}" action_reason="lock_gate_failed" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    release_merge_lock [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.release_lock" label="Release local merge lock" output_key="__release_merge_lock_result" action_repo="${repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    requeue_after_judge_failure [type="tool" governance="irreversible" action_runtime="in_process" action_id="wave.requeue_after_judge_failure" label="Requeue judge-failure wave marker" output_format="json" outputs="wave_ready_marker_action,wave_ready_marker_issue,cooldown_reason,judge_context_scope_identity,decision,markerIssueNumber,cooldownReason,milestone,wave" action_repo="${gh_repo}" action_run_id="${__run_id}" action_pipeline="wave_execute" action_cooldown_policy="{\"blocked\":false}" action_judge_context="{\"judge_context_scope_identity\":\"wave_execute\"}" action_milestone="${milestone_title}" action_wave="${milestone_title}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    resolution_gate [shape="diamond" label="Conflict resolved?"]
    resolve_config [type="tool" governance="reversible" action_runtime="in_process" action_id="software.resolve_wave_config" label="Resolve wave config defaults" output_format="json" outputs="integration_command,review_qa_command,stale_run_minutes" action_integration_command="${integration_command}" action_review_qa_command="${review_qa_command}" action_stalled_wave_minutes="${stalled_wave_minutes}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    resolve_conflict [class="merge_resolver" benchmark_job_id="wave.execute.merge.resolve_conflict" prompt_version="2026-03-12.r1" role_version="1.0.0" skill_id="wave.execute.merge" label="Resolve merge conflict" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nLoad and follow ${capability_merge_skills}/merge_conflict_resolver/SKILL.md.\n\n${merge_resolve_conflict_task_prompt}\n\nConflict packet: ${conflict_packet_path}" recovery_owner="supervisor" prompt_input_keys="capability_merge_skills,conflict_packet_path" prompt_source="merge_resolve_conflict_task_prompt" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_resolve_conflict_task_prompt" workdir="${merge_worktree_dir}"]
    resolve_demo_strategy_policy [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_factory_config" label="Resolve demo strategy policy" output_key="demo_strategy_policy" action_factory_root="${factory_root}" action_fallback="auto" action_key="demo_strategy" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    resolve_goal_number [type="tool" governance="reversible" action_runtime="in_process" action_id="coding.resolve_goal_number_from_milestone" label="Resolve goal number" output_key="goal_issue_number" action_milestone_title="${milestone_title}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    resolve_merge_context [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.resolve_context" label="Resolve merge branch/worktree context" output_format="json" outputs="branch,worktree_dir" action_fallback_branch="${branch}" action_fallback_worktree_dir="${worktree_dir}" action_merge_candidates="${merge_candidates}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    resolve_post_merge [class="merge_resolver" benchmark_job_id="wave.execute.merge.resolve_post_merge" prompt_version="2026-03-09.r1" role_version="1.0.0" skill_id="wave.execute.merge" label="LLM: resolve post-merge failure" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nLoad and follow ${capability_merge_skills}/merge_conflict_resolver/SKILL.md.\n\nMerge stderr:\n${merge_stderr}\n\n${merge_resolve_post_merge_task_prompt}\n\nConflict packet: ${conflict_packet_path}" recovery_owner="supervisor" prompt_input_keys="capability_merge_skills,merge_stderr,conflict_packet_path" prompt_source="merge_resolve_post_merge_task_prompt" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_resolve_post_merge_task_prompt" workdir="${merge_worktree_dir}"]
    resolve_push_failure [class="merge_resolver" benchmark_job_id="wave.execute.merge.resolve_push_failure" prompt_version="2026-03-12.r1" role_version="1.0.0" skill_id="wave.execute.merge" label="LLM: resolve push failure" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nLoad and follow ${capability_merge_skills}/merge_conflict_resolver/SKILL.md.\n\nPush stderr:\n${push_stderr}\n\nPush failure packet: ${push_failure_packet_path}\n\n${merge_resolve_push_failure_task_prompt}" recovery_owner="supervisor" prompt_input_keys="capability_merge_skills,push_stderr,push_failure_packet_path" prompt_source="merge_resolve_push_failure_task_prompt" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_resolve_push_failure_task_prompt" workdir="${merge_worktree_dir}"]
    retry_push_gate [shape="diamond" label="Retry push status"]
    retry_push_main [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.push_main_branch" label="Retry push after LLM resolution" output_format="json" outputs="push_status,push_stdout,push_stderr" action_repo="${repo}" action_branch="main" action_merge_worktree_dir="${merge_worktree_dir}" action_remote="origin" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    retry_resolve_conflict [class="merge_resolver" benchmark_job_id="wave.execute.merge.retry_resolve_conflict" prompt_version="2026-03-11.r1" role_version="1.0.0" skill_id="wave.execute.merge" label="LLM: fix merge finalization issue" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nProblem: ${finalize_reason}\nDetail: ${finalize_detail}\n\n${merge_finalize_retry_task_prompt}\n\nConflict packet (for reference): ${conflict_packet_path}" recovery_owner="supervisor" prompt_input_keys="finalize_reason,finalize_detail,conflict_packet_path" prompt_source="merge_finalize_retry_task_prompt" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_finalize_retry_task_prompt" workdir="${merge_worktree_dir}"]
    retry_resolve_post_merge [class="merge_resolver" benchmark_job_id="wave.execute.merge.retry_resolve_post_merge" prompt_version="2026-03-11.r1" role_version="1.0.0" skill_id="wave.execute.merge" label="LLM: fix post-merge finalization issue" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nProblem: ${finalize_reason}\nDetail: ${finalize_detail}\n\n${merge_post_merge_retry_task_prompt}" recovery_owner="supervisor" prompt_input_keys="finalize_reason,finalize_detail" prompt_source="merge_post_merge_retry_task_prompt" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_post_merge_retry_task_prompt" workdir="${merge_worktree_dir}"]
    run_demo_gate [shape="diamond" label="Run demo subflow?"]
    run_wave_demo_generate [type="pipeline" label="Run wave demo generation" pipeline="factories/mothership/workflows/wave-execution/wave_demo_generate.workflow-source.mjs" export_keys="artifact_url,demo_status,demo_error,demo_strategy_resolved" fail_open="true" inherit_context="true" trust_domain="mothership.local" trust_role="mothership.local.pipeline"]
    sanitize_state [type="tool" governance="irreversible" action_runtime="in_process" action_id="wave.sanitize_state" label="Normalize wave-ready state" output_key="__sanitize_state_result" action_repo="${gh_repo}" action_run_id="${__run_id}" action_pipeline="wave_execute" action_apply="true" action_stale_run_minutes="${stale_run_minutes}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    seed_state [type="tool" governance="reversible" action_runtime="in_process" action_id="software.seed_milestone_state" label="Seed completed/processed from canonical milestone runs" output_format="json" outputs="completed_issues,processed_issues" action_repo="${gh_repo}" action_milestone_title="${milestone_title}" trust_domain="mothership.local" trust_role="mothership.local.tool" action_runs_dir="${runs_dir}"]
    set_capability_coding_skills [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_capability_coding_skills_path" label="Resolve capability-coding skills path" output_key="capability_coding_skills" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_capability_merge_skills [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_capability_merge_skills_path" label="Resolve capability-merge skills path" output_key="capability_merge_skills" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_gh_repo [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_gh_repo" label="Resolve GitHub repo" output_key="gh_repo" action_gh_repo="${gh_repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_repo [type="tool" governance="reversible" label="Set repo" output_key="repo" prompt="# hatch:no-inline-script-ok\ngit rev-parse --show-toplevel | tr -d '\n'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_resolution_source_deterministic [type="tool" governance="reversible" label="Set merge resolver: deterministic" output_key="resolution_source" prompt="printf 'deterministic'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_resolution_source_llm [type="tool" governance="reversible" label="Set merge resolver: llm" output_key="resolution_source" prompt="printf 'llm'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_wave_already_merged [type="tool" governance="reversible" label="Set merge status: already merged" output_key="wave_merge_status" prompt="printf 'merged'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_wave_merge_failed [type="tool" governance="reversible" label="Set merge status: failed" output_key="wave_merge_status" prompt="printf 'failed'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    set_wave_merged [type="tool" governance="reversible" label="Set merge status: merged" output_key="wave_merge_status" prompt="printf 'merged'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    setup_merge_worktree [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.setup_worktree" label="Setup merge worktree" output_format="json" outputs="setup,reason,merge_worktree_dir,merge_base_ref,merge_branch_head_sha" action_repo="${repo}" action_run_id="${__run_id}" action_pipeline="wave-execute" action_branch="${branch}" action_issue="${ready_issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    shared_merge_gate [shape="diamond" label="Merge status"]
    split_results [type="tool" governance="reversible" action_runtime="in_process" action_id="software.split_wave_results" label="Filter review failures" output_format="json" outputs="merge_candidates,review_failures" action_fallback="${impl_results}" action_runs_dir="${runs_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    start [shape="Mdiamond" label="Start"]
    unlock_no_merge [type="tool" governance="irreversible" action_runtime="in_process" action_id="wave.block_ready" label="Unlock ready issue (no merges)" output_key="__unlock_no_merge_result" action_repo="${gh_repo}" action_run_id="${__run_id}" action_pipeline="wave_execute" action_milestone_title="${milestone_title}" action_ready_issue_number="${ready_issue_number}" action_reason="no_merge_candidates" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    unlock_ready_issue [type="tool" governance="irreversible" action_runtime="in_process" action_id="wave.block_ready" label="Unlock ready issue" output_key="__unlock_ready_issue_result" action_repo="${gh_repo}" action_run_id="${__run_id}" action_pipeline="wave_execute" recovery_owner="supervisor" action_milestone_title="${milestone_title}" action_ready_issue_number="${ready_issue_number}" action_reason="judge_failed" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    validate_judge_context [type="tool" governance="irreversible" action_runtime="in_process" action_id="judge.validate_context_contract" label="Validate pre-merge judge context contract" output_format="json" outputs="judge_context_gate_pass,judge_context_gate_code,judge_context_error,judge_context_path,judge_context_sha256,judge_scenario_selection_path,judge_scenario_selection_sha256,judge_scenario_selection_signature_sha256,judge_route_code,disposition,confidence,recommended_transition,reason_codes,notes,verdict" action_judge_context_b64="${merge_candidates_b64}" action_judge_context_error="${judge_context_error}" action_judge_context_path="${judge_context_path}" action_judge_context_scope_identity="wave_execute" action_judge_context_sha256="${judge_context_sha256}" action_judge_context_valid="${judge_context_valid}" action_judge_evidence_path="${judge_evidence_path}" action_judge_evidence_sha256="${judge_evidence_sha256}" action_judge_kind="wave_execution_post_merge" action_judge_rubric="alignment.default" action_objective_id="post_merge_alignment" action_scenario_context="post-merge" action_scenario_registry_root="${scenarios_root}" action_scenario_selector="astrochicken" action_scope="judge" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    validate_judge_evidence [type="tool" governance="irreversible" action_runtime="in_process" action_id="judge.validate_evidence_contract" label="Validate pre-merge judge evidence contract" output_format="json" outputs="judge_evidence_gate_pass,judge_evidence_gate_code,judge_evidence_error,judge_route_code,disposition,confidence,recommended_transition,reason_codes,notes,verdict" action_judge_context_b64="${merge_candidates_b64}" action_judge_evidence_error="${judge_evidence_error}" action_judge_evidence_path="${judge_evidence_path}" action_judge_evidence_sha256="${judge_evidence_sha256}" action_judge_evidence_valid="${judge_evidence_valid}" action_judge_kind="wave_execution_post_merge" action_require_qa_markers="true" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    verify_post_merge_resolution [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.verify_resolution" label="Verify post-merge resolution" output_format="json" outputs="resolution_status,resolution_notes" action_repo="${repo}" action_branch="${branch}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    verify_resolution [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.verify_resolution" label="Verify conflict resolved" output_format="json" outputs="resolution_status,resolution_notes" action_repo="${repo}" action_branch="${branch}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    build_merged_results -> handle_merge_failures -> clear_demo_artifact_url -> clear_demo_status -> clear_demo_error -> resolve_demo_strategy_policy -> merge_gate
    cleanup_merge_worktree -> cleanup_wave_worktree -> done
    close_merged_issues -> build_merged_results
    judge -> ensure_judge_decision -> decide
    merge_shared_branch -> shared_merge_gate
    next_issue -> issue_loop_gate
    push_main_branch -> push_gate
    release_merge_lock -> assert_main_after_merge -> final_review_gate
    set_wave_merge_failed -> cleanup_failed_merge -> build_merged_results
    set_wave_merged -> push_main_branch
    start -> set_repo -> assert_main_branch -> set_gh_repo -> resolve_config -> set_capability_coding_skills -> set_capability_merge_skills -> load_merge_resolver_system_prompt -> load_merge_resolve_conflict_task_prompt -> load_merge_finalize_retry_task_prompt -> load_merge_resolve_post_merge_task_prompt -> load_merge_post_merge_retry_task_prompt -> load_merge_resolve_push_failure_task_prompt -> ensure_labels -> sanitize_state -> find_ready_wave -> gate
    unlock_no_merge -> finalize_from_no_merge -> release_merge_lock
    unlock_ready_issue -> requeue_after_judge_failure -> open_followup -> finalize_from_fail -> release_merge_lock
    verify_post_merge_resolution -> post_merge_resolution_gate
    verify_resolution -> resolution_gate
    accumulate -> postmortem_gate
    acquire_merge_lock -> resolve_merge_context
    build_conflict_packet -> resolve_conflict
    build_judge_context_recovery_packet -> unlock_ready_issue
    build_judge_context -> validate_judge_context
    build_judge_evidence_recovery_packet -> unlock_ready_issue
    build_judge_evidence -> build_judge_context
    build_merge_commit_message -> acquire_merge_lock
    build_post_merge_packet -> resolve_post_merge
    build_push_failure_packet -> resolve_push_failure
    check_cp_blocker -> cp_blocked_exit [condition="blocker_active=true"]
    check_cp_blocker -> lock_wave [condition="blocker_active!=true"]
    check_merge_candidates -> merge_candidates_gate
    clear_impl_result -> execute_issue_in_wave
    close_milestone -> close_ready_issue
    close_ready_issue -> finalize_from_close
    decide -> close_milestone [condition="disposition=approve"]
    decide -> unlock_ready_issue [condition="disposition!=approve"]
    emit_resolution_failure -> set_wave_merge_failed
    encode_merge_candidates_b64 -> build_judge_evidence
    execute_issue_in_wave -> accumulate
    final_review_gate -> cleanup_merge_worktree [condition="wave_terminal_path!=close"]
    final_review_gate -> final_state_review [condition="wave_terminal_path=close"]
    final_state_review -> cleanup_merge_worktree
    finalize_from_close -> release_merge_lock
    finalize_gate -> retry_resolve_conflict [condition="finalize_status!=ok"]
    finalize_gate -> verify_resolution [condition="finalize_status=ok"]
    finalize_merge_commit -> finalize_gate
    finalize_post_merge_commit -> finalize_post_merge_gate
    finalize_post_merge_gate -> retry_resolve_post_merge [condition="finalize_status!=ok"]
    finalize_post_merge_gate -> verify_post_merge_resolution [condition="finalize_status=ok"]
    gate -> check_cp_blocker [condition="milestone_title!="]
    gate -> done [condition="milestone_title="]
    handle_review_failures -> check_merge_candidates
    init_branch -> next_issue
    issue_loop_gate -> clear_impl_result [condition="has_next=true"]
    issue_loop_gate -> split_results [condition="has_next!=true"]
    judge_context_gate -> build_judge_context_recovery_packet [condition="judge_context_gate_pass!=true"]
    judge_context_gate -> validate_judge_evidence [condition="judge_context_gate_pass=true"]
    judge_evidence_gate -> build_judge_evidence_recovery_packet [condition="judge_evidence_gate_pass!=true"]
    judge_evidence_gate -> build_merge_commit_message [condition="judge_evidence_gate_pass=true"]
    list_issues -> resolve_goal_number
    lock_gate -> list_issues [condition="lock_granted=true"]
    lock_gate -> release_claim_on_lock_fail [condition="lock_granted!=true"]
    lock_wave -> lock_gate
    merge_candidates_gate -> encode_merge_candidates_b64 [condition="has_merge_candidates=true"]
    merge_candidates_gate -> unlock_no_merge [condition="has_merge_candidates=false"]
    merge_gate -> run_demo_gate [condition="merged_count!=0"]
    merge_gate -> unlock_no_merge [condition="merged_count=0"]
    post_merge_resolution_gate -> set_wave_merge_failed [condition="resolution_status!=resolved"]
    post_merge_resolution_gate -> set_wave_merged [condition="resolution_status=resolved"]
    postmortem_gate -> next_issue [condition="last_review_failed!=true"]
    postmortem_gate -> postmortem [condition="last_review_failed=true"]
    postmortem -> next_issue
    push_gate -> build_push_failure_packet [condition="push_status!=pushed"]
    push_gate -> close_merged_issues [condition="push_status=pushed"]
    rebase_shared_branch -> rebase_shared_gate
    rebase_shared_gate -> set_resolution_source_deterministic [condition="rebase_status=ready"]
    rebase_shared_gate -> set_resolution_source_llm [condition="rebase_status!=ready"]
    release_claim_on_lock_fail -> done
    resolution_gate -> emit_resolution_failure [condition="resolution_status!=resolved"]
    resolution_gate -> merge_shared_branch [condition="resolution_status=resolved"]
    resolve_conflict -> finalize_merge_commit
    resolve_goal_number -> seed_state
    resolve_merge_context -> setup_merge_worktree
    resolve_post_merge -> finalize_post_merge_commit
    resolve_push_failure -> retry_push_main
    retry_push_gate -> close_merged_issues [condition="push_status=pushed"]
    retry_push_gate -> set_wave_merge_failed [condition="push_status!=pushed"]
    retry_push_main -> retry_push_gate
    retry_resolve_conflict -> verify_resolution
    retry_resolve_post_merge -> verify_post_merge_resolution
    run_demo_gate -> judge [condition="demo_strategy_policy=none"]
    run_demo_gate -> run_wave_demo_generate [condition="demo_strategy_policy!=none"]
    run_wave_demo_generate -> judge
    seed_state -> init_branch
    set_resolution_source_deterministic -> merge_shared_branch
    set_resolution_source_llm -> build_conflict_packet
    set_wave_already_merged -> push_main_branch
    setup_merge_worktree -> rebase_shared_branch
    shared_merge_gate -> build_post_merge_packet [condition="merge_status!=merged && merge_status!=already_merged"]
    shared_merge_gate -> set_wave_already_merged [condition="merge_status=already_merged"]
    shared_merge_gate -> set_wave_merged [condition="merge_status=merged"]
    split_results -> handle_review_failures
    validate_judge_context -> judge_context_gate
    validate_judge_evidence -> judge_evidence_gate
}
