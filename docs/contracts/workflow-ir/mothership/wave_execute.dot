    cleanup_failed_merge [type="tool" governance="irreversible" label="Cleanup failed merge state" output_key="__cleanup_failed_merge_result" prompt="# hatch:no-inline-script-ok\ngit -C \"${merge_worktree_dir}\" merge --abort >/dev/null 2>&1 || true\ngit -C \"${merge_worktree_dir}\" rebase --abort >/dev/null 2>&1 || true" recovery_owner="supervisor" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    cleanup_merge_worktree [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.cleanup_worktree" label="Cleanup merge worktree" output_key="__cleanup_merge_worktree_result" action_repo="${repo}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
