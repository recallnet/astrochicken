    clear_demo_error [type="tool" governance="reversible" label="Clear demo error" output_key="demo_error" prompt="printf ''" trust_domain="mothership.local" trust_role="mothership.local.tool"]
    clear_demo_status [type="tool" governance="reversible" label="Clear demo status" output_key="demo_status" prompt="printf 'not_requested'" trust_domain="mothership.local" trust_role="mothership.local.tool"]
