    check_cp_blocker [type="tool" governance="reversible" action_runtime="in_process" action_id="wave.check_control_plane_blocker" label="Check control-plane blocker" output_format="json" outputs="blocker_active,status,kind,blockerRef,unblockCondition" action_repo="${gh_repo}" action_issue="${ready_issue_number}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
