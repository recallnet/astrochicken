    build_merge_commit_message [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.build_commit_message" label="Build goal-scoped merge commit message" output_format="json" outputs="merge_commit_message" action_goal_issue_number="${goal_issue_number}" action_merge_candidates_raw="${merge_candidates}" action_milestone_title="${milestone_title}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
