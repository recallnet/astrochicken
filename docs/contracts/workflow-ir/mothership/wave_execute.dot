    build_post_merge_packet [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.build_conflict_packet" label="Build post-merge conflict packet" output_format="json" outputs="conflict_packet_path,conflict_packet_id,conflict_packet_schema_version,conflict_packet_storage_class" action_repo="${repo}" action_factory_id="${factory_id}" action_run_id="${__run_id}" action_pipeline="wave_execute" action_node_id="build_post_merge_packet" action_branch="${branch}" action_control_plane_repo="${control_plane_repo}" action_issue="${ready_issue_number}" action_merge_stderr="${merge_stderr}" action_target_repo="${gh_repo}" action_worktree_dir="${merge_worktree_dir}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
