    build_judge_context [type="tool" governance="irreversible" action_runtime="in_process" action_id="judge.build_context_contract" label="Build pre-merge judge context contract" output_format="json" outputs="judge_context_path,judge_context_sha256,judge_context_valid,judge_context_error,judge_scenario_selection_path,judge_scenario_selection_sha256,judge_scenario_selection_signature_sha256" action_gh_repo="recallnet/astrochicken" action_judge_context_b64="${merge_candidates_b64}" action_judge_context_scope_identity="wave_execute" action_judge_evidence_path="${judge_evidence_path}" action_judge_evidence_sha256="${judge_evidence_sha256}" action_judge_kind="wave_execution_post_merge" action_judge_rubric="alignment.default" action_milestone_title="${milestone_title}" action_objective_id="post_merge_alignment" action_scenario_context="post-merge" action_scenario_registry_root="${scenarios_root}" action_scenario_selector="astrochicken" action_scope="judge" action_subject_id="${milestone_title}" action_worktree_dir="${repo}" trust_domain="mothership.local" trust_role="mothership.local.tool"]
