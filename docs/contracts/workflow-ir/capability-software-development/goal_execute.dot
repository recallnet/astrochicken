    post_merge_resolution_gate [shape="diamond" label="Post-merge resolved?"]
    postmortem [type="tool" governance="irreversible" action_runtime="in_process" action_id="software.goal_postmortem" label="Post-mortem: persist give-up incident packet and classify" output_key="__postmortem_result" action_repo="${gh_repo}" action_issue_number="${last_issue_number}" action_branch="${last_branch}" action_review_evidence_path="${last_review_evidence_path}" action_review_notes="${last_review_notes}" action_worktree_dir="${worktree_dir}" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    postmortem_gate [shape="diamond" label="Issue failed?"]
    push_gate [shape="diamond" label="Push status"]
    push_main_branch [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.push_main_branch" label="Push local main to origin" output_format="json" outputs="push_status,push_failure_reason,push_stdout,push_stderr" action_repo="${repo}" action_branch="main" action_merge_worktree_dir="${merge_worktree_dir}" action_merged_head_sha="${merged_head_sha}" action_remote="origin" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    push_recovery_gate [shape="diamond" label="Push recovery verified?"]
    rebase_branch [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.rebase_on_main" label="Rebase goal branch on main" output_format="json" outputs="rebase_status,rebase_stdout,rebase_stderr,merge_worktree_dir,merge_branch_head_sha" action_repo="${repo}" action_branch="${branch}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    rebase_gate [shape="diamond" label="Rebase status"]
    recheck_main_clean [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.assert_main_clean" label="Re-check canonical checkout is clean" output_format="json" outputs="clean,branch,untracked_count,modified_count,partial_state" action_repo="${repo}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    recheck_main_clean_gate [shape="diamond" label="Is main clean now?"]
    release_merge_lock [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.release_lock" label="Release local merge lock" output_key="__release_merge_lock_result" action_repo="${repo}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    resolution_gate [shape="diamond" label="Conflict resolved?"]
    resolve_config [type="tool" governance="reversible" action_runtime="in_process" action_id="software.resolve_execution_config" label="Resolve execution config defaults" output_format="json" outputs="integration_command,review_qa_command,stale_run_minutes" action_integration_command="${integration_command}" action_review_qa_command="${review_qa_command}" action_stalled_wave_minutes="${stalled_wave_minutes}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    resolve_conflict [type="stack.manager_loop" governance="irreversible" class="merge_resolver" benchmark_job_id="goal.execute.merge.resolve_conflict" llm_path_id="mothership.goal_execute.resolve_conflict" prompt_version="2026-03-12.r1" role_version="1.0.0" skill_id="goal.execute.merge" label="Resolve merge conflict" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nLoad and follow ${capability_merge_skills}/merge_conflict_resolver/SKILL.md.\n\n${merge_resolve_conflict_task_prompt}\n\nConflict packet: ${conflict_packet_path}" prompt_input_keys="capability_merge_skills,conflict_packet_path" prompt_source="merge_resolve_conflict_task_prompt" recovery_owner="supervisor" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_resolve_conflict_task_prompt" workdir="${merge_worktree_dir}"]
    resolve_merge_context [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.resolve_context" label="Resolve merge branch/worktree context" output_format="json" outputs="branch,worktree_dir" action_fallback_branch="${branch}" action_fallback_worktree_dir="${worktree_dir}" action_merge_candidates="${merge_candidates}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    resolve_post_merge [type="stack.manager_loop" governance="irreversible" class="merge_resolver" benchmark_job_id="goal.execute.merge.resolve_post_merge" llm_path_id="mothership.goal_execute.resolve_post_merge" prompt_version="2026-03-09.r1" role_version="1.0.0" skill_id="goal.execute.merge" label="LLM: resolve post-merge failure" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nLoad and follow ${capability_merge_skills}/merge_conflict_resolver/SKILL.md.\n\nMerge stderr:\n${merge_stderr}\n\n${merge_resolve_post_merge_task_prompt}\n\nConflict packet: ${conflict_packet_path}" prompt_input_keys="capability_merge_skills,merge_stderr,conflict_packet_path" prompt_source="merge_resolve_post_merge_task_prompt" recovery_owner="supervisor" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_resolve_post_merge_task_prompt" workdir="${merge_worktree_dir}"]
    resolve_push_failure [type="stack.manager_loop" governance="irreversible" class="merge_resolver" benchmark_job_id="goal.execute.merge.resolve_push_failure" llm_path_id="mothership.goal_execute.resolve_push_failure" prompt_version="2026-03-12.r1" role_version="1.0.0" skill_id="goal.execute.merge" label="LLM: resolve push failure" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nLoad and follow ${capability_merge_skills}/merge_conflict_resolver/SKILL.md.\n\nPush stderr:\n${push_stderr}\n\nPush failure packet: ${push_failure_packet_path}\n\n${merge_resolve_push_failure_task_prompt}" prompt_input_keys="capability_merge_skills,push_stderr,push_failure_packet_path" prompt_source="merge_resolve_push_failure_task_prompt" recovery_owner="supervisor" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_resolve_push_failure_task_prompt" workdir="${merge_worktree_dir}"]
    retry_push_gate [shape="diamond" label="Retry push status"]
    retry_push_main [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.push_main_branch" label="Retry push after LLM resolution" output_format="json" outputs="push_status,push_failure_reason,push_stdout,push_stderr" action_repo="${repo}" action_branch="main" action_merge_worktree_dir="${merge_worktree_dir}" action_merged_head_sha="${merged_head_sha}" action_remote="origin" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    retry_push_recovery_gate [shape="diamond" label="Retry push recovery verified?"]
    retry_resolve_conflict [type="stack.manager_loop" governance="irreversible" class="merge_resolver" benchmark_job_id="goal.execute.merge.retry_resolve_conflict" llm_path_id="mothership.goal_execute.retry_resolve_conflict" prompt_version="2026-03-11.r1" role_version="1.0.0" skill_id="goal.execute.merge" label="LLM: fix merge finalization issue" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nProblem: ${finalize_reason}\nDetail: ${finalize_detail}\n\n${merge_finalize_retry_task_prompt}\n\nConflict packet (for reference): ${conflict_packet_path}" prompt_input_keys="finalize_reason,finalize_detail,conflict_packet_path" prompt_source="merge_finalize_retry_task_prompt" recovery_owner="supervisor" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_finalize_retry_task_prompt" workdir="${merge_worktree_dir}"]
    retry_resolve_post_merge [type="stack.manager_loop" governance="irreversible" class="merge_resolver" benchmark_job_id="goal.execute.merge.retry_resolve_post_merge" llm_path_id="mothership.goal_execute.retry_resolve_post_merge" prompt_version="2026-03-11.r1" role_version="1.0.0" skill_id="goal.execute.merge" label="LLM: fix post-merge finalization issue" reasoning_effort="medium" timeout="45m" prompt="${merge_resolver_system_prompt}\n\nProblem: ${finalize_reason}\nDetail: ${finalize_detail}\n\n${merge_post_merge_retry_task_prompt}" prompt_input_keys="finalize_reason,finalize_detail" prompt_source="merge_post_merge_retry_task_prompt" recovery_owner="supervisor" system_prompt_source="merge_resolver_system_prompt" task_prompt_source="merge_post_merge_retry_task_prompt" workdir="${merge_worktree_dir}"]
    seed_state [type="tool" governance="reversible" action_runtime="in_process" action_id="software.seed_goal_state" label="Seed completed/processed from goal sub-issues" output_format="json" outputs="completed_issues,processed_issues,impl_results,plan_index" action_repo="${gh_repo}" action_goal_number="${goal_issue_number}" action_runs_dir="${runs_dir}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    set_capability_coding_skills [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_capability_coding_skills_path" label="Resolve capability-coding skills path" output_key="capability_coding_skills" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    set_capability_merge_skills [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_capability_merge_skills_path" label="Resolve capability-merge skills path" output_key="capability_merge_skills" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    set_gh_repo [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_gh_repo" label="Resolve GitHub repo" output_key="gh_repo" action_gh_repo="${gh_repo}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    set_goal_already_merged [type="tool" governance="reversible" label="Set merge status: already merged" output_key="goal_merge_status" prompt="printf 'merged'" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    set_goal_merge_failed [type="tool" governance="reversible" label="Set merge status: failed" output_key="goal_merge_status" prompt="printf 'failed'" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    set_goal_merged [type="tool" governance="reversible" label="Set merge status: merged" output_key="goal_merge_status" prompt="printf 'merged'" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    set_main_clean_attempt [type="tool" governance="reversible" label="Initialize clean attempt counter" output_key="main_clean_attempt" prompt="printf '1'" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    set_repo [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Set repo" output_key="repo" action_fallback="." action_value="${repo}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    set_resolution_source_deterministic [type="tool" governance="reversible" label="Set merge resolver: deterministic" output_key="resolution_source" prompt="printf 'deterministic'" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    set_resolution_source_llm [type="tool" governance="reversible" label="Set merge resolver: llm" output_key="resolution_source" prompt="printf 'llm'" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    setup_merge_worktree [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.setup_worktree" label="Setup merge worktree" output_format="json" outputs="setup,reason,merge_worktree_dir,merge_base_ref,merge_branch_head_sha" action_repo="${repo}" action_issue_number="${goal_issue_number}" action_run_id="${__run_id}" action_pipeline="goal-execute" action_branch="${branch}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    split_results [type="tool" governance="reversible" action_runtime="in_process" action_id="software.split_goal_results" label="Filter review failures" output_format="json" outputs="merge_candidates,review_failures" action_fallback="${impl_results}" action_runs_dir="${runs_dir}" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    start [shape="Mdiamond"]
    supervisor_push_recovery [type="stack.manager_loop" governance="irreversible" class="supervisor" benchmark_job_id="goal.execute.merge.supervisor_push_recovery" llm_path_id="mothership.goal_execute.supervisor_push_recovery" prompt_version="2026-03-30.r1" role_version="1.0.0" skill_id="supervisor.review" label="Supervisor LLM: recover failed push" timeout="120m" prompt="You are the supervisor escalation for a goal merge push failure.\n\nGoal: #${goal_issue_number}\nRepo: ${gh_repo}\nProblem: ${resolution_notes}\nPush stderr:\n${push_stderr}\nPush failure packet: ${push_failure_packet_path}\n\nRequired outcome:\n- preserve the completed merge work\n- make canonical main and the merge worktree converge to a state where the deterministic push-recovery verifier passes\n- do not stop at 'ready to push'\n- do not discard completed work or close the goal if the merge has not landed\n\nLoad and follow ${capability_merge_skills}/merge_conflict_resolver/SKILL.md, then repair the state so the next deterministic retry push can succeed." recovery_owner="supervisor" prompt_input_keys="capability_merge_skills,resolution_notes,push_stderr,push_failure_packet_path" session_id="supervisor-${factory_id}" workdir="${repo}"]
    validate_judge_context [type="tool" governance="irreversible" action_runtime="in_process" action_id="judge.validate_context_contract" label="Validate pre-merge judge context contract" output_format="json" outputs="judge_context_gate_pass,judge_context_gate_code,judge_context_error,judge_context_path,judge_context_sha256,judge_scenario_selection_path,judge_scenario_selection_sha256,judge_scenario_selection_signature_sha256,judge_route_code,disposition,confidence,recommended_transition,reason_codes,notes,verdict" action_judge_context_b64="${merge_candidates_b64}" action_judge_context_error="${judge_context_error}" action_judge_context_path="${judge_context_path}" action_judge_context_raw="${merge_candidates}" action_judge_context_scope_identity="goal_execute" action_judge_context_sha256="${judge_context_sha256}" action_judge_context_valid="${judge_context_valid}" action_judge_evidence_path="${judge_evidence_path}" action_judge_evidence_sha256="${judge_evidence_sha256}" action_judge_kind="goal_execution_post_merge" action_judge_rubric="alignment.default" action_objective_id="post_merge_alignment" action_scenario_context="post-merge" action_scenario_registry_root="${scenarios_root}" action_scenario_selector="${judge_scenario_selector}" action_scope="judge" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    validate_judge_evidence [type="tool" governance="irreversible" action_runtime="in_process" action_id="judge.validate_evidence_contract" label="Validate pre-merge judge evidence contract" output_format="json" outputs="judge_evidence_gate_pass,judge_evidence_gate_code,judge_evidence_error,judge_route_code,disposition,confidence,recommended_transition,reason_codes,notes,verdict" action_judge_context_b64="${merge_candidates_b64}" action_judge_context_raw="${merge_candidates}" action_judge_evidence_error="${judge_evidence_error}" action_judge_evidence_path="${judge_evidence_path}" action_judge_evidence_sha256="${judge_evidence_sha256}" action_judge_evidence_valid="${judge_evidence_valid}" action_judge_kind="goal_execution_post_merge" action_require_qa_markers="true" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    verify_post_merge_resolution [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.verify_resolution" label="Verify post-merge resolution" output_format="json" outputs="resolution_status,resolution_notes" action_repo="${repo}" action_branch="${branch}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    verify_push_recovery [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.verify_push_recovery" label="Verify push recovery state" output_format="json" outputs="resolution_status,resolution_notes" action_repo="${repo}" action_branch="main" action_merge_worktree_dir="${merge_worktree_dir}" action_remote="origin" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    verify_resolution [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.verify_resolution" label="Verify conflict resolved" output_format="json" outputs="resolution_status,resolution_notes" action_repo="${repo}" action_branch="${branch}" action_merge_worktree_dir="${merge_worktree_dir}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    verify_retry_push_recovery [type="tool" governance="reversible" action_runtime="in_process" action_id="merge.verify_push_recovery" label="Verify retried push recovery state" output_format="json" outputs="resolution_status,resolution_notes" action_repo="${repo}" action_branch="main" action_merge_worktree_dir="${merge_worktree_dir}" action_remote="origin" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    advance_plan_index -> pick_plan_issue
    build_merged_results -> handle_merge_failures -> merged_results_gate
    check_main_clean -> main_clean_gate
    clean_main -> recheck_main_clean -> recheck_main_clean_gate
    close_merged_issues -> check_main_clean
    merge_branch -> merge_gate
    no_merge_exit -> no_merge_finalizer_gate
    pick_plan_issue -> issue_loop_gate
    push_main_branch -> push_gate
    release_merge_lock -> assert_main_after_merge -> cleanup_merge_worktree -> cleanup_goal_worktree -> done
    retry_push_main -> retry_push_gate
    set_goal_merge_failed -> cleanup_failed_merge -> check_main_clean
    split_results -> handle_review_failures -> check_merge_candidates -> merge_candidates_gate
    start -> set_repo -> assert_main_branch -> set_gh_repo -> resolve_config -> set_capability_coding_skills -> set_capability_merge_skills -> load_merge_resolver_system_prompt -> load_merge_resolve_conflict_task_prompt -> load_merge_finalize_retry_task_prompt -> load_merge_resolve_post_merge_task_prompt -> load_merge_post_merge_retry_task_prompt -> load_merge_resolve_push_failure_task_prompt -> seed_state -> build_execution_plan -> init_branch -> pick_plan_issue
    verify_post_merge_resolution -> post_merge_resolution_gate
    verify_resolution -> resolution_gate
    accumulate -> postmortem_gate
    acquire_merge_lock -> resolve_merge_context
    advance_clean_attempt -> main_clean_attempt_gate
    build_conflict_packet -> resolve_conflict
    build_judge_context_recovery_packet -> no_merge_exit
    build_judge_context -> validate_judge_context
    build_judge_evidence_recovery_packet -> no_merge_exit
    build_judge_evidence -> build_judge_context
    build_merge_commit_message -> acquire_merge_lock
    build_post_merge_packet -> resolve_post_merge
    build_push_failure_packet -> resolve_push_failure
    consecutive_fail_gate -> advance_plan_index [condition="consecutive_fail_count<2"]
    consecutive_fail_gate -> split_results [condition="consecutive_fail_count>=2"]
    emit_dirty_main_artifact -> build_merged_results
    emit_resolution_failure -> set_goal_merge_failed
    encode_merge_candidates_b64 -> build_judge_evidence
    ensure_judge_decision -> judge_pass_gate
    execute_issue -> accumulate
    final_state_review_no_merge -> release_merge_lock
    final_state_review -> release_merge_lock
    finalize_gate -> retry_resolve_conflict [condition="finalize_status!=ok"]
    finalize_gate -> verify_resolution [condition="finalize_status=ok"]
    finalize_merge_commit -> finalize_gate
    finalize_post_merge_commit -> finalize_post_merge_gate
    finalize_post_merge_gate -> retry_resolve_post_merge [condition="finalize_status!=ok"]
    finalize_post_merge_gate -> verify_post_merge_resolution [condition="finalize_status=ok"]
    issue_loop_gate -> execute_issue [condition="has_next=true"]
    issue_loop_gate -> split_results [condition="has_next!=true"]
    judge_context_gate -> build_judge_context_recovery_packet [condition="judge_context_gate_pass!=true"]
    judge_context_gate -> validate_judge_evidence [condition="judge_context_gate_pass=true"]
    judge_evidence_gate -> build_judge_evidence_recovery_packet [condition="judge_evidence_gate_pass!=true"]
    judge_evidence_gate -> build_merge_commit_message [condition="judge_evidence_gate_pass=true"]
    judge_pass_gate -> final_state_review [condition="disposition=approve"]
    judge_pass_gate -> no_merge_exit [condition="disposition!=approve"]
    judge -> ensure_judge_decision
    main_clean_attempt_gate -> clean_main [condition="main_clean_attempt!=3"]
    main_clean_attempt_gate -> emit_dirty_main_artifact [condition="main_clean_attempt=3"]
    main_clean_gate -> build_merged_results [condition="clean=true"]
    main_clean_gate -> set_main_clean_attempt [condition="clean!=true"]
    merge_candidates_gate -> encode_merge_candidates_b64 [condition="has_merge_candidates=true"]
    merge_candidates_gate -> no_merge_exit [condition="has_merge_candidates=false"]
    merge_gate -> build_post_merge_packet [condition="merge_status!=merged && merge_status!=already_merged"]
    merge_gate -> set_goal_already_merged [condition="merge_status=already_merged"]
    merge_gate -> set_goal_merged [condition="merge_status=merged"]
    merged_results_gate -> judge [condition="merged_count!=0"]
    merged_results_gate -> no_merge_exit [condition="merged_count=0"]
    no_merge_finalizer_gate -> final_state_review_no_merge [condition="goal_execution_mode=direct"]
    no_merge_finalizer_gate -> release_merge_lock [condition="goal_execution_mode!=direct"]
    post_merge_resolution_gate -> push_main_branch [condition="resolution_status=resolved"]
    post_merge_resolution_gate -> set_goal_merge_failed [condition="resolution_status!=resolved"]
    postmortem_gate -> advance_plan_index [condition="last_review_failed!=true"]
    postmortem_gate -> postmortem [condition="last_review_failed=true"]
    postmortem -> consecutive_fail_gate
    push_gate -> build_push_failure_packet [condition="push_status!=pushed"]
    push_gate -> close_merged_issues [condition="push_status=pushed"]
    push_recovery_gate -> retry_push_main [condition="resolution_status=resolved"]
    push_recovery_gate -> supervisor_push_recovery [condition="resolution_status!=resolved"]
    rebase_branch -> rebase_gate
    rebase_gate -> set_resolution_source_deterministic [condition="rebase_status=ready"]
    rebase_gate -> set_resolution_source_llm [condition="rebase_status!=ready"]
    recheck_main_clean_gate -> advance_clean_attempt
    recheck_main_clean_gate -> build_merged_results [condition="clean=true"]
    resolution_gate -> emit_resolution_failure [condition="resolution_status!=resolved"]
    resolution_gate -> merge_branch [condition="resolution_status=resolved"]
    resolve_conflict -> finalize_merge_commit
    resolve_merge_context -> setup_merge_worktree
    resolve_post_merge -> finalize_post_merge_commit
    resolve_push_failure -> verify_push_recovery
    retry_push_gate -> close_merged_issues [condition="push_status=pushed"]
    retry_push_gate -> set_goal_merge_failed [condition="push_status!=pushed"]
    retry_push_recovery_gate -> retry_push_main [condition="resolution_status=resolved"]
    retry_push_recovery_gate -> set_goal_merge_failed [condition="resolution_status!=resolved"]
    retry_resolve_conflict -> verify_resolution
    retry_resolve_post_merge -> verify_post_merge_resolution
    set_goal_already_merged -> push_main_branch
    set_goal_merged -> push_main_branch
    set_main_clean_attempt -> clean_main
    set_resolution_source_deterministic -> merge_branch
    set_resolution_source_llm -> build_conflict_packet
    setup_merge_worktree -> rebase_branch
    supervisor_push_recovery -> verify_retry_push_recovery
    validate_judge_context -> judge_context_gate
    validate_judge_evidence -> judge_evidence_gate
    verify_push_recovery -> push_recovery_gate
    verify_retry_push_recovery -> retry_push_recovery_gate
}
