    check_merge_candidates [type="tool" governance="reversible" action_runtime="in_process" action_id="software.check_merge_candidates" label="Check merge candidates" output_format="json" outputs="has_merge_candidates,merge_candidate_count" action_merge_candidates="${merge_candidates}" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
    clean_main [type="stack.manager_loop" governance="irreversible" class="merge_resolver" benchmark_job_id="goal.execute.merge.clean_main" llm_path_id="${trust_domain}.goal_execute.clean_main" prompt_version="2026-03-19.r1" role_version="1.0.0" skill_id="goal.execute.merge.clean_main" label="LLM: repair post-merge main" reasoning_effort="medium" timeout="60m" prompt="${merge_resolver_system_prompt}\n\nYou are on the canonical main checkout after a merge operation.\n\nCurrent state:\n- Current branch: ${branch}\n- Untracked files: ${untracked_count}\n- Modified files: ${modified_count}\n- Partial git state: ${partial_state}\n\nYour job is to leave main clean, passing required gates, and ready for normal development.\n\nThis node owns both:\n- git-state cleanup after merge/rebase interruptions\n- post-merge code/config repairs when the merged result is genuinely broken\n\nWorkflow:\n0. FIRST: If the current branch is NOT main (partial_state=wrong_branch), you MUST run: git checkout main. Abort any in-progress rebase/merge first if needed.\n1. If partial git state exists (bisect/rebase/merge): abort it safely (git bisect reset, git rebase --abort, git merge --abort), then git checkout main.\n2. Inspect git status. Clean up only true residue:\n   - delete temp/build artifacts\n   - finalize or abort interrupted git operations\n   - keep legitimate source changes\n3. Run: pnpm test:strict.\n4. If the gates fail because the merged code is genuinely broken, fix the broken code or config directly on main.\n5. Re-run the failing checks and continue until they pass.\n6. Verify:\n   - git status --porcelain is empty\n   - git rev-parse --abbrev-ref HEAD outputs main\n   - pnpm test:strict passes\n7. Commit the repair with: fix(merge): repair post-merge main after goal-${goal_issue_number}\n\nAllowed repairs include:\n- missing package dependencies\n- broken imports or exports\n- config mismatches\n- fixture or test drift\n- integration defects exposed only after merge\n\nDo NOT leave any uncommitted files. Do NOT delete legitimate source code. Do NOT rewrite history. Do NOT discard legitimate merged work. Do NOT introduce unrelated refactors. Do NOT stop after describing the defect. If the merged code is broken, fix it." recovery_owner="supervisor" session_id="goal-${goal_issue_number}" system_prompt_source="merge_resolver_system_prompt" workdir="${repo}"]
    cleanup_failed_merge [type="tool" governance="irreversible" action_runtime="in_process" action_id="merge.cleanup_worktree" label="Cleanup failed merge state" output_key="__cleanup_failed_merge_result" action_repo="${repo}" action_merge_worktree_dir="${merge_worktree_dir}" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}.tool"]
