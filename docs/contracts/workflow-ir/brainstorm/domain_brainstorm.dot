// Generated from factories/brainstorm/workflows/dispatch-control/domain_brainstorm.workflow-source.mjs. Do not edit by hand.
digraph domain_brainstorm {
    label = "domain_brainstorm"
    workflow_source = "factories/brainstorm/workflows/dispatch-control/domain_brainstorm.workflow-source.mjs"
    build_intake_context [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.build_intake_context" label="Build brainstorm intake context from shell intake_json" output_format="json" outputs="has_issue,brainstorm_issue_number,brainstorm_issue_body,shipped_goals_since_last,open_backlog_summary,scenario_holdouts,parse_error" action_repo="${target_repo}" action_factory_id="${factory_id}" recovery_owner="supervisor" action_intake_json="${intake_json}" action_root_dir="${repo}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    context_contract_preflight [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Preflight required brainstorm context keys" output_key="context_contract_preflight_status" recovery_owner="supervisor" action_fallback="context_contract_preflight_ok" action_value="${factory_root}${gh_repo}${repo}${intent_stack}${capability_brainstorming_skills}${trust_domain}${trust_role}${brainstorm_issue_number}${brainstorm_issue_body}${shipped_goals_since_last}${open_backlog_summary}${scenario_holdouts}${has_issue}${parse_error}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    done [shape="Msquare" recovery_sink_type="terminal"]
    intake_gate [shape="diamond" label="Shell provided intake issue?" recovery_owner="supervisor"]
    load_intent_stack [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_intent_stack" label="Load intent stack" output_key="intent_stack" recovery_owner="supervisor" action_config_path="${factory_root}/factory.config.json" action_factory_root="${factory_root}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    preflight_gate [shape="diamond" label="Context preflight passed?" recovery_owner="supervisor"]
    set_capability_brainstorming_skills [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_capability_brainstorming_skills_path" label="Resolve capability skills path" output_key="capability_brainstorming_skills" recovery_owner="supervisor" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_control_plane_repo [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_factory_config" label="Resolve control-plane repo" output_key="control_plane_repo" recovery_owner="supervisor" action_factory_root="${factory_root}" action_fallback="${control_plane_repo}" action_key="control_plane_repo" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_domain_result [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Build domain_result payload" output_key="domain_result" recovery_owner="supervisor" action_fallback="{}" action_value="{\"has_issue\":\"${has_issue}\",\"parse_error\":\"${parse_error}\",\"brainstorm_issue_number\":\"${brainstorm_issue_number}\"}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_factory_root [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_factory_config" label="Resolve factory root" output_key="factory_root" recovery_owner="supervisor" action_factory_root="${factory_root}" action_fallback="factories/brainstorm" action_key="factory_root" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_gh_repo [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_default" label="Set capability gh_repo context" output_key="gh_repo" recovery_owner="supervisor" action_fallback="${target_repo}" action_value="${target_repo}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_repo [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_factory_config" label="Resolve repository root" output_key="repo" recovery_owner="supervisor" action_factory_root="${factory_root}" action_fallback="." action_key="work_dir" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_trust_domain [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_factory_config" label="Resolve trust domain" output_key="trust_domain" recovery_owner="supervisor" action_factory_root="${factory_root}" action_fallback="${trust_domain}" action_key="trust_domain" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    set_trust_role [type="tool" governance="reversible" action_runtime="in_process" action_id="common.resolve_factory_config" label="Resolve trust role" output_key="trust_role" recovery_owner="supervisor" action_factory_root="${factory_root}" action_fallback="${trust_role}" action_key="trust_role" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    spawn_brainstorm [type="pipeline" label="Spawn brainstorm capability" recovery_owner="supervisor" pipeline="packages/capability-brainstorming/workflows/brainstorm/brainstorm.workflow-source.mjs" template="packages/capability-brainstorming/workflows/brainstorm/brainstorm.workflow-source.mjs" export_keys="brainstorm_close_result" inherit_context="true" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    start [shape="Mdiamond"]
    set_domain_result -> done
    start -> set_factory_root -> set_gh_repo -> set_repo -> set_control_plane_repo -> set_trust_domain -> set_trust_role -> load_intent_stack -> set_capability_brainstorming_skills -> build_intake_context -> context_contract_preflight -> preflight_gate
    intake_gate -> set_domain_result [condition="has_issue!=true"]
    intake_gate -> spawn_brainstorm [condition="has_issue=true"]
    preflight_gate -> intake_gate [condition="context_contract_preflight_status!=context_contract_preflight_ok"]
    preflight_gate -> set_domain_result [condition="context_contract_preflight_status=context_contract_preflight_ok"]
    spawn_brainstorm -> set_domain_result
}
