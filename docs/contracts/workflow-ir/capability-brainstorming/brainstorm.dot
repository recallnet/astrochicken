// Generated from packages/capability-brainstorming/workflows/brainstorm/brainstorm.workflow-source.mjs. Do not edit by hand.
digraph brainstorm {
    label = "brainstorm"
    workflow_source = "packages/capability-brainstorming/workflows/brainstorm/brainstorm.workflow-source.mjs"
    workdir = "."
    blue [type="agent.kw" governance="reversible" class="blue_strategist" benchmark_job_id="brainstorm.blue" prompt_version="2026-03-17.r1" role_version="2.0.0" skill_id="brainstorm.blue" llm_model="anthropic/claude-opus-4.6" label="Blue strategist" output_key="blue_output" prompt="Load and follow the blue strategist skill:\n- ${capability_brainstorming_skills}/blue_strategist/SKILL.md\n\nIntent stack JSON:\n${intent_stack}\n\nBrainstorm issue #${brainstorm_issue_number} body:\n${brainstorm_issue_body}\n\nSeed prompt (${seed_prompt_source}):\n${seed_prompt}\n\nShipped goals delta:\n${shipped_goals_delta}\n\nScenario holdouts delta:\n${scenario_holdouts_delta}\n\nIntent stack changed since last brainstorm:\n${intent_stack_changed}\n\nOpen backlog summary:\n${open_backlog_summary}\n\nCurrent round:\n${round}\n\nLatest red output:\n${red_output}" llm_provider="openrouter" session_id="blue_strategist"]
    blue_early_exit_gate [shape="diamond" label="Blue early exit: empty-blue guard triggered?"]
    blue_gate [shape="diamond" label="Blue produced final report?"]
    bump_round [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.bump_round" label="Bump round counter" output_format="json" outputs="round,has_next,at_limit" action_max_rounds="10" action_round="${round}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    check_blue [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.check_output" label="Check blue output for final report" output_format="json" outputs="is_final,source,final_report,conversational_output,should_force_wrap,termination_reason,is_empty_output" action_agent_output="${blue_output}" action_source="blue" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    check_red [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.check_output" label="Check red output for final report" output_format="json" outputs="is_final,source,final_report,conversational_output,should_force_wrap,termination_reason,is_empty_output" action_agent_output="${red_output}" action_source="red" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    check_repair [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.check_output" label="Check repair output for final report" output_format="json" outputs="is_final,source,final_report,conversational_output,should_force_wrap,termination_reason,is_empty_output" action_agent_output="${blue_output}" action_source="format_repair" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    check_wrap [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.check_output" label="Check force-wrap output for final report" output_format="json" outputs="is_final,source,final_report,conversational_output,should_force_wrap,termination_reason,is_empty_output" action_agent_output="${blue_output}" action_source="force_wrap" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    close_issue [type="tool" governance="irreversible" action_runtime="in_process" action_id="brainstorm.close_issue" label="Close brainstorm issue" output_key="__brainstorm_close_result" action_repo="${target_repo}" action_factory_id="${factory_id}" action_brainstorm_issue_number="${brainstorm_issue_number}" action_next_cursor="${next_cursor}" action_root_dir="${repo}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    done [shape="Msquare" recovery_sink_type="terminal"]
    force_wrap [type="agent.kw" governance="reversible" class="blue_strategist" benchmark_job_id="brainstorm.force_wrap" prompt_version="2026-03-17.r1" role_version="2.0.0" skill_id="brainstorm.force_wrap" llm_model="anthropic/claude-opus-4.6" label="Force wrap: request final report" output_key="blue_output" prompt="This is the final round of the brainstorm. You must now produce the final report.\n\nSynthesize everything discussed into the final report JSON. Output ONLY the JSON object, nothing else:\n\n{\n  \"proposal\": \"concise goal direction (1-3 sentences)\",\n  \"success_criteria\": [\"testable criterion 1\", \"...\"],\n  \"scope_in\": [\"specific deliverable included\", \"...\"],\n  \"scope_out\": [\"specific item excluded\", \"...\"]\n}\n\nUse the full conversation history to produce the strongest possible goal. Do not add commentary — output only valid JSON.\n\nLatest red output:\n${red_output}\n\nLatest blue output:\n${blue_output}\n\nSeed prompt (${seed_prompt_source}):\n${seed_prompt}" llm_provider="openrouter" session_id="blue_strategist"]
    format_repair [type="agent.kw" governance="reversible" class="blue_strategist" benchmark_job_id="brainstorm.format_repair" prompt_version="2026-03-17.r1" role_version="2.0.0" skill_id="brainstorm.format_repair" llm_model="anthropic/claude-opus-4.6" label="Format repair: fix report format" output_key="blue_output" prompt="Your previous output was not valid JSON in the required format. Output ONLY this exact JSON structure, nothing else — no markdown fences, no explanation, no preamble:\n\n{\n  \"proposal\": \"concise goal direction (1-3 sentences)\",\n  \"success_criteria\": [\"testable criterion 1\", \"...\"],\n  \"scope_in\": [\"specific deliverable included\", \"...\"],\n  \"scope_out\": [\"specific item excluded\", \"...\"]\n}\n\nFill in the fields based on the brainstorm conversation. Every field is required. success_criteria, scope_in, and scope_out must each have at least one entry.\n\nYour previous (invalid) output was:\n${blue_output}\n\nSeed prompt:\n${seed_prompt}" llm_provider="openrouter" session_id="blue_strategist"]
    init_round [type="tool" governance="reversible" label="Init round counter" output_key="round" prompt="echo 0" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    load_context [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.load_context" label="Load brainstorm context" output_format="json" outputs="seed_prompt,seed_prompt_source,shipped_goals_delta,scenario_holdouts_delta,intent_stack_changed,open_backlog_summary,cursor_path,next_cursor,next_cursor_b64" action_factory_id="${factory_id}" action_brainstorm_issue_body="${brainstorm_issue_body}" action_brainstorm_issue_number="${brainstorm_issue_number}" action_intent_stack="${intent_stack}" action_open_backlog_summary="${open_backlog_summary}" action_root_dir="${repo}" action_scenario_holdouts="${scenario_holdouts}" action_shipped_goals_since_last="${shipped_goals_since_last}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    loop_guard_blue [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.loop_guard" label="Loop guard: detect repeated empty blue turns" output_format="json" outputs="empty_blue_count,trigger_force_wrap,suppress_round_comment,guard_reason" action_source="blue" action_conversational_output="${conversational_output}" action_previous_empty_blue_count="${empty_blue_count}" action_should_force_wrap="${should_force_wrap}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    post_blue_comment [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.post_turn_comment" label="Post blue turn comment to issue" output_key="__blue_comment_result" action_repo="${target_repo}" action_issue_number="${brainstorm_issue_number}" action_run_id="${run_id}" action_agent_output="${blue_output}" action_is_final="${is_final}" action_langfuse_project_url="${LANGFUSE_PROJECT_URL}" action_round="${round}" action_source="blue" action_suppress_round_comment="${suppress_round_comment}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    post_red_comment [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.post_turn_comment" label="Post red turn comment to issue" output_key="__red_comment_result" action_repo="${target_repo}" action_issue_number="${brainstorm_issue_number}" action_run_id="${run_id}" action_agent_output="${red_output}" action_is_final="${is_final}" action_langfuse_project_url="${LANGFUSE_PROJECT_URL}" action_round="${round}" action_source="red" action_suppress_round_comment="${suppress_round_comment}" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    post_repair_comment [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.post_turn_comment" label="Post repair comment to issue" output_key="__repair_comment_result" action_repo="${target_repo}" action_issue_number="${brainstorm_issue_number}" action_run_id="${run_id}" action_agent_output="${blue_output}" action_is_final="${is_final}" action_langfuse_project_url="${LANGFUSE_PROJECT_URL}" action_round="${round}" action_source="format_repair" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    post_wrap_comment [type="tool" governance="reversible" action_runtime="in_process" action_id="brainstorm.post_turn_comment" label="Post force-wrap comment to issue" output_key="__wrap_comment_result" action_repo="${target_repo}" action_issue_number="${brainstorm_issue_number}" action_run_id="${run_id}" action_agent_output="${blue_output}" action_is_final="${is_final}" action_langfuse_project_url="${LANGFUSE_PROJECT_URL}" action_round="${round}" action_source="force_wrap" trust_domain="${trust_domain}" trust_role="${trust_role}"]
    red [type="agent.kw" governance="reversible" class="red_strategist" benchmark_job_id="brainstorm.red" prompt_version="2026-03-17.r1" role_version="2.0.0" skill_id="brainstorm.red" llm_model="anthropic/claude-sonnet-4.6" label="Red strategist" output_key="red_output" prompt="Load and follow the red strategist skill:\n- ${capability_brainstorming_skills}/red_strategist/SKILL.md\n\nIntent stack JSON:\n${intent_stack}\n\nBrainstorm issue #${brainstorm_issue_number} body:\n${brainstorm_issue_body}\n\nSeed prompt (${seed_prompt_source}):\n${seed_prompt}\n\nShipped goals delta:\n${shipped_goals_delta}\n\nScenario holdouts delta:\n${scenario_holdouts_delta}\n\nIntent stack changed since last brainstorm:\n${intent_stack_changed}\n\nOpen backlog summary:\n${open_backlog_summary}\n\nCurrent round:\n${round}\n\nLatest blue output (if any):\n${blue_output}" llm_provider="openrouter" session_id="red_strategist"]
    red_early_exit_gate [shape="diamond" label="Red early exit: terminate signal without final report?"]
    red_gate [shape="diamond" label="Red produced final report?"]
    round_gate [shape="diamond" label="Continue brainstorm rounds?"]
    start [shape="Mdiamond"]
    wrap_gate [shape="diamond" label="Force wrap produced valid report?"]
    close_issue -> done
    force_wrap -> check_wrap -> post_wrap_comment -> wrap_gate
    red -> check_red -> red_early_exit_gate
    start -> load_context -> init_round -> red
    blue_early_exit_gate -> force_wrap [condition="trigger_force_wrap=true"]
    blue_early_exit_gate -> post_blue_comment [condition="trigger_force_wrap!=true"]
    blue_gate -> bump_round [condition="is_final!=true"]
    blue_gate -> close_issue [condition="is_final=true"]
    blue -> check_blue
    bump_round -> round_gate
    check_blue -> loop_guard_blue
    check_repair -> post_repair_comment
    format_repair -> check_repair
    loop_guard_blue -> blue_early_exit_gate
    post_blue_comment -> blue_gate
    post_red_comment -> red_gate
    post_repair_comment -> close_issue
    red_early_exit_gate -> force_wrap [condition="should_force_wrap=true"]
    red_early_exit_gate -> post_red_comment [condition="should_force_wrap!=true"]
    red_gate -> blue [condition="is_final!=true"]
    red_gate -> close_issue [condition="is_final=true"]
    round_gate -> force_wrap [condition="has_next!=true"]
    round_gate -> red [condition="has_next=true"]
    wrap_gate -> close_issue [condition="is_final=true"]
    wrap_gate -> format_repair [condition="is_final!=true"]
}
