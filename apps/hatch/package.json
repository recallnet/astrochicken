{
	"name": "hatch",
	"version": "0.1.0",
	"description": "AI pipeline runner \u2014 DOT graphs for multi-step AI workflows",
	"type": "module",
	"bin": {
		"hatch": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./factory/context-resolver": {
			"types": "./dist/factory/context-resolver.d.ts",
			"import": "./dist/factory/context-resolver.js"
		},
		"./factory/conformance-harness": {
			"types": "./dist/factory/conformance-harness.d.ts",
			"import": "./dist/factory/conformance-harness.js"
		},
		"./factory/conformance-cli": {
			"types": "./dist/factory/conformance-cli.d.ts",
			"import": "./dist/factory/conformance-cli.js"
		},
		"./factory/config-schema": {
			"types": "./dist/factory/config-schema.d.ts",
			"import": "./dist/factory/config-schema.js"
		}
	},
	"scripts": {
		"prebuild": "pnpm --filter @recallnet/factory-telemetry --silent build",
		"build": "tsc",
		"dev": "tsc --watch",
		"test": "node ../../scripts/run-package-test-manifest.mjs --repo-root ../.. --manifest config/testing/package-test-manifests/apps-hatch.json --suite default",
		"test:guard-gates": "node ../../scripts/run-package-test-manifest.mjs --repo-root ../.. --manifest config/testing/package-test-manifests/apps-hatch.json --suite guard-gates",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@hatch/capability-artifact-ingestion": "workspace:*",
		"@hatch/capability-brainstorming": "workspace:*",
		"@hatch/capability-coding": "workspace:*",
		"@hatch/capability-goal-decomposition": "workspace:*",
		"@hatch/capability-merge": "workspace:*",
		"@hatch/capability-product-judge": "workspace:*",
		"@hatch/capability-release-reporting": "workspace:*",
		"@hatch/capability-software-development": "workspace:*",
		"@hatch/factory-core": "workspace:*",
		"@mariozechner/pi-ai": "^0.56.3",
		"@mariozechner/pi-coding-agent": "^0.56.3",
		"@recallnet/factory-telemetry": "workspace:*",
		"langfuse": "^3.39.2",
		"pg": "^8.23.1",
		"pi-messenger": "^0.13.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@hatch/tsconfig": "workspace:*",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"@vitest/coverage-v8": "^4.1.11",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"license": "MIT"
}
