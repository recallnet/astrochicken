# demo factory environment example
# Generated from config/testing/factory-env/shared-env.contract.json and factories/<factory>/env.contract.json.
# Update the contracts, then run: node scripts/check-factory-env-contracts.mjs --write

# Shared runtime env
# Optional · secret
# Optional GitHub auth token override for factories that opt into isolated GitHub auth.
HATCH_FACTORY_GITHUB_TOKEN=

# Optional · non-secret
# Optional override for the factory model slug.
HATCH_MODEL=
