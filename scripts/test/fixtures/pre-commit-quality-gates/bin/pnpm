#!/usr/bin/env node
import { appendFileSync, mkdirSync, writeFileSync } from "node:fs";
import { dirname } from "node:path";

const args = process.argv.slice(2);
if (!args[0]) {
  console.error("[pnpm-stub] missing script");
  process.exit(64);
}

const commandArgs = args[0] === "run" ? args.slice(1) : args;
const script = commandArgs.find((arg) => !arg.startsWith("-"));
if (!script) {
  console.error(`[pnpm-stub] unsupported args: ${args.join(" ")}`);
  process.exit(64);
}

const logPath = process.env.PRE_COMMIT_NPM_STUB_LOG;
if (logPath) {
  appendFileSync(
    logPath,
    `${JSON.stringify({
      executable: "pnpm",
      argv: args,
      cwd: process.cwd(),
      script,
      command: `pnpm ${args.join(" ")}`,
    })}\n`,
    "utf8",
  );
}

const envSuffix = script.replace(/[^a-zA-Z0-9]/g, "_").toUpperCase();
const envKey = `PRE_COMMIT_${envSuffix}_EXIT`;
const rawExit = process.env[envKey] ?? "0";
const exitCode = Number.parseInt(rawExit, 10);

if (!Number.isInteger(exitCode) || exitCode < 0 || exitCode > 255) {
  console.error(`[pnpm-stub] invalid exit code for ${envKey}: ${rawExit}`);
  process.exit(65);
}

console.log(`[pnpm-stub] run ${script}`);
process.exit(exitCode);
