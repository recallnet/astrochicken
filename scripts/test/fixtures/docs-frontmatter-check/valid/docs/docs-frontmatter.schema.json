{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recallnet.dev/schemas/hatch/docs-frontmatter.schema.json",
  "title": "Hatch docs frontmatter contract",
  "type": "object",
  "required": [
    "doc_type",
    "review_policy",
    "reviewed",
    "written",
    "owner",
    "status",
    "summary",
    "tags"
  ],
  "additionalProperties": false,
  "properties": {
    "doc_type": {
      "type": "string",
      "enum": [
        "architecture",
        "reference",
        "roadmap",
        "state_machines",
        "vision"
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "draft",
        "historical"
      ]
    },
    "written": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewed": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "review_policy": {
      "type": "string",
      "enum": [
        "codebound",
        "generated",
        "historical",
        "periodic-7"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "string",
      "minLength": 1
    }
  }
}
