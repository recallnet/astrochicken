digraph managed_supervisor_shell {
  start [shape=Mdiamond label="Start"];
  blocker_gate [label="Blocker gate"];
  invoke_domain_graph [label="Invoke domain graph"];
  finish [shape=Msquare label="Exit"];

  start -> blocker_gate;
  blocker_gate -> invoke_domain_graph;
  invoke_domain_graph -> finish;
}
