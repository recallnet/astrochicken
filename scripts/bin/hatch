#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
repo_root=$(cd "$basedir/../.." && pwd)
pnpm_node_path="$repo_root/node_modules/.pnpm/node_modules"

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="$pnpm_node_path"
else
  export NODE_PATH="$pnpm_node_path:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../apps/hatch/dist/cli.js" "$@"
else
  exec node  "$basedir/../../apps/hatch/dist/cli.js" "$@"
fi
